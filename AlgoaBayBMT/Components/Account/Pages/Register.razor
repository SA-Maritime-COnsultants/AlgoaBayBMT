@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using AlgoaBayBMT.Data

@inject IUserRegistrationService UserRegistrationService
@inject IAreaService AreaService
@inject ICompanyService CompanyService
@inject IVesselService VesselService
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <StatusMessage Message="@Message" />
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <h2>Create a new account.</h2>
            <hr />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.FullName" id="Input.FullName" class="form-control" aria-required="true" placeholder="Full name" />
                <label for="Input.FullName">Full name</label>
                <ValidationMessage For="() => Input.FullName" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Input.RequestedRole" id="Input.RequestedRole" class="form-select" aria-required="true">
                    <option value="">Select requested role</option>
                    @foreach (var role in AvailableRoles)
                    {
                        <option value="@role">@role.Replace("_", " ")</option>
                    }
                </InputSelect>
                <label for="Input.RequestedRole">Requested role</label>
                <ValidationMessage For="() => Input.RequestedRole" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Input.CompanyId" id="Input.CompanyId" class="form-select">
                    <option value="">No company selected</option>
                    @foreach (var company in Companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </InputSelect>
                <label for="Input.CompanyId">Company</label>
            </div>

            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Input.PrimaryAreaId" id="Input.PrimaryAreaId" class="form-select">
                    <option value="">No primary area selected</option>
                    @foreach (var area in Areas)
                    {
                        <option value="@area.Id">@area.Name</option>
                    }
                </InputSelect>
                <label for="Input.PrimaryAreaId">Operational area</label>
            </div>

            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Input.VesselId" id="Input.VesselId" class="form-select">
                    <option value="">No vessel selected</option>
                    @foreach (var vessel in Vessels)
                    {
                        <option value="@vessel.Id">@vessel.Name</option>
                    }
                </InputSelect>
                <label for="Input.VesselId">Vessel</label>
                @if (IsCrewRequested)
                {
                    <div class="form-text">Crew registration requires a vessel assignment.</div>
                }
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="Input.Password">Password</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="Input.ConfirmPassword">Confirm Password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </EditForm>
    </div>
    <div class="col-lg-5">
        <section class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h3 class="h5">Approval workflow</h3>
                <hr />
                <ol class="ps-3 mb-0">
                    <li>Submit registration with requested role and assignment details.</li>
                    <li>Confirm email using the verification link.</li>
                    <li>Await account approval by Admin or the relevant company approver.</li>
                    <li>Login becomes active only after both steps complete.</li>
                </ol>
            </div>
        </section>
    </div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private List<OperationalArea> Areas = new();
    private List<BunkeringCompany> Companies = new();
    private List<Vessel> Vessels = new();
    private static IReadOnlyList<string> AvailableRoles => RoleNames.All;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private bool IsCrewRequested => string.Equals(Input.RequestedRole, RoleNames.Crew, StringComparison.OrdinalIgnoreCase);
    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        Areas = await AreaService.GetAreasAsync();
        Companies = await CompanyService.GetCompaniesAsync();
        Vessels = await VesselService.GetVesselsAsync();
    }

    public async Task RegisterUser(EditContext editContext)
    {
        var registrationResult = await UserRegistrationService.RegisterAsync(new RegistrationRequest
        {
            Email = Input.Email,
            Password = Input.Password,
            ConfirmPassword = Input.ConfirmPassword,
            FullName = Input.FullName,
            RequestedRole = Input.RequestedRole,
            CompanyId = Input.CompanyId,
            PrimaryAreaId = Input.PrimaryAreaId,
            VesselId = Input.VesselId
        });

        if (!registrationResult.Succeeded || registrationResult.Data is null)
        {
            identityErrors = registrationResult.Errors.Select(error => new IdentityError { Description = error });
            return;
        }

        var user = registrationResult.Data;
        Logger.LogInformation("User created a new account with password and pending approval workflow.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        RedirectManager.RedirectTo(
            "Account/RegisterConfirmation",
            new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
    }

    private sealed class InputModel
    {
        [Required]
        [Display(Name = "Full name")]
        public string FullName { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = string.Empty;

        [Required]
        [Display(Name = "Requested role")]
        public string RequestedRole { get; set; } = string.Empty;

        [Display(Name = "Company")]
        public int? CompanyId { get; set; }

        [Display(Name = "Operational area")]
        public int? PrimaryAreaId { get; set; }

        [Display(Name = "Vessel")]
        public int? VesselId { get; set; }

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
