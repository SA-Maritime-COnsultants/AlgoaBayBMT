@page "/Account/Register"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using AlgoaBayBMT.Data

@inject IUserRegistrationService UserRegistrationService
@inject UserManager<ApplicationUser> UserManager
@inject IApplicationEmailService EmailService
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register</PageTitle>

<div class="page-shell auth-page-shell">
    <div class="auth-page-inner">
        <div class="auth-brand text-center">
            <h1 class="auth-title">Register</h1>
            <div class="auth-subtitle">Create your account to access Algoa Bay BMT.</div>
        </div>

        <SfCard CssClass="pf-card-shell auth-card register-card">
            <CardHeader Title="Create a new account" SubTitle="Complete the form below to request access" />
            <CardContent>
                <StatusMessage Message="@Message" />

                <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="pf-form-grid">
                        <div class="pf-col-4">
                            <label class="pf-field-label">Full name</label>
                            <SfTextBox @bind-Value="Input.FullName" Placeholder="Full name" />
                            <ValidationMessage For="() => Input.FullName" class="text-danger" />
                        </div>

                        <div class="pf-col-4">
                            <label class="pf-field-label">Email</label>
                            <SfTextBox @bind-Value="Input.Email" Placeholder="name@example.com" HtmlAttributes="EmailAttributes" />
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>

                        <div class="pf-col-4">
                            <label class="pf-field-label">Cell No</label>
                            <SfTextBox @bind-Value="Input.CellNo" Placeholder="Cell number" />
                            <ValidationMessage For="() => Input.CellNo" class="text-danger" />
                        </div>

                        <div class="pf-col-6">
                            <label class="pf-field-label">Address</label>
                            <SfTextBox @bind-Value="Input.Address" Placeholder="Street address" />
                            <ValidationMessage For="() => Input.Address" class="text-danger" />
                        </div>

                        <div class="pf-col-3">
                            <label class="pf-field-label">Country</label>
                            <SfDropDownList TValue="string" TItem="CountryOption" DataSource="@CountryOptions" @bind-Value="Input.Country" Placeholder="Select country">
                                <DropDownListFieldSettings Text="Text" Value="Value" />
                            </SfDropDownList>
                        </div>

                        <div class="pf-col-4 auth-inline-checkbox">
                            <label class="pf-field-label">Crew</label>
                            <SfCheckBox Label="Crew" @bind-Checked="Input.IsCrew" CssClass="register-crew-checkbox" />
                        </div>

                        @if (Input.IsCrew)
                        {
                            <div class="pf-col-4">
                                <label class="pf-field-label">Rank</label>
                                <SfDropDownList TValue="CrewRank?" TItem="CrewRankOption" DataSource="@CrewRankOptions" @bind-Value="Input.CrewRank" Placeholder="Select rank">
                                    <DropDownListFieldSettings Text="Text" Value="Value" />
                                </SfDropDownList>
                                <ValidationMessage For="() => Input.CrewRank" class="text-danger" />
                            </div>

                            <div class="pf-col-4">
                                <label class="pf-field-label">SID Number</label>
                                <SfTextBox @bind-Value="Input.SidNumber" Placeholder="SID number" />
                                <ValidationMessage For="() => Input.SidNumber" class="text-danger" />
                            </div>

                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Issuing Country</label>
                                <SfDropDownList TValue="string" TItem="CountryOption" DataSource="@CountryOptions" @bind-Value="Input.SidIssuingCountry" Placeholder="Select country">
                                    <DropDownListFieldSettings Text="Text" Value="Value" />
                                </SfDropDownList>
                                <ValidationMessage For="() => Input.SidIssuingCountry" class="text-danger" />
                            </div>

                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Issuing Authority</label>
                                <SfTextBox @bind-Value="Input.SidIssuingAuthority" Placeholder="Issuing authority" />
                                <ValidationMessage For="() => Input.SidIssuingAuthority" class="text-danger" />
                            </div>

                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Issue Date</label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Input.SidIssueDate" Placeholder="Issue date" Format="yyyy-MM-dd" />
                            </div>

                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Expiry Date</label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Input.SidExpiryDate" Placeholder="Expiry date" Format="yyyy-MM-dd" />
                            </div>
                        }

                        <div class="pf-col-6">
                            <label class="pf-field-label">Password</label>
                            <SfTextBox @bind-Value="Input.Password" Placeholder="Password" Type="InputType.Password" HtmlAttributes="PasswordAttributes" />
                            <ValidationMessage For="() => Input.Password" class="text-danger" />
                        </div>

                        <div class="pf-col-6">
                            <label class="pf-field-label">Confirm password</label>
                            <SfTextBox @bind-Value="Input.ConfirmPassword" Placeholder="Confirm password" Type="InputType.Password" HtmlAttributes="ConfirmPasswordAttributes" />
                            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <SfButton CssClass="e-primary e-large" IsPrimary="true" Type="ButtonType.Submit">Register</SfButton>
                    </div>
                </EditForm>
            </CardContent>
        </SfCard>
    </div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private static IReadOnlyList<CrewRankOption> CrewRankOptions => Enum.GetValues<CrewRank>()
        .Select(rank => new CrewRankOption { Value = rank, Text = rank.GetDisplayName() })
        .ToList();
    private static IReadOnlyList<CountryOption> CountryOptions => CountryCatalog.All
        .Select(country => new CountryOption { Value = country, Text = country })
        .ToList();

    private readonly Dictionary<string, object> EmailAttributes = new() { ["autocomplete"] = "username" };
    private readonly Dictionary<string, object> PasswordAttributes = new() { ["autocomplete"] = "new-password" };
    private readonly Dictionary<string, object> ConfirmPasswordAttributes = new() { ["autocomplete"] = "new-password" };

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override Task OnInitializedAsync()
    {
        Input ??= new();
        return Task.CompletedTask;
    }

    public async Task RegisterUser(EditContext editContext)
    {
        var registrationResult = await UserRegistrationService.RegisterAsync(new RegistrationRequest
        {
            Email = Input.Email,
            Password = Input.Password,
            ConfirmPassword = Input.ConfirmPassword,
            FullName = Input.FullName,
            CellNo = Input.CellNo,
            Address = Input.Address,
            Country = Input.Country,
            IsCrew = Input.IsCrew,
            CrewRank = Input.IsCrew ? Input.CrewRank : null,
            SidNumber = Input.IsCrew ? Input.SidNumber : null,
            SidIssuingCountry = Input.IsCrew ? Input.SidIssuingCountry : null,
            SidIssuingAuthority = Input.IsCrew ? Input.SidIssuingAuthority : null,
            SidIssueDate = Input.IsCrew ? Input.SidIssueDate : null,
            SidExpiryDate = Input.IsCrew ? Input.SidExpiryDate : null
        });

        if (!registrationResult.Succeeded || registrationResult.Data is null)
        {
            identityErrors = registrationResult.Errors.Select(error => new IdentityError { Description = error });
            return;
        }

        var user = registrationResult.Data;
        Logger.LogInformation("User created a new account with password and pending approval workflow.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        try
        {
            await EmailService.SendConfirmationLinkAsync(user, Input.Email, callbackUrl);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send confirmation email to {Email}", Input.Email);
        }

        try
        {
            await EmailService.SendWelcomeEmailAsync(user, NavigationManager.BaseUri);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send welcome email to {Email}", Input.Email);
        }

        RedirectManager.RedirectTo(
            "Account/RegisterConfirmation",
            new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
    }

    private sealed class InputModel : IValidatableObject
    {
        private bool isCrew;
        private string? sidNumber;

        [Required]
        [Display(Name = "Full name")]
        public string FullName { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = string.Empty;

        [StringLength(30)]
        [Display(Name = "Cell No")]
        public string CellNo { get; set; } = string.Empty;

        [StringLength(300)]
        [Display(Name = "Address")]
        public string Address { get; set; } = string.Empty;

        [StringLength(100)]
        [Display(Name = "Country")]
        public string Country { get; set; } = string.Empty;

        [Display(Name = "Crew")]
        public bool IsCrew
        {
            get => isCrew;
            set
            {
                isCrew = value;
                if (!isCrew)
                {
                    CrewRank = null;
                    SidNumber = null;
                    SidIssuingCountry = null;
                    SidIssuingAuthority = null;
                    SidIssueDate = null;
                    SidExpiryDate = null;
                }
            }
        }

        [Display(Name = "Rank")]
        public CrewRank? CrewRank { get; set; }

        [Display(Name = "SID Number")]
        public string? SidNumber
        {
            get => sidNumber;
            set => sidNumber = value?.Trim().ToUpperInvariant();
        }

        [Display(Name = "SID Issuing Country")]
        public string? SidIssuingCountry { get; set; }

        [Display(Name = "SID Issuing Authority")]
        public string? SidIssuingAuthority { get; set; }

        [Display(Name = "SID Issue Date")]
        public DateTime? SidIssueDate { get; set; }

        [Display(Name = "SID Expiry Date")]
        public DateTime? SidExpiryDate { get; set; }

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(CellNo))
            {
                yield return new ValidationResult("Cell No is required.", [nameof(CellNo)]);
            }

            if (string.IsNullOrWhiteSpace(Address))
            {
                yield return new ValidationResult("Address is required.", [nameof(Address)]);
            }

            if (string.IsNullOrWhiteSpace(Country))
            {
                yield return new ValidationResult("Country is required.", [nameof(Country)]);
            }

            if (!IsCrew)
            {
                yield break;
            }

            if (CrewRank is null)
            {
                yield return new ValidationResult("Rank is required when Crew is selected.", [nameof(CrewRank)]);
            }

            if (string.IsNullOrWhiteSpace(SidIssuingCountry))
            {
                yield return new ValidationResult("SID issuing country is required when Crew is selected.", [nameof(SidIssuingCountry)]);
            }

            if (string.IsNullOrWhiteSpace(SidIssuingAuthority))
            {
                yield return new ValidationResult("SID issuing authority is required when Crew is selected.", [nameof(SidIssuingAuthority)]);
            }
        }
    }

    private sealed class CrewRankOption
    {
        public CrewRank? Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private sealed class CountryOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }
}
