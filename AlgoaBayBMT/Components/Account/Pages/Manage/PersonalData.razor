@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using AlgoaBayBMT.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal Data</PageTitle>

<StatusMessage />

<SfCard CssClass="pf-card-shell">
    <CardHeader Title="Personal Data" SubTitle="Download the personal information currently held against your account." />
    <CardContent>
        <div class="pf-manage-copy">
            <p>Your account contains personal data that you have given us. You can export that information here for your records.</p>

            <form action="Account/Manage/DownloadPersonalData" method="post" @formname="download-personal-data">
                <AntiforgeryToken />
                <button class="e-btn e-primary" type="submit">Download personal data</button>
            </form>
        </div>
    </CardContent>
</SfCard>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
