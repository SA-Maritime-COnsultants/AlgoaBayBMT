@page "/Account/ResendEmailConfirmation"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using AlgoaBayBMT.Data

@inject UserManager<ApplicationUser> UserManager
@inject IApplicationEmailService EmailSender
@inject NavigationManager NavigationManager

<PageTitle>Resend email confirmation</PageTitle>

<div class="page-shell auth-page-shell">
    <div class="auth-page-inner">
        <div class="auth-brand text-center">
            <h1 class="auth-title">Resend Confirmation</h1>
            <div class="auth-subtitle">Enter your registered email address to receive a new confirmation link.</div>
        </div>

        <SfCard CssClass="pf-card-shell auth-card">
            <CardHeader Title="Resend email confirmation" />
            <CardContent>

                @if (ShowSuccess)
                {
                    <div class="pf-alert pf-alert--success">
                        <span class="e-icons e-check-box" aria-hidden="true"></span>
                        <div>
                            <strong>Confirmation email sent.</strong><br />
                            Please check your inbox and follow the link to confirm your email address.
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <a href="/Account/Login" class="pf-link">Back to login</a>
                    </div>
                }
                else if (ShowAlreadyConfirmed)
                {
                    <div class="pf-alert pf-alert--info">
                        <span class="e-icons e-info" aria-hidden="true"></span>
                        <div>
                            <strong>Email already confirmed.</strong><br />
                            This email address has already been confirmed. You can log in directly.
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <a href="/Account/Login" class="pf-link">Go to login</a>
                    </div>
                }
                else
                {
                    @if (ShowNotFound)
                    {
                        <div class="pf-alert pf-alert--warning mb-3">
                            <span class="e-icons e-warning" aria-hidden="true"></span>
                            <div>
                                <strong>No account found.</strong><br />
                                No registered account was found for this email address. Please check the address or register a new account.
                            </div>
                        </div>
                    }

                    <EditForm Model="Input" FormName="resend-email-confirmation" OnValidSubmit="OnValidSubmitAsync">
                        <DataAnnotationsValidator />

                        <div class="pf-form-grid">
                            <div class="pf-col-12">
                                <label class="pf-field-label">Email address</label>
                                <SfTextBox @bind-Value="Input.Email" Placeholder="name@example.com" />
                                <ValidationMessage For="() => Input.Email" class="text-danger" />
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <SfButton CssClass="e-primary e-large" IsPrimary="true" Type="ButtonType.Submit">Send confirmation email</SfButton>
                        </div>
                    </EditForm>

                    <div class="pf-dialog-actions mt-3 justify-content-between">
                        <a href="/Account/Login" class="pf-link">Back to login</a>
                        @if (ShowNotFound)
                        {
                            <SfButton CssClass="e-success" OnClick="@(_ => NavigationManager.NavigateTo("/Account/Register"))">Register new account</SfButton>
                        }
                    </div>
                }

            </CardContent>
        </SfCard>
    </div>
</div>

@code {
    private bool ShowSuccess;
    private bool ShowAlreadyConfirmed;
    private bool ShowNotFound;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        ShowNotFound = false;
        ShowAlreadyConfirmed = false;
        ShowSuccess = false;

        var user = await UserManager.FindByEmailAsync(Input.Email!);
        if (user is null)
        {
            ShowNotFound = true;
            return;
        }

        if (user.EmailConfirmed)
        {
            ShowAlreadyConfirmed = true;
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email!, callbackUrl);

        ShowSuccess = true;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}

