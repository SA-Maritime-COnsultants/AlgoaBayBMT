@using Microsoft.AspNetCore.Identity
@using AlgoaBayBMT.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="pf-manage-nav">
    <div class="pf-manage-nav-title card-header-bmt">Manage Sections</div>
    <ul class="pf-manage-nav-list">
        <li>
            <NavLink class="pf-manage-nav-link" href="Account/Manage" Match="NavLinkMatch.All">Profile</NavLink>
        </li>
        <li>
            <NavLink class="pf-manage-nav-link" href="Account/Manage/Email">Email</NavLink>
        </li>
        <li>
            <NavLink class="pf-manage-nav-link" href="Account/Manage/ChangePassword">Password</NavLink>
        </li>
        @if (hasExternalLogins)
        {
            <li>
                <NavLink class="pf-manage-nav-link" href="Account/Manage/ExternalLogins">External logins</NavLink>
            </li>
        }
        <li>
            <NavLink class="pf-manage-nav-link" href="Account/Manage/TwoFactorAuthentication">Two-factor authentication</NavLink>
        </li>
        <li>
            <NavLink class="pf-manage-nav-link" href="Account/Manage/Passkeys">Passkeys</NavLink>
        </li>
        <li>
            <NavLink class="pf-manage-nav-link" href="Account/Manage/PersonalData">Personal data</NavLink>
        </li>
    </ul>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
