@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ICrewComplianceWorkflowService ComplianceWorkflowService
@inject AuthenticationStateProvider AuthState
@inject IWebHostEnvironment Environment

<div class="app-shell @(isSidebarOpen ? "sidebar-open" : string.Empty)">
    <Sidebar Id="app-sidebar" OnNavigate="CloseSidebar" />

    <div class="app-shell-main">
        <TopBar IsSidebarOpen="isSidebarOpen"
                ToggleSidebar="ToggleSidebar"
                CurrentSection="@CurrentSection"
                CurrentPageTitle="@CurrentPageTitle"
                CurrentStatusClass="@CurrentStatusClass"
                CurrentStatusLabel="@CurrentStatusLabel"
                CrewComplianceStatus="@_crewComplianceStatus"
                CrewComplianceLink="@_crewComplianceLink" />

        <div class="app-overlay" @onclick="CloseSidebar"></div>

        <main id="main-content" class="app-content" tabindex="-1">
            @* Keeps a page-level exception inside the content area instead of tearing down the
               whole circuit — most pages call the database straight from OnInitializedAsync with
               no try/catch, so a single transient failure used to blank the entire app. *@
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="pageError">
                    <div class="pf-card-shell pf-page-error">
                        <div class="pf-empty-state">
                            <i class="bi bi-exclamation-triangle text-warning fs-3 d-block mb-2"></i>
                            <div class="fw-semibold mb-1">This page could not be loaded.</div>
                            <div class="text-muted mb-3">
                                The server or database did not respond as expected. Your session is still active — try again.
                            </div>
                            @if (Environment.IsDevelopment())
                            {
                                <pre class="text-start small text-danger pf-page-error-detail">@pageError.ToString()</pre>
                            }
                            <button type="button" class="btn btn-bmt btn-pastel-green" @onclick="RecoverFromError">
                                <i class="bi bi-arrow-clockwise me-2"></i>Try again
                            </button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private bool isSidebarOpen;
    private string currentPath = string.Empty;
    private CrewComplianceOverallStatus? _crewComplianceStatus;
    private string _crewComplianceLink = "/crewing/crew";
    private bool _complianceLoaded;

    protected override void OnInitialized()
    {
        currentPath = GetCurrentPath(NavigationManager.Uri);
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_complianceLoaded)
        {
            _complianceLoaded = true;
            await LoadCrewComplianceAsync();
        }
    }

    private async Task LoadCrewComplianceAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userId = auth.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrWhiteSpace(userId)) return;

            var dashboard = await ComplianceWorkflowService.GetCrewDashboardByUserIdAsync(userId);
            if (dashboard is null) return;

            _crewComplianceStatus = dashboard.OverallStatus;
            _crewComplianceLink = $"/crewing/crew/{dashboard.CrewMemberId}";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Non-critical — suppress errors so layout never blocks.
            // This avoids crashing the shell when the database or identity state is temporarily unavailable.
            Console.Error.WriteLine($"Crew compliance summary load failed: {ex}");
        }
    }

    private string CurrentPageTitle => currentPath switch
    {
        "" => "Operations Dashboard",
        "training" => "Training",
        "bunkering-operations" => "Bunkering Operations",
        "wildlife-environment" => "Wildlife & Environment",
        "emergency-response" => "Emergency Response",
        "compliance-documents" => "Compliance & Documents",
        "dashboards" => "Dashboards",
        "settings" => "Settings",
        _ => "Operations Workspace"
    };

    private string CurrentSection => currentPath switch
    {
        "" => "Home",
        "training" => "Training Control",
        "bunkering-operations" => "Marine Fuel Transfer",
        "wildlife-environment" => "Environmental Oversight",
        "emergency-response" => "Incident Command",
        "compliance-documents" => "Regulatory Control",
        "dashboards" => "Operational Reporting",
        "settings" => "System Configuration",
        _ => "Application"
    };

    private string CurrentStatusLabel => currentPath switch
    {
        "emergency-response" => "Priority Monitoring",
        "wildlife-environment" => "Environmental Watch",
        "compliance-documents" => "Controlled Access",
        _ => "Normal Operations"
    };

    private string CurrentStatusClass => currentPath switch
    {
        "emergency-response" => "status-critical",
        "wildlife-environment" => "status-success",
        "compliance-documents" => "status-warning",
        _ => "status-normal"
    };

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    private void CloseSidebar() => isSidebarOpen = false;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentPath = GetCurrentPath(e.Location);
        isSidebarOpen = false;
        // Navigating away from a failed page must clear the boundary, otherwise the error
        // markup stays on screen over the newly routed component.
        _errorBoundary?.Recover();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RecoverFromError() => _errorBoundary?.Recover();

    private static string GetCurrentPath(string uri)
    {
        var relativePath = new Uri(uri).PathAndQuery.TrimStart('/');
        var path = relativePath.Split('?', '#')[0].TrimEnd('/');
        return path;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
