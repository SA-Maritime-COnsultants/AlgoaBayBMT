<header class="app-topbar" role="banner">
    <div class="topbar-left">
        <button type="button"
                class="sidebar-toggle"
                @onclick="ToggleSidebar"
                aria-label="Toggle primary navigation"
                aria-controls="app-sidebar"
                aria-expanded="@IsSidebarOpen">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="topbar-context">
            <span class="topbar-breadcrumb">Operations / @CurrentSection</span>
            <div class="topbar-title-row">
                <h1 class="topbar-title">@CurrentPageTitle</h1>
                <span class="topbar-status-chip @CurrentStatusClass">@CurrentStatusLabel</span>
            </div>
        </div>
    </div>

    <div class="topbar-right">
        <div class="topbar-weather" role="status" aria-label="Current weather conditions">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.59 4.59A2 2 0 1 1 11 8H2"></path>
                <path d="M19.73 7.73A2.5 2.5 0 1 1 19.5 12H2"></path>
                <path d="M12.59 19.41A2 2 0 1 0 14 16H2"></path>
            </svg>
            <div class="weather-copy">
                <span class="weather-label">Sea State</span>
                <span class="weather-value">SW 18 kn · BF 5</span>
            </div>
        </div>

        <span class="role-badge" aria-label="Current role">Authority</span>

        <AuthorizeView Context="authState">
            <Authorized>
                <button type="button" class="profile-button" aria-label="User profile menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>@(authState.User.Identity?.Name ?? "Operations User")</span>
                </button>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="profile-button" aria-label="Guest access status">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Guest</span>
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [Parameter]
    public bool IsSidebarOpen { get; set; }

    [Parameter]
    public EventCallback ToggleSidebar { get; set; }

    [Parameter]
    public string CurrentSection { get; set; } = string.Empty;

    [Parameter]
    public string CurrentPageTitle { get; set; } = string.Empty;

    [Parameter]
    public string CurrentStatusClass { get; set; } = string.Empty;

    [Parameter]
    public string CurrentStatusLabel { get; set; } = string.Empty;
}
