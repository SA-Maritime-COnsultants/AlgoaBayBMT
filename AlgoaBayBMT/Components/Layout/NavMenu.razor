@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<nav class="side-nav" aria-label="Primary navigation menu">
    <a href="/" class="side-nav-brand" aria-label="Algoa Bay BMT home">
        <img src="images/logo.png" alt="Algoa Bay BMT logo" class="side-nav-logo" />
        <div class="side-nav-brand-copy">
            <span class="side-nav-brand-title">Algoa Bay BMT</span>
            <span class="side-nav-brand-subtitle">Bunkering Management &amp; Training</span>
        </div>
    </a>

    <div class="side-nav-scroll">
        <section class="side-nav-group" aria-labelledby="operations-nav-heading">
            <button id="operations-nav-heading" type="button" class="side-nav-group-toggle"
                    @onclick="ToggleOperationsAsync"
                    aria-expanded="@_opsExpanded.ToString().ToLower()">
                <span class="side-nav-group-label">Operations</span>
                <span class="side-nav-chevron @(_opsExpanded ? "side-nav-chevron--open" : "")" aria-hidden="true">@((MarkupString)ChevronIcon)</span>
            </button>
            <div class="side-nav-collapsible @(_opsExpanded ? "side-nav-collapsible--open" : "")">
                <ul class="side-nav-items">
                    <li class="side-nav-item">
                        <NavLink class="side-nav-link" href="/" Match="NavLinkMatch.All" @onclick="HandleNavClick">
                            <span class="side-nav-icon" aria-hidden="true">@((MarkupString)HomeIcon)</span>
                            <span class="side-nav-copy">
                                <span class="side-nav-label">Home</span>
                                <span class="side-nav-meta">Control room overview</span>
                            </span>
                        </NavLink>
                    </li>
                </ul>
            </div>
        </section>

        <AuthorizeView Roles="@RoleNames.Admin">
            <section class="side-nav-group" aria-labelledby="training-management-nav-heading">
                <button id="training-management-nav-heading" type="button" class="side-nav-group-toggle"
                        @onclick="ToggleTrainingManagementAsync"
                        aria-expanded="@_trainingMgmtExpanded.ToString().ToLower()">
                    <span class="side-nav-group-label">Training Management</span>
                    <span class="side-nav-chevron @(_trainingMgmtExpanded ? "side-nav-chevron--open" : "")" aria-hidden="true">@((MarkupString)ChevronIcon)</span>
                </button>
                <div class="side-nav-collapsible @(_trainingMgmtExpanded ? "side-nav-collapsible--open" : "")">
                    <ul class="side-nav-items">
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="training-management" Match="NavLinkMatch.All" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)DashboardIcon)</span>
                                <span class="side-nav-copy"><span class="side-nav-label">Training Dashboard</span><span class="side-nav-meta">Authoring control centre</span></span>
                            </NavLink>
                        </li>
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="training-management/courses" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)TrainingIcon)</span>
                                <span class="side-nav-copy"><span class="side-nav-label">Courses</span><span class="side-nav-meta">Create and edit courses</span></span>
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </section>
        </AuthorizeView>

        <AuthorizeView>
            <section class="side-nav-group" aria-labelledby="my-training-nav-heading">
                <h2 id="my-training-nav-heading" class="side-nav-group-title">My Training</h2>
                <ul class="side-nav-items">
                    <li class="side-nav-item">
                        <NavLink class="side-nav-link" href="my-training" @onclick="HandleNavClick">
                            <span class="side-nav-icon" aria-hidden="true">@((MarkupString)TrainingIcon)</span>
                            <span class="side-nav-copy"><span class="side-nav-label">My Training Dashboard</span><span class="side-nav-meta">Compliance, progress, certificates</span></span>
                        </NavLink>
                    </li>
                </ul>
            </section>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{RoleNames.Admin},{RoleNames.CompanyManager}")">
            <section class="side-nav-group" aria-labelledby="user-management-nav-heading">
                <button id="user-management-nav-heading" type="button" class="side-nav-group-toggle"
                        @onclick="ToggleUserManagementAsync"
                        aria-expanded="@_userMgmtExpanded.ToString().ToLower()">
                    <span class="side-nav-group-label">User Management</span>
                    <span class="side-nav-chevron @(_userMgmtExpanded ? "side-nav-chevron--open" : "")" aria-hidden="true">@((MarkupString)ChevronIcon)</span>
                </button>
                <div class="side-nav-collapsible @(_userMgmtExpanded ? "side-nav-collapsible--open" : "")">
                    <ul class="side-nav-items">
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="user-management/users" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)TrainingIcon)</span>
                                <span class="side-nav-copy"><span class="side-nav-label">Manage Users</span><span class="side-nav-meta">Directory and activation</span></span>
                            </NavLink>
                        </li>
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="user-management/approvals" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)EmergencyIcon)</span>
                                <span class="side-nav-copy"><span class="side-nav-label">Approve Users</span><span class="side-nav-meta">Registration workflow</span></span>
                            </NavLink>
                        </li>
                        <AuthorizeView Roles="@RoleNames.Admin" Context="roleEditorAuth">
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="RoleEditor" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)RoleEditorIcon)</span>
                                <span class="side-nav-copy"><span class="side-nav-label">Role Editor</span><span class="side-nav-meta">Manage roles and assignments</span></span>
                            </NavLink>
                        </li>
                        </AuthorizeView>
                    </ul>
                </div>
            </section>
        </AuthorizeView>

        <section class="side-nav-group side-nav-group--account" aria-labelledby="account-nav-heading">
            <h2 id="account-nav-heading" class="side-nav-group-title">Account</h2>
            <ul class="side-nav-items">
                <AuthorizeView>
                    <Authorized>
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="/Account/Manage" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)AccountIcon)</span>
                                <span class="side-nav-copy">
                                    <span class="side-nav-label">My Account</span>
                                    <span class="side-nav-meta">Identity and access</span>
                                </span>
                            </NavLink>
                        </li>
                        <li class="side-nav-item">
                            <form action="/Account/Logout" method="post" class="side-nav-form" @formname="logout-form">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                <button type="submit" class="side-nav-button" @onclick="HandleNavClick">
                                    <span class="side-nav-icon" aria-hidden="true">@((MarkupString)LogoutIcon)</span>
                                    <span class="side-nav-copy">
                                        <span class="side-nav-label">Logout</span>
                                        <span class="side-nav-meta">End current session</span>
                                    </span>
                                </button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="/Account/Login" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)LoginIcon)</span>
                                <span class="side-nav-copy">
                                    <span class="side-nav-label">Login</span>
                                    <span class="side-nav-meta">Secure access</span>
                                </span>
                            </NavLink>
                        </li>
                        <li class="side-nav-item">
                            <NavLink class="side-nav-link" href="/Account/Register" @onclick="HandleNavClick">
                                <span class="side-nav-icon" aria-hidden="true">@((MarkupString)RegisterIcon)</span>
                                <span class="side-nav-copy">
                                    <span class="side-nav-label">Register</span>
                                    <span class="side-nav-meta">Provision new user</span>
                                </span>
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </section>
    </div>
</nav>

@code {
    private string returnUrl = "/";
    private bool _opsExpanded = true;
    private bool _crewMgmtExpanded = true;
    private bool _adminExpanded = true;
    private bool _trainingMgmtExpanded = true;
    private bool _userMgmtExpanded = true;
    private bool _menuStateLoaded;
    private string? _menuStorageKey;

    [Parameter]
    public EventCallback OnNavigate { get; set; }



    protected override void OnInitialized()
    {
        returnUrl = BuildReturnUrl(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadMenuStateAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        returnUrl = BuildReturnUrl(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleNavClick()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private Task ToggleOperationsAsync() => ToggleSectionAsync(() => _opsExpanded = !_opsExpanded);

    private Task ToggleCrewManagementAsync() => ToggleSectionAsync(() => _crewMgmtExpanded = !_crewMgmtExpanded);

    private Task ToggleAdminAsync() => ToggleSectionAsync(() => _adminExpanded = !_adminExpanded);

    private Task ToggleTrainingManagementAsync() => ToggleSectionAsync(() => _trainingMgmtExpanded = !_trainingMgmtExpanded);

    private Task ToggleUserManagementAsync() => ToggleSectionAsync(() => _userMgmtExpanded = !_userMgmtExpanded);

    private async Task ToggleSectionAsync(System.Action toggleAction)
    {
        toggleAction();
        await SaveMenuStateAsync();
    }

    private async Task LoadMenuStateAsync()
    {
        try
        {
            _menuStorageKey ??= await GetMenuStorageKeyAsync();
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", _menuStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var state = System.Text.Json.JsonSerializer.Deserialize<MenuState>(json);
                if (state is not null)
                {
                    _opsExpanded = state.OperationsExpanded;
                    _crewMgmtExpanded = state.CrewManagementExpanded;
                    _adminExpanded = state.AdminExpanded;
                    _trainingMgmtExpanded = state.TrainingManagementExpanded;
                    _userMgmtExpanded = state.UserManagementExpanded;
                }
            }
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        _menuStateLoaded = true;
        StateHasChanged();
    }

    private async Task SaveMenuStateAsync()
    {
        if (!_menuStateLoaded)
        {
            return;
        }

        try
        {
            _menuStorageKey ??= await GetMenuStorageKeyAsync();
            var json = System.Text.Json.JsonSerializer.Serialize(new MenuState(
                _opsExpanded,
                _crewMgmtExpanded,
                _adminExpanded,
                _trainingMgmtExpanded,
                _userMgmtExpanded));

            await JSRuntime.InvokeVoidAsync("localStorage.setItem", _menuStorageKey, json);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task<string> GetMenuStorageKeyAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userKey = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? user.Identity?.Name
            ?? "anonymous";

        return $"algoabaybmt:navmenu:{userKey}";
    }

    private static string BuildReturnUrl(string uri)
    {
        var relativePath = new Uri(uri).PathAndQuery;
        return string.IsNullOrWhiteSpace(relativePath) ? "/" : relativePath;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private sealed record MenuState(
        bool OperationsExpanded,
        bool CrewManagementExpanded,
        bool AdminExpanded,
        bool TrainingManagementExpanded,
        bool UserManagementExpanded);

    private const string ChevronIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>""";
    private const string RoleEditorIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='4'></circle><path d='M4 20c0-4 3.6-7 8-7'></path><path d='M16 19h6'></path><path d='M19 16v6'></path></svg>""";
    private const string HomeIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m3 9 9-7 9 7'></path><path d='M5 10v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V10'></path><path d='M9 21v-6h6v6'></path></svg>""";
    private const string TrainingIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 6v12'></path><path d='M17 9.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8.5'></path><path d='M21 6V3h-3'></path><path d='M10 14H7'></path><path d='M10 10H7'></path><path d='M18 3l-6 6'></path></svg>""";
    private const string OperationsIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 18h18'></path><path d='M6 18V6l6 4 6-4v12'></path><path d='M10 13h4'></path></svg>""";
    private const string WildlifeIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z'></path><circle cx='12' cy='12' r='3'></circle></svg>""";
    private const string EmergencyIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z'></path><line x1='12' y1='9' x2='12' y2='13'></line><line x1='12' y1='17' x2='12.01' y2='17'></line></svg>""";
    private const string ComplianceIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z'></path></svg>""";
    private const string DashboardIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='9'></rect><rect x='14' y='3' width='7' height='5'></rect><rect x='14' y='12' width='7' height='9'></rect><rect x='3' y='16' width='7' height='5'></rect></svg>""";
    private const string SettingsIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='3'></circle><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 8.91 4.6H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c0 .66.39 1.26 1 1.51.2.08.41.12.63.12H21a2 2 0 0 1 0 4h-.09c-.22 0-.43.04-.63.12-.61.25-1 .85-1 1.51Z'></path></svg>""";
    private const string AccountIcon = SettingsIcon;
    private const string LogoutIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'></path><polyline points='16 17 21 12 16 7'></polyline><line x1='21' y1='12' x2='9' y2='12'></line></svg>""";
    private const string LoginIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4'></path><polyline points='10 17 15 12 10 7'></polyline><line x1='15' y1='12' x2='3' y2='12'></line></svg>""";
    private const string RegisterIcon = """<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'></path><circle cx='8.5' cy='7' r='4'></circle><line x1='20' y1='8' x2='20' y2='14'></line><line x1='23' y1='11' x2='17' y2='11'></line></svg>""";
}

