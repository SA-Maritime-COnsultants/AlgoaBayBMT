@page "/admin/barges"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IBargeService BargeService
@inject IOperatorService OperatorService
@inject NavigationManager NavigationManager

<PageTitle>Bunker Barges</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Bunker Barges</h1>
            <div class="page-subtitle">Register bunker barges, link them to operators, and review deployments.</div>
        </div>
        <SfButton CssClass="ab-btn ab-btn-success pf-training-page-action-btn" IconCss="e-icons e-add" IconPosition="IconPosition.Left" OnClick="OpenCreateDialog">Create Barge</SfButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Barges" SubTitle="Operational bunker barges and their owning bunker operators." />
        <CardContent>
            <SfGrid DataSource="@BargeItems" TValue="BunkerBarge" AllowPaging="true" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact">
                <GridPageSettings PageSize="12" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn Field="@nameof(BunkerBarge.Name)" HeaderText="Name" Width="200" />
                    <GridColumn Field="@nameof(BunkerBarge.IMO)" HeaderText="IMO" Width="120" />
                    <GridColumn Field="@nameof(BunkerBarge.MMSI)" HeaderText="MMSI" Width="120" />
                    <GridColumn Field="@nameof(BunkerBarge.CapacityMT)" HeaderText="Capacity MT" Width="130" TextAlign="TextAlign.Right" />
                    <GridColumn HeaderText="Operator" Width="220"><Template>@((context as BunkerBarge)?.BunkerOperator?.Name)</Template></GridColumn>
                    <GridColumn HeaderText="Active" Width="110" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var barge = context as BunkerBarge; }
                            <span class="ab-badge @(barge?.IsActive == true ? "ab-badge-active" : "ab-badge-inactive")">@(barge?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="150" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var barge = context as BunkerBarge; }
                            @if (barge is not null)
                            {
                                <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                    <span class="pf-icon-action" title="Edit Barge"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-edit" OnClick="@(() => OpenEditDialog(barge))" /></span>
                                    <span class="pf-icon-action" title="View Deployments"><SfButton CssClass="e-flat pf-btn-details pf-btn-icon pf-btn-square abmt-grid-action-builder" IconCss="e-icons e-clock" OnClick="@(() => NavigationManager.NavigateTo($"/admin/barges/{barge.Id}/deployments"))" /></span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="980px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDialogVisible">
    <DialogTemplates>
        <Header>@(EditModel.Id == 0 ? "Create Barge" : "Edit Barge")</Header>
        <Content>
            <EditForm Model="EditModel" OnValidSubmit="SaveAsync" FormName="barge-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="pf-form-grid">
                    <div class="pf-col-6"><label class="pf-field-label">Name</label><SfTextBox @bind-Value="EditModel.Name" /></div>
                    <div class="pf-col-6">
                        <label class="pf-field-label">Bunker Operator</label>
                        <SfDropDownList TValue="int" TItem="BunkerOperator" DataSource="@Operators" @bind-Value="EditModel.BunkerOperatorId" Placeholder="Select operator">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                    </div>
                    <div class="pf-col-4"><label class="pf-field-label">IMO</label><SfTextBox @bind-Value="EditModel.IMO" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">MMSI</label><SfTextBox @bind-Value="EditModel.MMSI" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Call Sign</label><SfTextBox @bind-Value="EditModel.CallSign" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Capacity MT</label><SfNumericTextBox TValue="double?" @bind-Value="EditModel.CapacityMT" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Pumping Rate</label><SfNumericTextBox TValue="double?" @bind-Value="EditModel.PumpingRate" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Crew Capacity</label><SfNumericTextBox TValue="int?" @bind-Value="EditModel.CrewCapacity" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Last Inspection</label><SfDatePicker TValue="DateTime?" @bind-Value="EditModel.LastInspectionDate" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Certification Expiry</label><SfDatePicker TValue="DateTime?" @bind-Value="EditModel.CertificationExpiry" /></div>
                    <div class="pf-col-12"><label class="pf-field-label">Fuel Types Supported</label><SfTextBox @bind-Value="EditModel.FuelTypesSupported" /></div>
                    <div class="pf-col-6"><SfCheckBox @bind-Checked="EditModel.IsActive" Label="Active" /></div>
                </div>
                <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="CloseDialog">Cancel</SfButton>
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save Barge</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private List<BunkerBarge> BargeItems { get; set; } = [];
    private List<BunkerOperator> Operators { get; set; } = [];
    private BunkerBarge EditModel { get; set; } = new();
    private bool IsDialogVisible { get; set; }
    private string? Message { get; set; }
    private bool IsError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        BargeItems = await BargeService.GetAllAsync();
        Operators = (await OperatorService.GetAllAsync()).Where(x => x.IsActive).ToList();
    }

    private void OpenCreateDialog()
    {
        Message = null;
        EditModel = new BunkerBarge { IsActive = true, BunkerOperatorId = Operators.FirstOrDefault()?.Id ?? 0 };
        IsDialogVisible = true;
    }

    private void OpenEditDialog(BunkerBarge barge)
    {
        Message = null;
        EditModel = new BunkerBarge
        {
            Id = barge.Id,
            Name = barge.Name,
            IMO = barge.IMO,
            MMSI = barge.MMSI,
            CallSign = barge.CallSign,
            CapacityMT = barge.CapacityMT,
            FuelTypesSupported = barge.FuelTypesSupported,
            PumpingRate = barge.PumpingRate,
            LastInspectionDate = barge.LastInspectionDate,
            CertificationExpiry = barge.CertificationExpiry,
            CrewCapacity = barge.CrewCapacity,
            IsActive = barge.IsActive,
            BunkerOperatorId = barge.BunkerOperatorId
        };
        IsDialogVisible = true;
    }

    private void CloseDialog() => IsDialogVisible = false;

    private async Task SaveAsync()
    {
        try
        {
            if (EditModel.Id == 0)
            {
                await BargeService.CreateAsync(EditModel);
            }
            else
            {
                await BargeService.UpdateAsync(EditModel);
            }

            Message = "Barge saved successfully.";
            IsError = false;
            IsDialogVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
            IsError = true;
        }
    }
}
