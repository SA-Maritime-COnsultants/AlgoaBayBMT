@page "/admin/operators"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IOperatorService OperatorService
@inject NavigationManager NavigationManager

<PageTitle>Bunker Operators</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Bunker Operators</h1>
            <div class="page-subtitle">Manage bunker operating companies, contacts, area assignments, and linked barges.</div>
        </div>
        <SfButton CssClass="ab-btn ab-btn-success pf-training-page-action-btn" IconCss="e-icons e-add" IconPosition="IconPosition.Left" OnClick="OpenCreateDialog">Create Operator</SfButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Operators" SubTitle="Bunker operators authorised for one or more areas of operation." />
        <CardContent>
            <SfGrid DataSource="@OperatorItems" TValue="BunkerOperator" AllowPaging="true" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact">
                <GridPageSettings PageSize="12" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn Field="@nameof(BunkerOperator.Name)" HeaderText="Name" Width="220" />
                    <GridColumn Field="@nameof(BunkerOperator.ContactPerson)" HeaderText="Contact" Width="180" />
                    <GridColumn Field="@nameof(BunkerOperator.Email)" HeaderText="Email" Width="220" />
                    <GridColumn Field="@nameof(BunkerOperator.Phone)" HeaderText="Phone" Width="140" />
                    <GridColumn HeaderText="Active" Width="110" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var op = context as BunkerOperator; }
                            <span class="ab-badge @(op?.IsActive == true ? "ab-badge-active" : "ab-badge-inactive")">@(op?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="210" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var op = context as BunkerOperator; }
                            @if (op is not null)
                            {
                                <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                    <span class="pf-icon-action" title="Edit Operator"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-edit" OnClick="@(() => OpenEditDialog(op))" /></span>
                                    <span class="pf-icon-action" title="Assign Areas"><SfButton CssClass="e-flat pf-btn-details pf-btn-icon pf-btn-square abmt-grid-action-builder" IconCss="e-icons e-location" OnClick="@(() => NavigationManager.NavigateTo($"/admin/operators/{op.Id}/assign-areas"))" /></span>
                                    <span class="pf-icon-action" title="View Barges"><SfButton CssClass="e-flat pf-btn-email pf-btn-icon pf-btn-square abmt-grid-action-question-bank" IconCss="e-icons e-ship" OnClick="@(() => NavigationManager.NavigateTo("/admin/barges"))" /></span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="880px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDialogVisible">
    <DialogTemplates>
        <Header>@(EditModel.Id == 0 ? "Create Operator" : "Edit Operator")</Header>
        <Content>
            <EditForm Model="EditModel" OnValidSubmit="SaveAsync" FormName="operator-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="pf-form-grid">
                    <div class="pf-col-6"><label class="pf-field-label">Name</label><SfTextBox @bind-Value="EditModel.Name" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Registration Number</label><SfTextBox @bind-Value="EditModel.CompanyRegistrationNumber" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Contact Person</label><SfTextBox @bind-Value="EditModel.ContactPerson" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Email</label><SfTextBox @bind-Value="EditModel.Email" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Phone</label><SfTextBox @bind-Value="EditModel.Phone" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Emergency Contact</label><SfTextBox @bind-Value="EditModel.EmergencyContactNumber" /></div>
                    <div class="pf-col-12"><label class="pf-field-label">Physical Address</label><SfTextBox Multiline="true" @bind-Value="EditModel.PhysicalAddress" /></div>
                    <div class="pf-col-6"><SfCheckBox @bind-Checked="EditModel.IsActive" Label="Active" /></div>
                </div>
                <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="CloseDialog">Cancel</SfButton>
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save Operator</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private List<BunkerOperator> OperatorItems { get; set; } = [];
    private BunkerOperator EditModel { get; set; } = new();
    private bool IsDialogVisible { get; set; }
    private string? Message { get; set; }
    private bool IsError { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => OperatorItems = await OperatorService.GetAllAsync();

    private void OpenCreateDialog()
    {
        Message = null;
        EditModel = new BunkerOperator { IsActive = true };
        IsDialogVisible = true;
    }

    private void OpenEditDialog(BunkerOperator op)
    {
        Message = null;
        EditModel = new BunkerOperator
        {
            Id = op.Id,
            Name = op.Name,
            CompanyRegistrationNumber = op.CompanyRegistrationNumber,
            PhysicalAddress = op.PhysicalAddress,
            ContactPerson = op.ContactPerson,
            Email = op.Email,
            Phone = op.Phone,
            EmergencyContactNumber = op.EmergencyContactNumber,
            IsActive = op.IsActive
        };
        IsDialogVisible = true;
    }

    private void CloseDialog() => IsDialogVisible = false;

    private async Task SaveAsync()
    {
        try
        {
            if (EditModel.Id == 0)
            {
                await OperatorService.CreateAsync(EditModel);
            }
            else
            {
                await OperatorService.UpdateAsync(EditModel);
            }

            Message = "Operator saved successfully.";
            IsError = false;
            IsDialogVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
            IsError = true;
        }
    }
}
