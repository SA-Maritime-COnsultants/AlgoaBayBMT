@page "/"
@rendermode InteractiveServer

@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Grids

<PageTitle>Algoa Bay BMT — Operations Dashboard</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/homepage.css" />
</HeadContent>

<div class="home-dashboard">

    @* ══════════════════════════════════════════════
       HERO — Operations Banner
       ══════════════════════════════════════════════ *@
    <section class="hero-section hero-section--light" aria-label="Operations overview">
        <div class="hero-content">
            <h1 class="hero-title hero-title--dark">Algoa Bay Bunkering Management &amp; Training</h1>
            <p class="hero-subtitle hero-subtitle--dark">
                Real-time bunkering operations, DFFE-compliant environmental oversight,
                and crew training — integrated in one platform.
            </p>
            <div class="hero-actions">
                <button class="abmt-action-btn abmt-btn-teal"
                        @onclick='() => Nav.NavigateTo("bunkering-operations")'>
                    <i class="bi bi-droplet-fill"></i> Bunkering Operations
                </button>
                <button class="abmt-action-btn abmt-btn-green"
                        @onclick='() => Nav.NavigateTo("my-training")'>
                    <i class="bi bi-mortarboard-fill"></i> My Training Dashboard
                </button>
                <button class="abmt-action-btn abmt-btn-blue"
                        @onclick='() => Nav.NavigateTo("crewing/compliance")'>
                    <i class="bi bi-shield-check"></i> Crew Compliance
                </button>
            </div>
        </div>
    </section>

    @* ══════════════════════════════════════════════
       QUICK ACCESS TILES
       ══════════════════════════════════════════════ *@
    <section class="quick-access-section" aria-label="Quick access workflows">
        <h2 class="section-heading">Quick Access</h2>
        <div class="quick-access-grid">

            <a href="bunkering-operations" class="tile-link">
                <SfCard CssClass="tile-card status-normal e-card">
                    <CardContent>
                        <div class="tile-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12h18M3 6h18M3 18h18"/>
                            </svg>
                        </div>
                        <div class="tile-title">Bunkering Ops</div>
                        <p class="tile-desc">Fuel transfer records &amp; vessel operations</p>
                    </CardContent>
                </SfCard>
            </a>

            <a href="crewing/compliance" class="tile-link">
                <SfCard CssClass="tile-card status-success e-card">
                    <CardContent>
                        <div class="tile-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                            </svg>
                        </div>
                        <div class="tile-title">Crew Compliance</div>
                        <p class="tile-desc">Vessel snapshot &amp; certificate status</p>
                    </CardContent>
                </SfCard>
            </a>

            <a href="crewing/expiries" class="tile-link">
                <SfCard CssClass="tile-card status-warning e-card">
                    <CardContent>
                        <span class="tile-alert-badge e-badge" aria-label="Items need attention">!</span>
                        <div class="tile-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                        </div>
                        <div class="tile-title">Certificate Expiries</div>
                        <p class="tile-desc status-text-warning">Upcoming &amp; expired certificates</p>
                    </CardContent>
                </SfCard>
            </a>

            <a href="my-training" class="tile-link">
                <SfCard CssClass="tile-card status-normal e-card">
                    <CardContent>
                        <div class="tile-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                            </svg>
                        </div>
                        <div class="tile-title">My Training</div>
                        <p class="tile-desc">Progress, compliance &amp; certificates</p>
                    </CardContent>
                </SfCard>
            </a>

            <a href="training-management" class="tile-link">
                <SfCard CssClass="tile-card status-normal e-card">
                    <CardContent>
                        <div class="tile-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/>
                            </svg>
                        </div>
                        <div class="tile-title">Training Management</div>
                        <p class="tile-desc">Course authoring &amp; approvals</p>
                    </CardContent>
                </SfCard>
            </a>

            <a href="crewing/sign-on" class="tile-link">
                <SfCard CssClass="tile-card status-normal e-card">
                    <CardContent>
                        <div class="tile-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/>
                            </svg>
                        </div>
                        <div class="tile-title">Sign-On / Off</div>
                        <p class="tile-desc">Compliance-gated crew sign-on</p>
                    </CardContent>
                </SfCard>
            </a>

        </div>
    </section>

    @* ══════════════════════════════════════════════
       TWO-COLUMN ROW: Training Overview + Snapshot
       ══════════════════════════════════════════════ *@
    <div class="home-two-col">

        @* ── Training Modules Overview ── *@
        <section class="training-section home-two-col__main" aria-label="Training modules overview">
            <h2 class="section-heading">Active Training Modules</h2>
            <div class="training-grid">

                <SfCard CssClass="training-card e-card">
                    <CardHeader>
                        <div class="training-card-header">
                            <span class="category-badge category-operations e-badge">Operations</span>
                            <span class="cert-badge e-badge">STCW</span>
                        </div>
                    </CardHeader>
                    <CardContent>
                        <div class="training-title">Basic Safety Training</div>
                        <p class="training-desc">Fire prevention, survival craft, first aid and personal safety aboard bunkering vessels.</p>
                        <div class="progress-container">
                            <div class="progress-track" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-fill progress-fill--complete" style="width:100%"></div>
                            </div>
                            <span class="progress-label">Completed — 100%</span>
                        </div>
                    </CardContent>
                </SfCard>

                <SfCard CssClass="training-card e-card">
                    <CardHeader>
                        <div class="training-card-header">
                            <span class="category-badge category-compliance e-badge">Compliance</span>
                            <span class="cert-badge e-badge">DFFE</span>
                        </div>
                    </CardHeader>
                    <CardContent>
                        <div class="training-title">Environmental Obligations</div>
                        <p class="training-desc">DFFE regulatory requirements, spill response protocols, and Algoa Bay sensitive-area procedures.</p>
                        <div class="progress-container">
                            <div class="progress-track" role="progressbar" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-fill progress-fill--good" style="width:72%"></div>
                            </div>
                            <span class="progress-label">In Progress — 72%</span>
                        </div>
                    </CardContent>
                </SfCard>

                <SfCard CssClass="training-card e-card">
                    <CardHeader>
                        <div class="training-card-header">
                            <span class="category-badge category-safety e-badge">Safety</span>
                        </div>
                    </CardHeader>
                    <CardContent>
                        <div class="training-title">Emergency Response Procedures</div>
                        <p class="training-desc">Muster drills, emergency shutdown, and incident reporting for bunkering operations.</p>
                        <div class="progress-container">
                            <div class="progress-track" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-fill progress-fill--moderate" style="width:45%"></div>
                            </div>
                            <span class="progress-label">In Progress — 45%</span>
                        </div>
                    </CardContent>
                </SfCard>

                <SfCard CssClass="training-card e-card">
                    <CardHeader>
                        <div class="training-card-header">
                            <span class="category-badge category-environment e-badge">Environment</span>
                            <span class="cert-badge e-badge">ISO 14001</span>
                        </div>
                    </CardHeader>
                    <CardContent>
                        <div class="training-title">Wildlife &amp; Marine Conservation</div>
                        <p class="training-desc">African penguin buffer zones, marine mammal encounters, and environmental incident reporting.</p>
                        <div class="progress-container">
                            <div class="progress-track" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-fill progress-fill--low" style="width:20%"></div>
                            </div>
                            <span class="progress-label">Not Started — 20%</span>
                        </div>
                    </CardContent>
                </SfCard>

            </div>
        </section>

        @* ── Operational Snapshot ── *@
        <section class="snapshot-section home-two-col__side" aria-label="Operational snapshot">
            <h2 class="section-heading">Operational Snapshot</h2>

            <div class="snapshot-widget">
                <div class="widget-heading">
                    <span class="widget-icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M9.59 4.59A2 2 0 1 1 11 8H2"/><path d="M19.73 7.73A2.5 2.5 0 1 1 19.5 12H2"/><path d="M12.59 19.41A2 2 0 1 0 14 16H2"/>
                        </svg>
                    </span>
                    Current Conditions
                </div>
                <div class="widget-metrics">
                    <div class="metric">
                        <span class="metric-value">SW 18 kn</span>
                        <span class="metric-label">Wind</span>
                    </div>
                    <div class="metric">
                        <span class="metric-value">BF 5</span>
                        <span class="metric-label">Beaufort</span>
                    </div>
                    <div class="metric">
                        <span class="metric-value">1.4 m</span>
                        <span class="metric-label">Swell</span>
                    </div>
                    <div class="metric">
                        <span class="metric-value">14 °C</span>
                        <span class="metric-label">Sea Temp</span>
                    </div>
                </div>
            </div>

            <div class="snapshot-widget">
                <div class="widget-heading">
                    <span class="widget-icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/>
                        </svg>
                    </span>
                    Active Operations
                </div>
                <div class="ops-list">
                    <div class="ops-item">
                        <span class="ops-vessel">MV Algoa Spirit</span>
                        <span class="ops-detail">Bunker transfer — Berth 4 · 09:42</span>
                    </div>
                    <div class="ops-item">
                        <span class="ops-vessel">TB Algoa Chief</span>
                        <span class="ops-detail">Standby — Outer anchorage · 10:15</span>
                    </div>
                </div>
            </div>

            <div class="snapshot-widget snapshot-widget--alert">
                <div class="widget-heading widget-heading--warning">
                    <span class="widget-icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                    </span>
                    Environmental Alerts
                </div>
                <div class="alert-item status-warning">
                    <span class="alert-type">Penguin Buffer Zone — Active</span>
                    <span class="alert-time">Valid until 16:00 · Area C3</span>
                </div>
                <div class="alert-item status-success">
                    <span class="alert-type">Spill Risk Assessment — Cleared</span>
                    <span class="alert-time">Reviewed 07:30 · All berths</span>
                </div>
            </div>

        </section>

    </div>

    @* ══════════════════════════════════════════════
       COMPLIANCE FOOTER — Regulatory Accordion
       ══════════════════════════════════════════════ *@
    <section class="compliance-section" aria-label="Regulatory compliance reference">
        <h2 class="section-heading">Regulatory Compliance Reference</h2>
        <SfAccordion CssClass="compliance-accordion">
            <AccordionItems>

                <AccordionItem Header="LOSCP — Bunkering Safety Management System">
                    <ContentTemplate>
                        <div class="compliance-content">
                            <p>The Letter of Safe Carriage Procedures (LOSCP) governs all bunker transfer operations at the Port of Ngqura and Port Elizabeth. All transfer officers must hold a current LOSCP endorsement before conducting or supervising fuel transfers.</p>
                            <ul class="compliance-list">
                                <li>Pre-transfer safety checklist must be completed and signed by the Chief Officer and Bunker Supervisor.</li>
                                <li>Mooring arrangements must comply with OCIMF MEG4 guidelines at all times.</li>
                                <li>Bunker hose connections must be pressure-tested at each new berth assignment.</li>
                                <li>Emergency shutdown procedures must be reviewed at commencement of each transfer.</li>
                            </ul>
                            <p class="compliance-ref">Reference: SAMSA Marine Notice 24 of 2019 · IMO MARPOL Annex I Regulation 39</p>
                        </div>
                    </ContentTemplate>
                </AccordionItem>

                <AccordionItem Header="Port Authority — Harbour Regulations &amp; Entry Requirements">
                    <ContentTemplate>
                        <div class="compliance-content">
                            <p>Transnet National Ports Authority (TNPA) governs all vessel entry, movement, and bunkering permits within Algoa Bay ports. All vessels must submit ETA 48 hours in advance and receive a berth allocation before commencing operations.</p>
                            <ul class="compliance-list">
                                <li>Valid Port State Control (PSC) clearance required within the preceding 12 months.</li>
                                <li>Bunker barge pre-arrival declaration must be submitted via TNPA VTS not less than 4 hours prior to arrival.</li>
                                <li>All crew must hold valid STCW certificates and Flag State endorsements.</li>
                            </ul>
                            <p class="compliance-ref">Reference: TNPA Port Rules 2021 · National Ports Act 12 of 2005</p>
                        </div>
                    </ContentTemplate>
                </AccordionItem>

                <AccordionItem Header="DFFE — Environmental Commitments &amp; Sensitive Area Protocols">
                    <ContentTemplate>
                        <div class="compliance-content">
                            <p>The Department of Forestry, Fisheries and Environment (DFFE) mandates specific environmental controls for all bunkering activities within the Algoa Bay Marine Protected Area boundary.</p>
                            <ul class="compliance-list">
                                <li>African penguin buffer zone (500 m) must be observed during breeding season (November–February).</li>
                                <li>No discharge of fuel, bilge water, or grey water within the MPA boundary.</li>
                                <li>Environmental Officer must be present or on-call for all bunker transfers exceeding 500 MT.</li>
                                <li>Wildlife incident log must be maintained and submitted monthly to the DFFE Algoa Bay desk.</li>
                            </ul>
                            <p class="compliance-ref">Reference: DFFE Marine Protected Area Regulations 2019 · National Environmental Management Act 107 of 1998</p>
                        </div>
                    </ContentTemplate>
                </AccordionItem>

                <AccordionItem Header="Document Access — Certificates, Permits &amp; Authorisations">
                    <ContentTemplate>
                        <div class="compliance-content">
                            <p>All operational and compliance documentation is stored in the AlgoaBayBMT document register. The following categories are maintained and subject to periodic audit:</p>
                            <ul class="compliance-list">
                                <li>Vessel certificates — IOPP, ISM, ISPS, Load Line, Safety Management Certificate</li>
                                <li>Crew STCW endorsements and competency certificates</li>
                                <li>Bunker delivery notes (BDN) and fuel quality analysis reports</li>
                                <li>Environmental impact assessments and DFFE authorisation letters</li>
                                <li>TNPA port entry permits and bunkering authorisations</li>
                            </ul>
                            <p class="compliance-ref">Reference: ISM Code 2018 Edition · ISPS Code 2003 as amended</p>
                        </div>
                    </ContentTemplate>
                </AccordionItem>

            </AccordionItems>
        </SfAccordion>
    </section>

</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
