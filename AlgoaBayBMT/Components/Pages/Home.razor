@page "/"
@rendermode InteractiveServer

@using Syncfusion.Blazor.Layouts

<HeadContent>
    <link href="css/homepage.css" rel="stylesheet" />
</HeadContent>

<section class="home-dashboard" aria-label="Homepage dashboard">
    <SfDashboardLayout Columns="12"
                       CellSpacing="@(new double[] { 16, 16 })"
                       AllowDragging="false"
                       AllowFloating="false">
        <DashboardLayoutPanels>
            <DashboardLayoutPanel Id="hero-panel" Row="0" Column="0" SizeX="12" SizeY="3">
                <ContentTemplate>
                    <HeroSection />
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="quick-access-panel" Row="3" Column="0" SizeX="12" SizeY="2">
                <ContentTemplate>
                    <QuickAccessTiles />
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="training-panel" Row="5" Column="0" SizeX="8" SizeY="3">
                <ContentTemplate>
                    <TrainingModulesOverview />
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="snapshot-panel" Row="5" Column="8" SizeX="4" SizeY="3">
                <ContentTemplate>
                    <OperationalSnapshot />
                </ContentTemplate>
            </DashboardLayoutPanel>
        </DashboardLayoutPanels>
    </SfDashboardLayout>

    <ComplianceFooter />
</section>
