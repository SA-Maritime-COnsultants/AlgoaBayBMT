@page "/multicolumncombobox-features"
@rendermode InteractiveServer
@using Syncfusion.Blazor
@using Syncfusion.Blazor.MultiColumnComboBox
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons;
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Inputs
<PageTitle>MultiColumn ComboBox</PageTitle>
<h2>MultiColumn ComboBox</h2>
<br/>
<div>
  <h3>Selected Features:</h3>
    <ul class="ulstyle">
      <li class="list"> MultiColumn ComboBox Samples - Local Data</li>
      <li class="list"> Theme - Tailwind</li>
    </ul>
</div>
<br/>
<SfMultiColumnComboBox @bind-Value="@Value" DataSource="@Products" Width="500px" ValueField="Name" TextField="Name" Placeholder="Select any product" >
</SfMultiColumnComboBox>
@code {
    public class Product
    {
        public string Name { get; set; }
        public decimal Price { get; set; }
        public string Availability { get; set; }
        public string Category { get; set; }
        public double Rating { get; set; }
