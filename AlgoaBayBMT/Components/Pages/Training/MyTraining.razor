@page "/my-training"
@rendermode InteractiveServer
@attribute [Authorize]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications

@inject ILearnerTrainingService LearnerTrainingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>My Training</PageTitle>

<div class="page-shell pf-training-learner-shell">

    @if (Dashboard is null)
    {
        <SfCard CssClass="pf-card-shell pf-training-learner-card">
            <CardContent>
                <div class="pf-empty-state">Loading your training dashboard...</div>
            </CardContent>
        </SfCard>
    }
    else
    {
        <div class="page-header pf-training-learner-header">
            <div>
                <h1 class="page-title">My Training</h1>
                <div class="page-subtitle">
                    Welcome @Dashboard.LearnerName — track your assigned compliance training, continue in‑progress courses and view your certificates.
                </div>
            </div>
            <div class="pf-grid-actions pf-grid-actions--compact">
                <SfButton CssClass="e-outline" OnClick="ReloadAsync">Refresh</SfButton>
            </div>
        </div>

        @* ── Compliance summary tiles ─────────────────────────────── *@
        <div class="pf-stat-grid pf-training-learner-stats">
            <SfCard CssClass="pf-stat-card pf-stat-card--primary">
                <CardContent>
                    <div class="pf-stat-label">Compliance</div>
                    <div class="pf-stat-value">@FormatPercent(Dashboard.CompliancePercent)%</div>
                    <div class="pf-progress-track">
                        <div class="pf-progress-fill" style="width:@(FormatPercent(Dashboard.CompliancePercent))%"></div>
                    </div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-stat-card">
                <CardContent>
                    <div class="pf-stat-label">Required courses</div>
                    <div class="pf-stat-value">@Dashboard.CompletedCourses / @Dashboard.TotalRequiredCourses</div>
                    <div class="pf-stat-sub">Completed</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-stat-card">
                <CardContent>
                    <div class="pf-stat-label">In progress</div>
                    <div class="pf-stat-value">@Dashboard.InProgressCourses</div>
                    <div class="pf-stat-sub">Active assignments</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-stat-card pf-stat-card--alert">
                <CardContent>
                    <div class="pf-stat-label">Overdue / Expired</div>
                    <div class="pf-stat-value">@Dashboard.OverdueOrExpiredCourses</div>
                    <div class="pf-stat-sub">Action required</div>
                </CardContent>
            </SfCard>
        </div>

        @* ── Required courses ─────────────────────────────────────── *@
        <SfCard CssClass="pf-card-shell pf-training-learner-card">
            <CardHeader Title="Required Training" SubTitle="Mandatory compliance courses assigned to you." />
            <CardContent>
                @if (Dashboard.RequiredCourses.Count == 0)
                {
                    <div class="pf-empty-state">No required courses are currently assigned.</div>
                }
                else
                {
                    <div class="pf-training-course-grid">
                        @foreach (var course in Dashboard.RequiredCourses)
                        {
                            @RenderCourseCard(course)
                        }
                    </div>
                }
            </CardContent>
        </SfCard>

        @* ── Additional courses ───────────────────────────────────── *@
        @if (Dashboard.AdditionalCourses.Count > 0)
        {
            <SfCard CssClass="pf-card-shell pf-training-learner-card">
                <CardHeader Title="Additional Training" SubTitle="Optional or supplementary courses available to you." />
                <CardContent>
                    <div class="pf-training-course-grid">
                        @foreach (var course in Dashboard.AdditionalCourses)
                        {
                            @RenderCourseCard(course)
                        }
                    </div>
                </CardContent>
            </SfCard>
        }

        @* ── Certificates ─────────────────────────────────────────── *@
        <SfCard CssClass="pf-card-shell pf-training-learner-card">
            <CardHeader Title="My Certificates" SubTitle="Issued completion certificates with verification codes." />
            <CardContent>
                @if (Dashboard.Certificates.Count == 0)
                {
                    <div class="pf-empty-state">No certificates have been issued yet. Complete a course to earn your first certificate.</div>
                }
                else
                {
                    <div class="pf-training-cert-grid">
                        @foreach (var cert in Dashboard.Certificates)
                        {
                            <SfCard CssClass="pf-training-cert-card">
                                <CardContent>
                                    <div class="pf-training-cert-title">@cert.CourseTitle</div>
                                    <div class="pf-training-cert-meta">
                                        <span class="e-badge pf-role-badge">@cert.CourseCode</span>
                                        <span class="e-badge @CertStatusBadge(cert)">@cert.CompletionStatus</span>
                                    </div>
                                    <div class="pf-training-cert-line">
                                        <span class="pf-training-cert-label">Number</span>
                                        <strong>@cert.CertificateNumber</strong>
                                    </div>
                                    <div class="pf-training-cert-line">
                                        <span class="pf-training-cert-label">Verification</span>
                                        <strong>@cert.VerificationCode</strong>
                                    </div>
                                    <div class="pf-training-cert-line">
                                        <span class="pf-training-cert-label">Issued</span>
                                        <strong>@cert.CompletedOnUtc.ToLocalTime().ToString("dd MMM yyyy")</strong>
                                    </div>
                                    <div class="pf-training-cert-line">
                                        <span class="pf-training-cert-label">Expires</span>
                                        <strong>@cert.ExpiresOnUtc.ToLocalTime().ToString("dd MMM yyyy")</strong>
                                    </div>
                                </CardContent>
                                <CardFooter>
                                    <div class="pf-grid-actions pf-grid-actions--compact">
                                        <a class="e-btn e-primary" href="@cert.ViewUrl">View</a>
                                        <a class="e-btn" href="@cert.DownloadUrl">Print / Save</a>
                                    </div>
                                </CardFooter>
                            </SfCard>
                        }
                    </div>
                }
            </CardContent>
        </SfCard>
    }
</div>

@code {
    private MyTrainingDashboardModel? Dashboard;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(_userId))
        {
            return;
        }

        Dashboard = await LearnerTrainingService.GetDashboardAsync(_userId);
    }

    private async Task ReloadAsync()
    {
        if (string.IsNullOrWhiteSpace(_userId))
        {
            return;
        }

        Dashboard = null;
        StateHasChanged();
        Dashboard = await LearnerTrainingService.GetDashboardAsync(_userId);
    }

    private RenderFragment RenderCourseCard(MyTrainingCourseListItemModel course) => @<SfCard CssClass="pf-training-course-card">
        <CardContent>
            <div class="pf-training-course-header">
                <div class="pf-training-course-title">@course.Title</div>
                <span class="e-badge @StatusBadgeClass(course.Status)">@StatusLabel(course.Status)</span>
            </div>
            <div class="pf-training-course-meta">
                <span class="e-badge pf-role-badge">@course.Code</span>
                @if (course.IsMandatory)
                {
                    <span class="e-badge e-badge-danger">Mandatory</span>
                }
                @if (course.DurationMinutes is int mins && mins > 0)
                {
                    <span class="e-badge pf-role-badge">@mins min</span>
                }
                @if (course.ValidityMonths > 0)
                {
                    <span class="e-badge pf-role-badge">Valid @course.ValidityMonths mo</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(course.Summary))
            {
                <div class="pf-training-course-summary">@course.Summary</div>
            }
            <div class="pf-training-course-progress">
                <div class="pf-progress-track">
                    <div class="pf-progress-fill" style="width:@(FormatPercent(course.ProgressPercent))%"></div>
                </div>
                <div class="pf-training-course-progress-label">@FormatPercent(course.ProgressPercent)% complete</div>
            </div>
            <div class="pf-training-course-dates">
                @if (course.DueDateUtc is DateTime due)
                {
                    <div><span class="pf-training-cert-label">Due</span> <strong>@due.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                }
                @if (course.ExpiryDateUtc is DateTime exp)
                {
                    <div><span class="pf-training-cert-label">Expires</span> <strong>@exp.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                }
            </div>
        </CardContent>
        <CardFooter>
            <div class="pf-grid-actions pf-grid-actions--compact">
                <SfButton CssClass="e-primary" OnClick="@(() => OpenCourse(course.RegistrationId))">@course.ActionText</SfButton>
            </div>
        </CardFooter>
    </SfCard>;

    private void OpenCourse(Guid registrationId)
        => NavigationManager.NavigateTo($"/my-training/course/{registrationId}");

    private static string FormatPercent(decimal value) => Math.Round(value, 0).ToString("0");

    private static string StatusLabel(TrainingAccessStatus status) => status switch
    {
        TrainingAccessStatus.NotStarted => "Not started",
        TrainingAccessStatus.InProgress => "In progress",
        TrainingAccessStatus.Compliant => "Compliant",
        TrainingAccessStatus.Expired => "Expired",
        TrainingAccessStatus.Overdue => "Overdue",
        _ => status.ToString()
    };

    private static string StatusBadgeClass(TrainingAccessStatus status) => status switch
    {
        TrainingAccessStatus.Compliant => "e-badge-success",
        TrainingAccessStatus.InProgress => "e-badge-info",
        TrainingAccessStatus.Expired => "e-badge-danger",
        TrainingAccessStatus.Overdue => "e-badge-warning",
        _ => "pf-role-badge"
    };

    private static string CertStatusBadge(MyTrainingCertificateListItemModel cert)
    {
        if (cert.ExpiresOnUtc <= DateTime.UtcNow)
        {
            return "e-badge-danger";
        }
        if (cert.ExpiresOnUtc <= DateTime.UtcNow.AddDays(30))
        {
            return "e-badge-warning";
        }
        return "e-badge-success";
    }
}
