@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject ILearnerTrainingService LearnerTrainingService

@implements IAsyncDisposable

<div class="tp-video-container" @key="_containerKey">
    @if (!string.IsNullOrWhiteSpace(Block.FileUrl))
    {
        <video id="@_videoId"
               src="@Block.FileUrl"
               preload="metadata"
               autoplay
               muted
               controls
               playsinline
               @ontimeupdate="HandleTimeUpdateAsync"
               @onpause="HandlePauseAsync"
               @onended="HandleEndedAsync"
               @onloadedmetadata="HandleLoadedMetadataAsync"
               style="width:100%;max-height:480px;background:#000;display:block;">
            Your browser does not support HTML5 video.
        </video>
    }
    else if (!string.IsNullOrWhiteSpace(Block.ExternalUrl))
    {
        @* External — open in new tab; tracking not available *@
        <div style="display:flex;align-items:center;justify-content:center;height:100%;background:#111;color:#fff;flex-direction:column;gap:1rem;">
            <p>This video is hosted externally.</p>
            <a class="e-btn e-primary" href="@Block.ExternalUrl" target="_blank" rel="noreferrer">Open Video</a>
        </div>
    }
</div>

@if (_videoCompleted)
{
    <div class="tp-video-complete-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        Video complete
    </div>
}

@if (!string.IsNullOrWhiteSpace(Block.IntroTextHtml))
{
    <div style="margin-top:0.75rem;">@((MarkupString)Block.IntroTextHtml)</div>
}

@code {
    [Parameter, EditorRequired] public TrainingPlayerBlockModel Block { get; set; } = default!;
    [Parameter, EditorRequired] public string UserId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Guid CourseId { get; set; }
    [Parameter, EditorRequired] public Guid LessonId { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }

    private IJSObjectReference? _module;
    private string _videoId = string.Empty;
    private string _containerKey = string.Empty;
    private bool _videoCompleted;
    private DateTime _lastSave = DateTime.MinValue;
    private double _lastKnownTime;
    private double _videoDuration;
    private bool _disposed;
    private Guid _initializedForBlock;
    private bool _completionHandled;
    private const string TrainingPlayerModulePath = "/js/trainingPlayer.js?v=20260418f";

    protected override void OnParametersSet()
    {
        _videoId = $"video-{Block.BlockId:N}";
        _containerKey = $"vbp-{Block.BlockId}";
        _videoCompleted = Block.IsCompleted;
        _lastKnownTime = Block.SavedVideoSeconds ?? 0;
        _videoDuration = Block.DurationSeconds ?? 0;
        _completionHandled = Block.IsCompleted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (string.IsNullOrWhiteSpace(Block.FileUrl)) return;
        // Re-initialize whenever the block changes, not just on firstRender,
        // because Blazor may reuse the component instance for a new block.
        if (_initializedForBlock == Block.BlockId) return;
        _initializedForBlock = Block.BlockId;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", TrainingPlayerModulePath);
            await _module.InvokeVoidAsync("prepareVideoPlayer", _videoId);
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"VideoBlockPlayer: JS init failed for {_videoId}: {ex.Message}");
        }
        // Seeking is deferred to OnVideoMetadata (fires after loadedmetadata), so no seek here.
    }

    private async Task HandleTimeUpdateAsync()
    {
        if (_disposed) return;

        var currentTime = await GetCurrentTimeAsync();
        _lastKnownTime = currentTime;

        if (!_completionHandled && _videoDuration > 0 && currentTime >= _videoDuration - 1)
        {
            await CompleteVideoAsync();
            return;
        }

        var now = DateTime.UtcNow;
        if ((now - _lastSave).TotalSeconds < 10) return;
        _lastSave = now;
        try { await LearnerTrainingService.SaveVideoProgressAsync(UserId, LessonId, Block.BlockId, (int)currentTime); } catch (ObjectDisposedException) { }
    }

    private async Task HandleEndedAsync()
        => await CompleteVideoAsync();

    private async Task CompleteVideoAsync()
    {
        if (_disposed || _completionHandled) return;
        _completionHandled = true;
        _videoCompleted = true;
        try
        {
            var completedSeconds = (int)Math.Max(_lastKnownTime, _videoDuration > 0 ? _videoDuration : Block.DurationSeconds ?? 0);
            var result = await LearnerTrainingService.CompleteVideoBlockAsync(UserId, CourseId, LessonId, Block.BlockId, completedSeconds);
            if (!result.Succeeded)
            {
                _completionHandled = false;
                return;
            }

            Block.IsCompleted = true;
            await InvokeAsync(StateHasChanged);
            await OnCompleted.InvokeAsync();
        }
        catch (ObjectDisposedException) { }
    }

    private async Task HandlePauseAsync()
    {
        // Save position on every pause so navigation away captures the last watched point
        if (_disposed || _completionHandled) return;
        _lastKnownTime = await GetCurrentTimeAsync();
        if (!_completionHandled && _videoDuration > 0 && _lastKnownTime >= _videoDuration - 2)
        {
            await CompleteVideoAsync();
            return;
        }

        try { await LearnerTrainingService.SaveVideoProgressAsync(UserId, LessonId, Block.BlockId, (int)_lastKnownTime); } catch (ObjectDisposedException) { }
    }

    private async Task HandleLoadedMetadataAsync()
    {
        // Seek to saved position AFTER loadedmetadata — this is the correct timing
        if (_disposed || _module is null) return;
        _videoDuration = await GetDurationAsync();
        if (Block.SavedVideoSeconds is > 0 && !_videoCompleted)
        {
            try { await _module.InvokeVoidAsync("seekVideo", _videoId, Block.SavedVideoSeconds.Value); } catch { }
        }
    }

    private async Task<double> GetCurrentTimeAsync()
    {
        if (_module is null)
        {
            return _lastKnownTime;
        }

        try
        {
            return await _module.InvokeAsync<double>("getCurrentTime", _videoId);
        }
        catch
        {
            return _lastKnownTime;
        }
    }

    private async Task<double> GetDurationAsync()
    {
        if (_module is null)
        {
            return _videoDuration;
        }

        try
        {
            return await _module.InvokeAsync<double>("getDuration", _videoId);
        }
        catch
        {
            return _videoDuration;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null && !string.IsNullOrWhiteSpace(Block.FileUrl))
        {
            try { await _module.InvokeVoidAsync("destroyPlayer", _videoId); } catch { }
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
