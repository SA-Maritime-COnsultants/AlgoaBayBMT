@page "/my-training/course/{CourseId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Models
@using Microsoft.AspNetCore.Components
@using Syncfusion.Blazor.Notifications

@implements IDisposable

@inject ILearnerTrainingService LearnerTrainingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(Player?.Title ?? "Course Player")</PageTitle>

<SfToast @ref="Toast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top" />
</SfToast>

<div class="training-player-page">

    @* ── Top bar ──────────────────────────────────────────────── *@
    <div class="tp-topbar">
        <div class="tp-topbar-left">
            <a href="/my-training" class="tp-back-btn">&#8592; My Training</a>
            @if (Player is not null)
            {
                <div class="tp-learner-tag">
                    <span class="tp-learner-label">My Training</span>
                    <span class="tp-learner-name">@Player.Title</span>
                </div>
                <span class="e-badge tp-topbar-meta" style="flex-shrink:0;">@Player.Code</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Player?.CertificateUrl))
        {
            <a href="@Player.CertificateUrl" class="e-btn e-primary" style="flex-shrink:0;">View Certificate</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="pf-alert pf-alert--warning-strong" role="alert" style="margin:0.5rem;">@ErrorMessage</div>
    }

    @if (Player is null)
    {
        <div style="display:flex;align-items:center;justify-content:center;flex:1;">
            <div class="pf-empty-state">Loading training player…</div>
        </div>
    }
    else
    {
        <div class="training-player-layout">

            @* ── LEFT: Course Journey ─────────────────────────────── *@
            <CourseJourneyPanel Modules="Player.Modules"
                                CompletedLessons="Player.CompletedLessons"
                                TotalLessons="Player.TotalLessons"
                                OnLessonSelected="NavigateToLesson" />

            @* ── CENTER: Player ───────────────────────────────────── *@
            <div class="training-panel" style="min-height:0;">
                <div class="training-panel-header">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Course Player
                    @if (Player.CurrentLesson is not null)
                    {
                        <span class="tp-header-badge">@Player.CurrentLesson.Title</span>
                    }
                </div>

                @* Block chip navigation strip *@
                <div style="padding:0.5rem 0.75rem;border-bottom:1px solid #dee2e6;flex-shrink:0;">
                    <div class="tp-block-chips">
                        @foreach (var block in Player.CurrentLesson?.Blocks ?? Enumerable.Empty<TrainingPlayerBlockModel>())
                        {
                            <button type="button"
                                    @key="block.BlockId"
                                    class="tp-block-chip @(block.IsCurrent ? "is-current" : string.Empty) @(block.IsCompleted ? "is-completed" : string.Empty)"
                                    disabled="@block.IsLocked"
                                    @onclick="() => NavigateToBlock(block.BlockId)">
                                @if (block.IsCompleted)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                                @block.DisplayType
                            </button>
                        }
                    </div>
                </div>

                @* Current block content *@
                <div class="training-panel-body" @key="_blockRenderKey">
                    @if (Player.CurrentBlock is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.Title))
                        {
                            <div style="font-weight:600;font-size:1rem;margin-bottom:0.5rem;">@Player.CurrentBlock.Title</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.Subtitle))
                        {
                            <div style="color:#6c757d;font-size:0.85rem;margin-bottom:0.75rem;">@Player.CurrentBlock.Subtitle</div>
                        }

                        @switch (Player.CurrentBlock.BlockType)
                        {
                            case LessonBlockType.Video:
                                <VideoBlockPlayer @key="_blockRenderKey"
                                                  Block="Player.CurrentBlock"
                                                  UserId="@CurrentUserId"
                                                  CourseId="Player.CourseId"
                                                  LessonId="Player.CurrentLesson!.LessonId"
                                                  OnCompleted="OnVideoBlockAutoCompleted" />
                                break;

                            case LessonBlockType.TextNarrative:
                                <CardBlockPlayer Block="Player.CurrentBlock" />
                                break;

                            case LessonBlockType.Card:
                                <CardBlockPlayer Block="Player.CurrentBlock" />
                                break;

                            case LessonBlockType.Flashcard:
                                <FlashCardBlockPlayer @ref="_flashCardRef"
                                                     Block="Player.CurrentBlock"
                                                     UserId="@CurrentUserId"
                                                     CourseId="Player.CourseId"
                                                     LessonId="Player.CurrentLesson!.LessonId"
                                                     OnCompleted="OnBlockAutoCompleted" />
                                break;

                            case LessonBlockType.Quiz:
                                <QuizBlockPlayer @key="_blockRenderKey"
                                                 Block="Player.CurrentBlock"
                                                 UserId="@CurrentUserId"
                                                 CourseId="Player.CourseId"
                                                 LessonId="Player.CurrentLesson!.LessonId"
                                                 OnCompleted="OnBlockAutoCompleted" />
                                break;

                            case LessonBlockType.Assessment:
                                <AssessmentBlockPlayer @key="_blockRenderKey"
                                                       Block="Player.CurrentBlock"
                                                       UserId="@CurrentUserId"
                                                       CourseId="Player.CourseId"
                                                       LessonId="Player.CurrentLesson!.LessonId"
                                                       OnCompleted="OnBlockAutoCompleted" />
                                break;

                            case LessonBlockType.Download:
                                @((MarkupString)(Player.CurrentBlock.ContentHtml ?? string.Empty))
                                @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.FileUrl))
                                {
                                    <div style="margin-top:0.75rem;"><a href="@Player.CurrentBlock.FileUrl" target="_blank" rel="noreferrer" class="e-btn">Download Attachment</a></div>
                                }
                                break;

                            default:
                                @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.ThumbnailUrl))
                                {
                                    <img src="@Player.CurrentBlock.ThumbnailUrl" alt="Visual" style="max-width:100%;border-radius:4px;margin-bottom:0.75rem;" />
                                }
                                @((MarkupString)(Player.CurrentBlock.ContentHtml ?? string.Empty))
                                break;
                        }
                    }
                </div>

                @* Navigation bar *@
                <div class="tp-nav-bar">
                    <button type="button" class="e-btn" disabled="@(!Player.CanGoPrevious)" @onclick="GoPrevious">
                        ‹ Previous
                    </button>

                    @* Manual complete for card/flashcard/download — show lock until ready *@
                    @if (NeedsManualNext())
                    {
                        var fcReady = Player.CurrentBlock?.BlockType != LessonBlockType.Flashcard
                                      || (_flashCardRef?.AllReviewed == true);
                        <button type="button"
                                class="e-btn e-primary @(!fcReady ? "tp-next-locked" : string.Empty)"
                                disabled="@(!fcReady)"
                                title="@(!fcReady ? "Review all cards to continue" : null)"
                                @onclick="ManualCompleteAndAdvanceAsync">
                            @if (!fcReady)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            }
                            Next →
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="e-btn e-primary @(!CanAdvance ? "tp-next-locked" : string.Empty)"
                                disabled="@(!CanAdvance)"
                                title="@(!CanAdvance ? "Complete the current content to continue" : null)"
                                @onclick="GoNext">
                            @if (!CanAdvance)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            }
                            Next →
                        </button>
                    }
                </div>
            </div>

            @* ── RIGHT: Lesson Progress ───────────────────────────── *@
            <LessonProgressPanel CurrentLesson="Player.CurrentLesson"
                                  CourseProgressPercent="Player.CourseProgressPercent" />

        </div>
    }
</div>

@code {
    [Parameter] public Guid CourseId { get; set; }

    [SupplyParameterFromQuery] public Guid? LessonId { get; set; }
    [SupplyParameterFromQuery] public Guid? BlockId { get; set; }

    private SfToast Toast = default!;
    private TrainingCoursePlayerModel? Player;
    private string? CurrentUserId;
    private string? ErrorMessage;
    private string _blockRenderKey = string.Empty;
    private FlashCardBlockPlayer? _flashCardRef;
    private bool _disposed;

    private bool CanAdvance =>
        Player is not null
        && Player.CurrentBlock is not null
        && Player.CurrentBlock.IsCompleted;

    private bool NeedsManualNext()
    {
        if (Player?.CurrentBlock is null) return false;
        var bt = Player.CurrentBlock.BlockType;
        return bt is LessonBlockType.Card
            or LessonBlockType.TextNarrative
            or LessonBlockType.Download
            or LessonBlockType.Flashcard;
    }

    protected override async Task OnParametersSetAsync()
    {
        CurrentUserId = (await AuthenticationStateProvider.GetAuthenticationStateAsync())
            .User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(CurrentUserId))
        {
            ErrorMessage = "A signed-in user profile is required to launch training.";
            return;
        }

        await LoadPlayerAsync();
    }

    private async Task LoadPlayerAsync()
    {
        Player = await LearnerTrainingService.GetCoursePlayerAsync(CurrentUserId!, CourseId, LessonId, BlockId);
        if (Player is null)
        {
            ErrorMessage = "This course could not be loaded or is not available.";
            return;
        }

        ErrorMessage = null;
        _blockRenderKey = Player.CurrentBlock is null
            ? $"empty-{CourseId}"
            : $"{Player.CurrentLessonId}-{Player.CurrentBlock.BlockId}-{Player.CurrentBlock.BlockType}";
    }

    private void NavigateToLesson(Guid lessonId)
    {
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(
            new Dictionary<string, object?> { [nameof(LessonId)] = lessonId, [nameof(BlockId)] = null }));
    }

    private void NavigateToBlock(Guid blockId)
    {
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(
            new Dictionary<string, object?> { [nameof(LessonId)] = Player?.CurrentLessonId, [nameof(BlockId)] = blockId }));
    }

    private void GoPrevious()
    {
        if (Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null) return;
        var idx = Player.CurrentLesson.Blocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId);
        if (idx > 0) NavigateToBlock(Player.CurrentLesson.Blocks[idx - 1].BlockId);
    }

    private void GoNext()
    {
        if (Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null) return;
        var blocks = Player.CurrentLesson.Blocks;
        var idx = blocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId);
        if (idx >= 0 && idx < blocks.Count - 1)
            NavigateToBlock(blocks[idx + 1].BlockId);
    }

    private async Task ManualCompleteAndAdvanceAsync()
    {
        if (Player?.CurrentLesson is null || Player.CurrentBlock is null) return;
        await LearnerTrainingService.CompleteBlockAsync(CurrentUserId!, Player.CourseId, Player.CurrentLesson.LessonId, Player.CurrentBlock.BlockId);
        await LoadPlayerAsync();
        GoNext();
    }

    private async Task OnBlockAutoCompleted()
    {
        if (_disposed) return;
        // Reload player state to refresh progress and NEXT unlock
        await LoadPlayerAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task OnVideoBlockAutoCompleted()
    {
        if (_disposed || Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null) return;

        var currentBlocks = Player.CurrentLesson.Blocks;
        var currentIndex = currentBlocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId);
        var nextBlockId = currentIndex >= 0 && currentIndex < currentBlocks.Count - 1
            ? currentBlocks[currentIndex + 1].BlockId
            : (Guid?)null;

        await LoadPlayerAsync();
        if (_disposed) return;

        if (nextBlockId.HasValue)
        {
            NavigateToBlock(nextBlockId.Value);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowToastAsync(string title, string content, string cssClass)
    {
        if (_disposed) return;
        await Toast.ShowAsync(new ToastModel
        {
            Title = title,
            Content = content,
            CssClass = cssClass,
            ShowCloseButton = true,
            Timeout = 3200
        });
    }

    public void Dispose()
    {
        _disposed = true;
    }
}
