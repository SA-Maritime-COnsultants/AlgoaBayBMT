@page "/my-training/course/{RegistrationId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using AlgoaBayBMT.Data
@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups

@implements IAsyncDisposable

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILearnerTrainingService LearnerTrainingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(Player?.Title ?? "Course Player")</PageTitle>

<SfToast @ref="Toast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top" />
</SfToast>

<SfDialog Width="460px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsResetDialogVisible" CssClass="tp-reset-dialog">
    <DialogTemplates>
        <Header>Reset Training</Header>
        <Content>This will reset your progress for this course and restart it from the beginning. Do you want to continue?</Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancel" OnClick="@(_ => IsResetDialogVisible = false)" />
        <DialogButton Content="Reset Training" IsPrimary="true" OnClick="@(_ => ConfirmResetTrainingAsync())" />
    </DialogButtons>
</SfDialog>

<div class="training-player-page">
    <div class="tp-shell @(IsPlayerFullscreen ? "course-player-fullscreen" : string.Empty)">
        @* ── Top hero ─────────────────────────────────────────────── *@
        <section class="tp-hero">
            <div class="tp-hero-main">
                <div class="tp-hero-topline">
                    <a href="/my-training" class="tp-back-btn">
                        <span aria-hidden="true">&#8592;</span>
                        <span>My Training</span>
                    </a>
                    @if (Player is not null)
                    {
                        <span class="e-badge tp-topbar-meta">@Player.Code</span>
                    }
                </div>

                <div class="tp-learner-tag">
                    <span class="tp-learner-label">My Training</span>
                    <span class="tp-learner-name">@(Player?.Title ?? "Course Player")</span>
                </div>

                @if (Player is not null)
                {
                    <div class="tp-hero-subtitle">
                        @(Player.CurrentLesson is null
                            ? "Continue your assigned learning content from a calmer, more focused course workspace."
                            : $"Current lesson: {Player.CurrentLesson.Title}")
                    </div>

                    <div class="tp-hero-badges">
                        <span class="e-badge pf-role-badge">@Player.CompletedLessons of @Player.TotalLessons lessons complete</span>
                        <span class="e-badge pf-role-badge">@FormatPercent(Player.CourseProgressPercent)% overall progress</span>
                        <span class="e-badge pf-role-badge">Pass mark @FormatPercent(Player.PassMarkPercent)%</span>
                    </div>
                }
            </div>

            <div class="tp-hero-side">
                <div class="tp-control-actions">
                    <button type="button" class="e-btn tp-control-btn" @onclick="ToggleFullscreenAsync" disabled="@(!IsFullscreenSupported)">
                        @if (IsPlayerFullscreen)
                        {
                            <span>Exit Fullscreen</span>
                        }
                        else
                        {
                            <span>Fullscreen</span>
                        }
                    </button>
                    <button type="button" class="e-btn tp-control-btn tp-control-btn--danger" @onclick="OpenResetDialog">
                        <span>Reset Training</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Player?.CertificateUrl))
                    {
                        <a href="@Player.CertificateUrl" class="e-btn e-primary tp-hero-action">View Certificate</a>
                    }
                </div>

                @if (Player is not null)
                {
                    <div class="tp-hero-progress-card">
                        <div class="tp-hero-progress-label">Course Progress</div>
                        <div class="tp-hero-progress-value">@FormatPercent(Player.CourseProgressPercent)%</div>
                        <div class="pf-training-linear-progress pf-training-linear-progress--course" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Player.CourseProgressPercent">
                            <div class="pf-training-linear-progress-fill" style="width:@($"{Player.CourseProgressPercent:0.##}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="pf-alert pf-alert--warning-strong" role="alert">@ErrorMessage</div>
        }

        @if (Player is null)
        {
            <div class="tp-loading-shell">
                <div class="pf-empty-state">Loading training player…</div>
            </div>
        }
        else
        {
            <div class="training-player-layout">

                @* ── LEFT: Course Journey ─────────────────────────────── *@
                <CourseJourneyPanel Modules="Player.Modules"
                                    CompletedLessons="Player.CompletedLessons"
                                    TotalLessons="Player.TotalLessons"
                                    OnLessonSelected="NavigateToLessonAsync" />

                @* ── CENTER: Player ───────────────────────────────────── *@
                <div class="training-panel tp-content-panel" id="@_fullscreenElementId" style="min-height:0;">
                    <div class="training-panel-header tp-panel-header-soft">
                        <div class="tp-panel-header-copy">
                            <div class="tp-panel-header-kicker">Course player</div>
                            <div class="tp-panel-header-title-row">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                <span>@(Player.CurrentLesson?.Title ?? Player.Title)</span>
                            </div>
                        </div>
                        @if (Player.CurrentBlock is not null)
                        {
                            <span class="tp-header-badge">@Player.CurrentBlock.DisplayType</span>
                        }
                    </div>

                    @* Current block content *@
                    <div class="training-panel-body tp-content-body">
                        @if (ShowCompletionSlide)
                        {
                            <div class="tp-completion-slide">
                                <div class="tp-completion-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="8 12.5 10.8 15.2 16.5 9.5"></polyline></svg>
                                </div>
                                <div class="tp-completion-kicker">Course complete</div>
                                <h2 class="tp-completion-title">CONGRATULATIONS @Player.LearnerName.ToUpperInvariant() YOU COMPLETED @Player.Title.ToUpperInvariant() SUCCESSFULLY</h2>
                                <p class="tp-completion-copy">Your training has been completed successfully. You can review the course content again from your My Training dashboard or open your certificate if one is available.</p>
                                <div class="tp-completion-actions">
                                    <a href="/my-training" class="e-btn">Back to My Training</a>
                                    @if (!string.IsNullOrWhiteSpace(Player.CertificateUrl))
                                    {
                                        <a href="@Player.CertificateUrl" class="e-btn e-primary">View Certificate</a>
                                    }
                                    @if (IsPlayerFullscreen)
                                    {
                                        <button type="button" class="e-btn tp-completion-exit-btn" @onclick="ExitFullscreenAsync">Exit</button>
                                    }
                                </div>
                            </div>
                        }
                        else if (Player.CurrentBlock is not null)
                        {
                            <div class="tp-block-stage">
                                @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.Title))
                                {
                                    <div class="tp-block-title">@Player.CurrentBlock.Title</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.Subtitle))
                                {
                                    <div class="tp-block-subtitle">@Player.CurrentBlock.Subtitle</div>
                                }

                                <div class="tp-block-content-card">
                                    @switch (Player.CurrentBlock.BlockType)
                                    {
                                        case LessonBlockType.Video:
                                            <VideoBlockPlayer @key="_blockRenderKey"
                                                              Block="Player.CurrentBlock"
                                                              UserId="@CurrentUserId"
                                                              CourseId="Player.CourseId"
                                                              LessonId="Player.CurrentLesson!.LessonId"
                                                              OnCompleted="OnVideoBlockAutoCompleted" />
                                            break;

                                        case LessonBlockType.TextNarrative:
                                            <CardBlockPlayer Block="Player.CurrentBlock" />
                                            break;

                                        case LessonBlockType.Card:
                                            <CardBlockPlayer Block="Player.CurrentBlock" />
                                            break;

                                        case LessonBlockType.Flashcard:
                                            <FlashCardBlockPlayer @ref="_flashCardRef"
                                                                 Block="Player.CurrentBlock"
                                                                 UserId="@CurrentUserId"
                                                                 CourseId="Player.CourseId"
                                                                 LessonId="Player.CurrentLesson!.LessonId"
                                                                 OnCompleted="OnBlockAutoCompleted" />
                                            break;

                                        case LessonBlockType.Quiz:
                                            <QuizBlockPlayer @key="_blockRenderKey"
                                                             Block="Player.CurrentBlock"
                                                             UserId="@CurrentUserId"
                                                             CourseId="Player.CourseId"
                                                             LessonId="Player.CurrentLesson!.LessonId"
                                                             OnCompleted="OnBlockAutoCompleted" />
                                            break;

                                        case LessonBlockType.Assessment:
                                            <AssessmentBlockPlayer @key="_blockRenderKey"
                                                                   Block="Player.CurrentBlock"
                                                                   UserId="@CurrentUserId"
                                                                   CourseId="Player.CourseId"
                                                                   LessonId="Player.CurrentLesson!.LessonId"
                                                                   OnCompleted="OnBlockAutoCompleted" />
                                            break;

                                        case LessonBlockType.Download:
                                            @((MarkupString)(Player.CurrentBlock.ContentHtml ?? string.Empty))
                                            @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.FileUrl))
                                            {
                                                <div style="margin-top:0.75rem;"><a href="@Player.CurrentBlock.FileUrl" target="_blank" rel="noreferrer" class="e-btn">Download Attachment</a></div>
                                            }
                                            break;

                                        default:
                                            @if (!string.IsNullOrWhiteSpace(Player.CurrentBlock.ThumbnailUrl))
                                            {
                                                <img src="@Player.CurrentBlock.ThumbnailUrl" alt="Visual" style="max-width:100%;border-radius:4px;margin-bottom:0.75rem;" />
                                            }
                                            @((MarkupString)(Player.CurrentBlock.ContentHtml ?? string.Empty))
                                            break;
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @* Navigation bar *@
                    @if (!ShowCompletionSlide)
                    {
                        <div class="tp-nav-bar">
                            <button type="button" class="e-btn" disabled="@(!Player.CanGoPrevious)" @onclick="GoPrevious">
                                ‹ Previous
                            </button>

                            <button type="button" class="e-btn tp-nav-fullscreen-btn" @onclick="ToggleFullscreenAsync" disabled="@(!IsFullscreenSupported)">
                                @if (IsPlayerFullscreen)
                                {
                                    <span>Exit Fullscreen</span>
                                }
                                else
                                {
                                    <span>Fullscreen</span>
                                }
                            </button>

                            <button type="button"
                                    class="e-btn e-primary @(CanFinishCourse ? "tp-finish-btn" : string.Empty) @(!CanExecutePrimaryAction ? "tp-next-locked" : string.Empty)"
                                    disabled="@(!CanExecutePrimaryAction)"
                                    title="@PrimaryActionTitle"
                                    @onclick="HandlePrimaryActionAsync">
                                @if (!CanExecutePrimaryAction)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                }
                                @PrimaryActionLabel
                            </button>
                        </div>
                    }
                </div>

                @* ── RIGHT: Lesson Progress ───────────────────────────── *@
                <LessonProgressPanel CurrentLesson="Player.CurrentLesson"
                                      CourseProgressPercent="Player.CourseProgressPercent" />

            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid RegistrationId { get; set; }

    [SupplyParameterFromQuery] public Guid? LessonId { get; set; }
    [SupplyParameterFromQuery] public Guid? BlockId { get; set; }

    private SfToast Toast = default!;
    private TrainingCoursePlayerModel? Player;
    private string? CurrentUserId;
    private string? ErrorMessage;
    private string _blockRenderKey = string.Empty;
    private readonly string _fullscreenElementId = $"course-player-panel-{Guid.NewGuid():N}";
    private FlashCardBlockPlayer? _flashCardRef;
    private IJSObjectReference? _fullscreenModule;
    private DotNetObjectReference<CoursePlayer>? _dotNetRef;
    private bool _disposed;
    private bool _fullscreenInteropInitialized;
    private bool IsPlayerFullscreen { get; set; }
    private bool IsFullscreenSupported { get; set; } = true;
    private bool IsResetDialogVisible { get; set; }
    private bool ShowCompletionSlide { get; set; }
    private Guid? ResolvedCourseId { get; set; }
    private bool IsRegistrationRoute { get; set; }

    private bool CanAdvance =>
        Player is not null
        && Player.CurrentBlock is not null
        && Player.CurrentBlock.IsCompleted;

    private Guid? _activeLessonId;
    private Guid? _activeBlockId;

    private bool IsManualAdvanceBlock =>
        Player?.CurrentBlock?.BlockType is LessonBlockType.Card
            or LessonBlockType.TextNarrative
            or LessonBlockType.Download
            or LessonBlockType.Flashcard;

    private bool IsFlashCardReady =>
        Player?.CurrentBlock?.BlockType != LessonBlockType.Flashcard
        || (_flashCardRef?.AllReviewed == true);

    private bool CanExecutePrimaryAction =>
        ShowCompletionSlide
            ? false
            : CanFinishCourse
                ? true
                : IsManualAdvanceBlock
                    ? IsFlashCardReady
                    : CanAdvance;

    private string PrimaryActionLabel => CanFinishCourse ? "FINISH" : "Next →";

    private string? PrimaryActionTitle => CanExecutePrimaryAction
        ? null
        : IsFlashCardReady
            ? "Complete the current content to continue"
            : "Review all cards to continue";

    private bool IsOnLastBlockInLesson =>
        Player?.CurrentLesson?.Blocks is { Count: > 0 }
        && Player.CurrentBlock is not null
        && Player.CurrentLesson.Blocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId) == Player.CurrentLesson.Blocks.Count - 1;

    private bool CanFinishCourse =>
        Player is not null
        && Player.CurrentBlock is not null
        && Player.CurrentBlock.IsCompleted
        && Player.CourseProgressPercent >= 100m
        && IsOnLastBlockInLesson
        && !TryGetNextLessonId(out _);

    private bool NeedsManualNext()
    {
        if (ShowCompletionSlide) return false;
        if (Player?.CurrentBlock is null) return false;
        var bt = Player.CurrentBlock.BlockType;
        return bt is LessonBlockType.Card
            or LessonBlockType.TextNarrative
            or LessonBlockType.Download
            or LessonBlockType.Flashcard;
    }

    private static string FormatPercent(decimal value) => value.ToString("0.#");

    protected override async Task OnParametersSetAsync()
    {
        CurrentUserId = (await AuthenticationStateProvider.GetAuthenticationStateAsync())
            .User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        _activeLessonId = LessonId;
        _activeBlockId = BlockId;
        ResolvedCourseId = null;
        IsRegistrationRoute = false;

        if (string.IsNullOrWhiteSpace(CurrentUserId))
        {
            ErrorMessage = "A signed-in user profile is required to launch training.";
            return;
        }

        await LoadPlayerAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _fullscreenInteropInitialized)
        {
            return;
        }

        _fullscreenModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/coursePlayerFullscreen.js");
        IsFullscreenSupported = await _fullscreenModule.InvokeAsync<bool>("isFullscreenSupported");
        _dotNetRef = DotNetObjectReference.Create(this);
        await _fullscreenModule.InvokeVoidAsync("registerFullscreenChange", _dotNetRef, _fullscreenElementId);
        _fullscreenInteropInitialized = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPlayerAsync()
    {
        ResolvedCourseId = await ResolveCourseIdAsync();
        if (!ResolvedCourseId.HasValue)
        {
            Player = null;
            ErrorMessage = "This training registration could not be loaded or is not available.";
            return;
        }

        Player = await LearnerTrainingService.GetCoursePlayerAsync(CurrentUserId!, ResolvedCourseId.Value, _activeLessonId, _activeBlockId);
        if (Player is null)
        {
            ErrorMessage = "This course could not be loaded or is not available.";
            return;
        }

        ErrorMessage = null;
        if (!ShowCompletionSlide)
        {
            _activeLessonId = Player.CurrentLessonId;
            _activeBlockId = Player.CurrentBlockId;
        }
        _blockRenderKey = Player.CurrentBlock is null
            ? $"empty-{RegistrationId}"
            : $"{Player.CurrentLessonId}-{Player.CurrentBlock.BlockId}-{Player.CurrentBlock.BlockType}";
    }

    private async Task<Guid?> ResolveCourseIdAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserId))
        {
            return null;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        var assignmentCourseId = await dbContext.UserTrainingAssignments
            .AsNoTracking()
            .Where(x => x.UserId == CurrentUserId && x.UserTrainingAssignmentId == RegistrationId)
            .Select(x => (Guid?)x.CourseId)
            .FirstOrDefaultAsync();

        if (assignmentCourseId.HasValue)
        {
            IsRegistrationRoute = true;
            return assignmentCourseId.Value;
        }

        return RegistrationId;
    }

    private async Task NavigateToLessonAsync(Guid lessonId)
    {
        if (_disposed) return;
        await ExitFullscreenForNavigationAsync();
        _activeLessonId = lessonId;
        _activeBlockId = null;
        ShowCompletionSlide = false;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(
            new Dictionary<string, object?> { [nameof(LessonId)] = lessonId, [nameof(BlockId)] = null }));
    }

    private async Task NavigateToBlockAsync(Guid blockId)
    {
        if (_disposed) return;
        await ExitFullscreenForNavigationAsync();
        _activeLessonId = Player?.CurrentLessonId;
        _activeBlockId = blockId;
        ShowCompletionSlide = false;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(
            new Dictionary<string, object?> { [nameof(LessonId)] = Player?.CurrentLessonId, [nameof(BlockId)] = blockId }));
    }

    private async Task GoPrevious()
    {
        if (Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null) return;
        var idx = Player.CurrentLesson.Blocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId);
        if (idx > 0) await NavigateToBlockAsync(Player.CurrentLesson.Blocks[idx - 1].BlockId);
    }

    private async Task GoNextAsync()
    {
        if (ShowCompletionSlide || Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null)
        {
            return;
        }

        if (CanFinishCourse)
        {
            await HandleCourseCompletionExperienceAsync();
            return;
        }

        if (TryGetNextBlockId(out var nextBlockId))
        {
            await NavigateToBlockAsync(nextBlockId);
            return;
        }

        if (TryGetNextLessonId(out var nextLessonId))
        {
            await NavigateToLessonAsync(nextLessonId);
            return;
        }
    }

    private async Task HandlePrimaryActionAsync()
    {
        if (!CanExecutePrimaryAction)
        {
            return;
        }

        if (CanFinishCourse)
        {
            await HandleCourseCompletionExperienceAsync();
            return;
        }

        if (IsManualAdvanceBlock)
        {
            await ManualCompleteAndAdvanceAsync();
            return;
        }

        await GoNextAsync();
    }

    private async Task ManualCompleteAndAdvanceAsync()
    {
        if (Player?.CurrentLesson is null || Player.CurrentBlock is null) return;
        var completedLessonId = Player.CurrentLesson.LessonId;
        var completedBlockId = Player.CurrentBlock.BlockId;
        await LearnerTrainingService.CompleteBlockAsync(CurrentUserId!, Player.CourseId, Player.CurrentLesson.LessonId, Player.CurrentBlock.BlockId);
        _activeLessonId = completedLessonId;
        _activeBlockId = completedBlockId;
        await LoadPlayerAsync();
        if (CanFinishCourse)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        await GoNextAsync();
    }

    private bool TryGetNextBlockId(out Guid nextBlockId)
    {
        nextBlockId = Guid.Empty;
        if (Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null)
        {
            return false;
        }

        var blocks = Player.CurrentLesson.Blocks;
        var idx = blocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId);
        if (idx >= 0 && idx < blocks.Count - 1)
        {
            nextBlockId = blocks[idx + 1].BlockId;
            return true;
        }

        return false;
    }

    private bool TryGetNextLessonId(out Guid nextLessonId)
    {
        nextLessonId = Guid.Empty;
        if (Player?.Modules is null || Player.CurrentLesson is null)
        {
            return false;
        }

        var flattenedLessons = Player.Modules
            .OrderBy(module => module.OrderIndex)
            .SelectMany(module => module.Lessons.OrderBy(lesson => lesson.OrderIndex))
            .ToList();

        var currentLessonIndex = flattenedLessons.FindIndex(lesson => lesson.LessonId == Player.CurrentLesson.LessonId);
        if (currentLessonIndex < 0)
        {
            return false;
        }

        var nextLesson = flattenedLessons
            .Skip(currentLessonIndex + 1)
            .FirstOrDefault(lesson => !lesson.IsLocked);

        if (nextLesson is null)
        {
            return false;
        }

        nextLessonId = nextLesson.LessonId;
        return true;
    }

    private void OpenResetDialog()
    {
        IsResetDialogVisible = true;
    }

    private async Task ConfirmResetTrainingAsync()
    {
        if (Player is null || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            IsResetDialogVisible = false;
            return;
        }

        var result = await LearnerTrainingService.ResetCourseProgressAsync(CurrentUserId, Player.CourseId);
        IsResetDialogVisible = false;
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        await LoadPlayerAsync();
        NavigationManager.NavigateTo($"/my-training/course/{RegistrationId}", forceLoad: false);
        await ShowToastAsync("Training reset", result.Message ?? "Training has been reset.", "e-toast-success");
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        if (_disposed || _fullscreenModule is null || !IsFullscreenSupported)
        {
            return;
        }

        await _fullscreenModule.InvokeAsync<bool>("toggleCoursePlayerFullscreen", _fullscreenElementId);
    }

    private async Task HandleCourseCompletionExperienceAsync()
    {
        if (_disposed || Player is null)
        {
            return;
        }

        await ExitFullscreenForNavigationAsync();
        ShowCompletionSlide = true;
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnBlockAutoCompleted()
    {
        if (_disposed) return;
        var completedLessonId = Player?.CurrentLesson?.LessonId;
        var completedBlockId = Player?.CurrentBlock?.BlockId;
        // Reload player state to refresh progress and NEXT unlock
        if (completedLessonId.HasValue)
        {
            _activeLessonId = completedLessonId.Value;
        }

        if (completedBlockId.HasValue)
        {
            _activeBlockId = completedBlockId.Value;
        }

        await LoadPlayerAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task OnVideoBlockAutoCompleted()
    {
        if (_disposed || Player?.CurrentLesson?.Blocks is null || Player.CurrentBlock is null) return;

        var completedLessonId = Player.CurrentLesson.LessonId;
        var completedBlockId = Player.CurrentBlock.BlockId;
        var currentBlocks = Player.CurrentLesson.Blocks;
        var currentIndex = currentBlocks.FindIndex(x => x.BlockId == Player.CurrentBlock.BlockId);
        var nextBlockId = currentIndex >= 0 && currentIndex < currentBlocks.Count - 1
            ? currentBlocks[currentIndex + 1].BlockId
            : (Guid?)null;

        _activeLessonId = completedLessonId;
        _activeBlockId = completedBlockId;
        await LoadPlayerAsync();
        if (_disposed) return;

        if (nextBlockId.HasValue)
        {
            await NavigateToBlockAsync(nextBlockId.Value);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExitFullscreenForNavigationAsync()
    {
        if (_disposed || _fullscreenModule is null || !IsPlayerFullscreen)
        {
            return;
        }

        try
        {
            await _fullscreenModule.InvokeAsync<bool>("exitCoursePlayerFullscreen", _fullscreenElementId);
        }
        catch
        {
        }
    }

    private async Task ExitFullscreenAsync()
    {
        if (_disposed || _fullscreenModule is null || !IsPlayerFullscreen)
        {
            return;
        }

        await _fullscreenModule.InvokeAsync<bool>("exitCoursePlayerFullscreen", _fullscreenElementId);
    }

    private async Task ShowToastAsync(string title, string content, string cssClass)
    {
        if (_disposed) return;
        await Toast.ShowAsync(new ToastModel
        {
            Title = title,
            Content = content,
            CssClass = cssClass,
            ShowCloseButton = true,
            Timeout = 3200
        });
    }

    [JSInvokable]
    public async Task OnFullscreenChanged(bool isFullscreen)
    {
        if (_disposed)
        {
            return;
        }

        IsPlayerFullscreen = isFullscreen;
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_fullscreenModule is not null)
        {
            try
            {
                if (IsPlayerFullscreen)
                {
                    await _fullscreenModule.InvokeAsync<bool>("exitCoursePlayerFullscreen", _fullscreenElementId);
                }
                await _fullscreenModule.InvokeVoidAsync("unregisterFullscreenChange", _fullscreenElementId);
                await _fullscreenModule.DisposeAsync();
            }
            catch
            {
            }
        }

        _dotNetRef?.Dispose();
    }
}
