@page "/crewing/crew"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOrCompanyManager)]

@inject ICrewService CrewService
@inject IOperatorService OperatorService
@inject ICrewComplianceWorkflowService ComplianceWorkflowService
@inject IUserManagementService UserMgmtService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager NavigationManager
@using AlgoaBayBMT.Shared.Security

<PageTitle>Crew Register</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Crew Register</h1>
            <div class="page-subtitle">Master record of seafarers, their identity documents and rank.</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <SfButton CssClass="pf-training-page-action-btn crew-action-btn-green" IconCss="e-icons e-people" IconPosition="IconPosition.Left" OnClick="OpenCreateDialog">Create Crew Member</SfButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Crew Members" SubTitle="Click a row to manage documents and assignments." />
        <CardContent>
            <div class="crew-filter-row">
                <div class="crew-filter-field">
                    <label class="pf-field-label">Compliance Filter</label>
                    <SfDropDownList TValue="string" TItem="ComplianceFilterOption"
                                    DataSource="@ComplianceFilterOptions"
                                    @bind-Value="_complianceFilterKey"
                                    Placeholder="All crew"
                                    PopupHeight="220px">
                        <DropDownListFieldSettings Value="Key" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="crew-filter-action">
                    <SfButton CssClass="pf-training-page-action-btn crew-action-btn-teal"
                              IconCss="e-icons e-search"
                              IconPosition="IconPosition.Left"
                              OnClick="ApplyComplianceFilter">Search</SfButton>
                    <SfButton CssClass="pf-training-page-action-btn"
                              IconCss="e-icons e-close"
                              IconPosition="IconPosition.Left"
                              OnClick="ClearComplianceFilter">Clear</SfButton>
                </div>
            </div>
            <div class="pf-training-responsive-grid">
            <SfGrid DataSource="@FilteredItems" TValue="CrewMember" AllowPaging="true" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact pf-courses-grid">
                <GridPageSettings PageSize="15" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn HeaderText="Name" Width="220">
                        <Template>
                            @{ var c = context as CrewMember; }
                            <strong>@c?.LastName, @c?.FirstName</strong>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Rank" Width="180"><Template>@((context as CrewMember)?.Rank?.GetDisplayName())</Template></GridColumn>
                    <GridColumn Field="@nameof(CrewMember.Nationality)" HeaderText="Nationality" Width="140" />
                    <GridColumn Field="@nameof(CrewMember.SidNumber)" HeaderText="SID" Width="120" />
                    <GridColumn HeaderText="Employer" Width="200"><Template>@((context as CrewMember)?.EmployerOperator?.Name ?? (context as CrewMember)?.EmployerName)</Template></GridColumn>
                    <GridColumn Field="@nameof(CrewMember.Email)" HeaderText="Email" Width="220" />
                    <GridColumn HeaderText="Active" Width="100" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var c = context as CrewMember; }
                            <span class="crew-status-badge @(c?.IsActive == true ? "crew-badge-green" : "crew-badge-red")">@(c?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Login" Width="90" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var c = context as CrewMember; }
                            @if (!string.IsNullOrWhiteSpace(c?.ApplicationUserId))
                            {
                                <span class="crew-status-badge crew-badge-green" title="Identity account linked">Linked</span>
                            }
                            else
                            {
                                <span class="crew-status-badge crew-badge-blue-gray" title="No Identity account">—</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Bunker Mgr" Width="120" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var c = context as CrewMember; }
                            @if (c?.ApplicationUserId is not null && _bunkerManagerMap.TryGetValue(c.ApplicationUserId, out var isBunkerManager))
                            {
                                <SfSwitch TChecked="bool" Checked="@isBunkerManager" ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> e) => ToggleBunkerManagerAsync(c.ApplicationUserId, e.Checked))" />
                            }
                            else
                            {
                                <span class="crew-status-badge crew-badge-blue-gray">—</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Compliance" Width="160" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var c = context as CrewMember; }
                            @if (c is not null && ComplianceStatuses.TryGetValue(c.Id, out var cs))
                            {
                                <a href="/crewing/crew/@c.Id" style="text-decoration:none;">
                                    <span class="crew-status-badge @ComplianceBadgeCssNew(cs)">@ComplianceStatusText(cs)</span>
                                </a>
                            }
                            else
                            {
                                <span class="crew-status-badge crew-badge-blue-gray">—</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="170" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var c = context as CrewMember; }
                            @if (c is not null)
                            {
                                <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                    <span class="pf-icon-action" title="Edit"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-edit" OnClick="@(() => OpenEditDialog(c))" /></span>
                                    <span class="pf-icon-action" title="Documents"><SfButton CssClass="e-flat pf-btn-details pf-btn-icon pf-btn-square abmt-grid-action-builder" IconCss="e-icons e-folder" OnClick="@(() => NavigationManager.NavigateTo($"/crewing/crew/{c.Id}"))" /></span>
                                    <span class="pf-icon-action" title="Soft Delete"><SfButton CssClass="e-flat pf-btn-delete pf-btn-icon pf-btn-square" IconCss="e-icons e-trash" OnClick="@(() => DeleteAsync(c.Id))" /></span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            </div>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="1100px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDialogVisible">
    <DialogTemplates>
        <Header>@(EditModel.Id == 0 ? "Create Crew Member" : "Edit Crew Member")</Header>
        <Content>
            <EditForm Model="EditModel" OnValidSubmit="SaveAsync" FormName="crew-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="pf-form-grid">
                    <div class="pf-col-4"><label class="pf-field-label">First Name</label><SfTextBox @bind-Value="EditModel.FirstName" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Middle Names</label><SfTextBox @bind-Value="EditModel.MiddleNames" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Last Name</label><SfTextBox @bind-Value="EditModel.LastName" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Date of Birth</label><SfDatePicker TValue="DateTime?" @bind-Value="EditModel.DateOfBirth" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Nationality</label><SfTextBox @bind-Value="EditModel.Nationality" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Gender</label><SfTextBox @bind-Value="EditModel.Gender" /></div>

                    <div class="pf-col-4">
                        <label class="pf-field-label">Rank</label>
                        <SfDropDownList TValue="CrewRank?" TItem="CrewRankOption" DataSource="@RankOptions" @bind-Value="EditModel.Rank" Placeholder="Select rank">
                            <DropDownListFieldSettings Value="Value" Text="Text" />
                        </SfDropDownList>
                    </div>
                    <div class="pf-col-4">
                        <label class="pf-field-label">Employer Operator</label>
                        <SfDropDownList TValue="int?" TItem="BunkerOperator" DataSource="@Operators" @bind-Value="EditModel.EmployerOperatorId" Placeholder="Select operator">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                    </div>
                    <div class="pf-col-4"><label class="pf-field-label">Employer (Other)</label><SfTextBox @bind-Value="EditModel.EmployerName" /></div>

                    <div class="pf-col-4"><label class="pf-field-label">Passport Number</label><SfTextBox @bind-Value="EditModel.PassportNumber" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Passport Country</label><SfTextBox @bind-Value="EditModel.PassportIssuingCountry" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Passport Expiry</label><SfDatePicker TValue="DateTime?" @bind-Value="EditModel.PassportExpiryDate" /></div>

                    <div class="pf-col-4"><label class="pf-field-label">SID Number</label><SfTextBox @bind-Value="EditModel.SidNumber" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">SID Authority</label><SfTextBox @bind-Value="EditModel.SidIssuingAuthority" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">SID Expiry</label><SfDatePicker TValue="DateTime?" @bind-Value="EditModel.SidExpiryDate" /></div>

                    <div class="pf-col-6"><label class="pf-field-label">Email</label><SfTextBox @bind-Value="EditModel.Email" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Phone</label><SfTextBox @bind-Value="EditModel.Phone" /></div>

                    <div class="pf-col-6"><label class="pf-field-label">Emergency Contact Name</label><SfTextBox @bind-Value="EditModel.EmergencyContactName" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Emergency Contact Phone</label><SfTextBox @bind-Value="EditModel.EmergencyContactNumber" /></div>

                    <div class="pf-col-12"><label class="pf-field-label">Address</label><SfTextBox @bind-Value="EditModel.PhysicalAddress" /></div>
                    <div class="pf-col-6"><SfCheckBox @bind-Checked="EditModel.IsActive" Label="Active" /></div>
                </div>
                <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="CloseDialog">Cancel</SfButton>
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save Crew Member</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private List<CrewMember> Items { get; set; } = [];
    private List<CrewMember> FilteredItems { get; set; } = [];
    private List<BunkerOperator> Operators { get; set; } = [];
    private List<CrewRankOption> RankOptions { get; set; } = [];
    private CrewMember EditModel { get; set; } = new();
    private Dictionary<int, CrewComplianceOverallStatus> ComplianceStatuses { get; set; } = [];
    private Dictionary<string, bool> _bunkerManagerMap = [];
    private CrewComplianceOverallStatus? ComplianceFilter { get; set; }
    private string _complianceFilterKey = "";

    // ── Compliance filter dropdown options ──────────────────────────
    public record ComplianceFilterOption(string Key, string Label);
    private static readonly List<ComplianceFilterOption> ComplianceFilterOptions =
    [
        new("", "All Crew"),
        new("Compliant", "✅ Compliant"),
        new("NonCompliant", "⚠️ Non-Compliant"),
        new("Expired", "🔴 Expired"),
        new("Unknown", "❓ Unknown")
    ];
    private bool IsDialogVisible { get; set; }
    private string? Message { get; set; }
    private bool IsError { get; set; }

    // Company-scoping: null means Admin (see all)
    private int? _scopedCompanyId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        RankOptions = CrewRankExtensions.All.ToList();
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole(RoleNames.Admin);
        if (!_isAdmin)
        {
            // Company Managers are scoped to their own CompanyId stored on the user record.
            // We resolve it via the OperatorService by matching the claim subject.
            var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
            {
                var allOperators = await OperatorService.GetAllAsync();
                Operators = allOperators.Where(x => x.IsActive).ToList();
                // Resolve the user's CompanyId from the DB via UserManagementService injected below
                var userModel = await UserMgmtService.GetUserEditorAsync(userId);
                _scopedCompanyId = userModel?.CompanyId;
            }
        }
        else
        {
            Operators = (await OperatorService.GetAllAsync()).Where(x => x.IsActive).ToList();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_isAdmin)
            Items = await CrewService.GetAllAsync();
        else if (_scopedCompanyId.HasValue)
            Items = await CrewService.GetByCompanyAsync(_scopedCompanyId.Value);
        else
            Items = [];

        var ids = Items.Select(x => x.Id);
        ComplianceStatuses = await ComplianceWorkflowService.GetCrewComplianceSummaryAsync(ids);
        await LoadBunkerManagerMapAsync();
        ApplyFilter();
    }

    private async Task LoadBunkerManagerMapAsync()
    {
        var userIds = Items.Select(x => x.ApplicationUserId).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList();
        _bunkerManagerMap = [];
        foreach (var userId in userIds)
        {
            var user = await UserMgmtService.GetUserEditorAsync(userId!);
            if (user is not null)
            {
                _bunkerManagerMap[user.UserId!] = user.IsBunkerManager;
            }
        }
    }

    private async Task ToggleBunkerManagerAsync(string applicationUserId, bool isBunkerManager)
    {
        var result = await UserMgmtService.SetBunkerManagerAsync(applicationUserId, isBunkerManager);
        if (result.Succeeded)
        {
            _bunkerManagerMap[applicationUserId] = isBunkerManager;
            Message = isBunkerManager ? "Bunker Manager flag set." : "Bunker Manager flag cleared.";
            IsError = false;
        }
        else
        {
            Message = result.Message ?? "Could not update Bunker Manager flag.";
            IsError = true;
        }
    }

    private void ApplyComplianceFilter()
    {
        ComplianceFilter = _complianceFilterKey switch
        {
            "Compliant"    => CrewComplianceOverallStatus.FullyCompliant,
            "NonCompliant" => CrewComplianceOverallStatus.PendingTraining,
            "Expired"      => CrewComplianceOverallStatus.Expired,
            "Unknown"      => CrewComplianceOverallStatus.Unknown,
            _              => null
        };
        ApplyFilter();
    }

    private void ClearComplianceFilter()
    {
        _complianceFilterKey = "";
        ComplianceFilter = null;
        ApplyFilter();
    }

    private void SetFilter(CrewComplianceOverallStatus? status)
    {
        ComplianceFilter = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        FilteredItems = ComplianceFilter is null
            ? Items
            : Items.Where(c => ComplianceStatuses.TryGetValue(c.Id, out var s) && s == ComplianceFilter).ToList();
    }

    private static string ComplianceBadgeCss(CrewComplianceOverallStatus s) => s switch
    {
        CrewComplianceOverallStatus.FullyCompliant => "bg-success",
        CrewComplianceOverallStatus.PendingTraining => "bg-warning text-dark",
        CrewComplianceOverallStatus.PendingApproval => "bg-warning text-dark",
        CrewComplianceOverallStatus.PendingPayment => "bg-warning text-dark",
        CrewComplianceOverallStatus.Expired => "bg-danger",
        _ => "bg-secondary"
    };

    private static string ComplianceBadgeCssNew(CrewComplianceOverallStatus s) => s switch
    {
        CrewComplianceOverallStatus.FullyCompliant => "crew-badge-green",
        CrewComplianceOverallStatus.PendingTraining => "crew-badge-red",
        CrewComplianceOverallStatus.PendingApproval => "crew-badge-orange",
        CrewComplianceOverallStatus.PendingPayment => "crew-badge-orange",
        CrewComplianceOverallStatus.Expired => "crew-badge-red",
        _ => "crew-badge-blue-gray"
    };

    private static string ComplianceStatusText(CrewComplianceOverallStatus s) => s switch
    {
        CrewComplianceOverallStatus.FullyCompliant => "Compliant",
        CrewComplianceOverallStatus.PendingTraining => "Non-Compliant",
        CrewComplianceOverallStatus.PendingApproval => "Pending Approval",
        CrewComplianceOverallStatus.PendingPayment => "Pending Payment",
        CrewComplianceOverallStatus.Expired => "Expired",
        _ => "Unknown"
    };

    private async Task<string?> CurrentUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void OpenCreateDialog()
    {
        Message = null;
        EditModel = new CrewMember { IsActive = true, EmployerOperatorId = _scopedCompanyId };
        IsDialogVisible = true;
    }

    private void OpenEditDialog(CrewMember c)
    {
        Message = null;
        EditModel = new CrewMember
        {
            Id = c.Id,
            ApplicationUserId = c.ApplicationUserId,
            FirstName = c.FirstName,
            MiddleNames = c.MiddleNames,
            LastName = c.LastName,
            DateOfBirth = c.DateOfBirth,
            Nationality = c.Nationality,
            Gender = c.Gender,
            PassportNumber = c.PassportNumber,
            PassportIssuingCountry = c.PassportIssuingCountry,
            PassportExpiryDate = c.PassportExpiryDate,
            NationalIdNumber = c.NationalIdNumber,
            SidNumber = c.SidNumber,
            SidIssuingAuthority = c.SidIssuingAuthority,
            SidIssuingCountry = c.SidIssuingCountry,
            SidExpiryDate = c.SidExpiryDate,
            Rank = c.Rank,
            PrimaryQualification = c.PrimaryQualification,
            EmployerOperatorId = c.EmployerOperatorId,
            EmployerName = c.EmployerName,
            Email = c.Email,
            Phone = c.Phone,
            EmergencyContactName = c.EmergencyContactName,
            EmergencyContactNumber = c.EmergencyContactNumber,
            PhysicalAddress = c.PhysicalAddress,
            IsActive = c.IsActive
        };
        IsDialogVisible = true;
    }

    private void CloseDialog() => IsDialogVisible = false;

    private async Task SaveAsync()
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            if (EditModel.Id == 0)
            {
                var result = await CrewService.CreateWithIdentityAsync(EditModel, userId, NavigationManager.BaseUri);
                if (!result.Succeeded)
                {
                    Message = "Failed to provision crew member: " + string.Join(" ", result.Errors);
                    IsError = true;
                    return;
                }
                if (result.UserAlreadyExisted)
                    Message = $"Crew member saved and linked to existing login account ({EditModel.Email}).";
                else if (!result.EmailSent && result.GeneratedPassword is not null)
                    Message = $"Crew member saved. Login created. Email could not be sent — temporary password: {result.GeneratedPassword}";
                else
                    Message = "Crew member saved. Login account created and welcome email sent.";
            }
            else
            {
                await CrewService.UpdateAsync(EditModel, userId);
                Message = "Crew member saved.";
            }
            IsError = false;
            IsDialogVisible = false;
            await LoadAsync();
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            await CrewService.SoftDeleteAsync(id, userId);
            Message = "Crew member removed.";
            IsError = false;
            await LoadAsync();
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }
}
