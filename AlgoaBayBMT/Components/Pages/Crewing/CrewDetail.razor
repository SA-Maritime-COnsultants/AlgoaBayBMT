@page "/crewing/crew/{CrewId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CrewComplianceManagement)]

@inject ICrewService CrewService
@inject IComplianceService ComplianceService
@inject ICrewAssignmentService AssignmentService
@inject ICrewComplianceWorkflowService CrewComplianceWorkflowService
@inject IBillingService BillingService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager NavigationManager

<PageTitle>Crew Detail</PageTitle>

<div class="page-shell pf-training-admin-shell">
    @if (Crew is null)
    {
        <div class="pf-alert pf-alert--warning-strong">Crew member not found.</div>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1 class="page-title pf-training-heading">@Crew.LastName, @Crew.FirstName</h1>
                <div class="page-subtitle">@(Crew.Rank?.GetDisplayName() ?? "Unranked") · @(Crew.EmployerOperator?.Name ?? Crew.EmployerName ?? "No employer")</div>
            </div>
            <div class="pf-grid-actions pf-grid-actions--compact">
                <SfButton CssClass="pf-training-page-action-btn" IconCss="e-icons e-arrow-left" OnClick="@(() => NavigationManager.NavigateTo("/crewing/crew"))">Back</SfButton>
                <SfButton CssClass="pf-training-page-action-btn" IconCss="e-icons e-check-circled" OnClick="EvaluateAsync">Evaluate Compliance</SfButton>
                <SfButton CssClass="pf-training-page-action-btn pf-training-create-course-btn" IconCss="e-icons e-add" OnClick="OpenCreateDoc">Add Document</SfButton>
            </div>
        </div>

        @if (WorkflowDashboard is not null)
        {
            <SfCard CssClass="pf-card-shell abmt-panel-3d">
                <CardHeader Title="Compliance Overview" SubTitle="Training compliance, approval and payment status for this crew member." />
                <CardContent>
                    <div class="pf-form-grid">
                        <div class="pf-col-3">
                            <label class="pf-field-label">Overall Status</label>
                            <div><span class="ab-badge @OverallStatusBadge(WorkflowDashboard.OverallStatus)">@WorkflowDashboard.OverallStatusText</span></div>
                        </div>
                        <div class="pf-col-3">
                            <label class="pf-field-label">Required / Completed</label>
                            <div><strong>@WorkflowDashboard.CompletedCourseCount / @WorkflowDashboard.RequiredCourseCount</strong></div>
                        </div>
                        <div class="pf-col-3">
                            <label class="pf-field-label">Pending Approval</label>
                            <div><strong>@WorkflowDashboard.PendingApprovalCount</strong></div>
                        </div>
                        <div class="pf-col-3">
                            <label class="pf-field-label">Pending Payment</label>
                            <div><strong>@WorkflowDashboard.PendingPaymentCount</strong></div>
                        </div>
                        <div class="pf-col-12">
                            <label class="pf-field-label">Compliance Progress</label>
                            <div class="pf-progress-track">
                                <div class="pf-progress-fill" style="width:@WorkflowDashboard.CompliancePercent.ToString("0")%"></div>
                            </div>
                            <div class="pf-training-course-progress-label">@WorkflowDashboard.CompliancePercent.ToString("0")% compliant</div>
                        </div>
                        <div class="pf-col-12">
                            <div class="pf-status-message">@WorkflowDashboard.Summary</div>
                        </div>
                        @if (WorkflowDashboard.VesselIsNonCompliant)
                        {
                            <div class="pf-col-12">
                                <div class="pf-alert pf-alert--warning-strong">This crew member causes the vessel compliance posture to remain non-compliant until all mandatory training requirements are satisfied.</div>
                            </div>
                        }
                    </div>
                </CardContent>
            </SfCard>

            <SfCard CssClass="pf-card-shell abmt-panel-3d">
                <CardHeader Title="Mandatory Training" SubTitle="Role-driven mandatory courses and their live progress, approval and payment state." />
                <CardContent>
                    @if (WorkflowDashboard.Courses.Count == 0)
                    {
                        <div class="pf-empty-state">No mandatory training courses are currently mapped to this crew member.</div>
                    }
                    else
                    {
                        <div class="pf-training-responsive-grid">
                        <SfGrid DataSource="@WorkflowDashboard.Courses" TValue="CrewComplianceCourseItemModel" AllowPaging="true" AllowSorting="true" CssClass="pf-grid--compact pf-courses-grid">
                            <GridPageSettings PageSize="10" />
                            <GridColumns>
                                <GridColumn Width="70" TextAlign="TextAlign.Center">
                                    <HeaderTemplate>Select</HeaderTemplate>
                                    <Template>
                                        @{ var item = context as CrewComplianceCourseItemModel; }
                                        @if (item?.CanRegister == true)
                                        {
                                            <input type="checkbox"
                                                   checked="@SelectedCourseIds.Contains(item.CourseId)"
                                                   @onchange="@(args => ToggleSelectedCourse(item.CourseId, args.Value as bool? == true))" />
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Course" Width="260">
                                    <Template>
                                        @{ var item = context as CrewComplianceCourseItemModel; }
                                        <div>
                                            <strong>@item?.Title</strong>
                                            <div class="page-subtitle">@item?.Code</div>
                                        </div>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Status" Width="160">
                                    <Template>
                                        @{ var item = context as CrewComplianceCourseItemModel; }
                                        <span class="ab-badge @CourseStatusBadge(item)">@item?.StatusText</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Progress" Width="150">
                                    <Template>
                                        @{ var item = context as CrewComplianceCourseItemModel; }
                                        @((item?.ProgressPercent ?? 0m).ToString("0"))%
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Cost" Width="120" TextAlign="TextAlign.Right">
                                    <Template>@(((context as CrewComplianceCourseItemModel)?.Cost ?? 0m).ToString("N2"))</Template>
                                </GridColumn>
                                <GridColumn HeaderText="Invoice" Width="140">
                                    <Template>
                                        @{ var item = context as CrewComplianceCourseItemModel; }
                                        @if (item?.InvoiceId is int invoiceId)
                                        {
                                            <a href="@($"/billing/invoices/{invoiceId}")">#@invoiceId</a>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Due / Expiry" Width="180">
                                    <Template>
                                        @{ var item = context as CrewComplianceCourseItemModel; }
                                        @if (item?.ExpiresOnUtc is DateTime expiresOn)
                                        {
                                            <span>@expiresOn.ToString("dd MMM yyyy")</span>
                                        }
                                        else if (item?.DueDateUtc is DateTime dueDate)
                                        {
                                            <span>@dueDate.ToString("dd MMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                        </div>
                        @if (CanSubmitTrainingRegistration)
                        {
                            <div class="pf-grid-actions pf-grid-actions--compact" style="margin-top:12px;">
                                <SfButton CssClass="pf-training-page-action-btn pf-training-create-course-btn" IconCss="e-icons e-add" OnClick="OpenRegistrationDialog">Register for Training</SfButton>
                            </div>
                        }
                    }
                </CardContent>
            </SfCard>
        }

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
        }

        @if (LastResult is not null)
        {
            <SfCard CssClass="pf-card-shell abmt-panel-3d">
                <CardHeader Title="@($"Compliance: {LastResult.State}")" SubTitle="@($"Evaluated {LastResult.EvaluatedOnUtc:dd MMM yyyy - HH:mm} UTC")" />
                <CardContent>
                    <div>@LastResult.Summary</div>
                    @if (!string.IsNullOrWhiteSpace(LastResult.AssignedCourseIds) && Crew?.EmployerOperatorId is not null)
                    {
                        <div class="pf-grid-actions pf-grid-actions--compact" style="margin-top:12px;">
                            <SfButton CssClass="pf-training-page-action-btn pf-training-create-course-btn" IconCss="e-icons e-bill" OnClick="OpenInvoiceDialog">Generate Remediation Invoice</SfButton>
                            @if (LastResult.GeneratedInvoiceId is int invId)
                            {
                                <SfButton CssClass="pf-training-page-action-btn" IconCss="e-icons e-eye" OnClick="@(() => NavigationManager.NavigateTo($"/billing/invoices/{invId}"))">View Invoice #@invId</SfButton>
                            }
                        </div>
                    }
                </CardContent>
            </SfCard>
        }

        <SfCard CssClass="pf-card-shell abmt-panel-3d">
            <CardHeader Title="Documents" SubTitle="Identity, medical and competency documents." />
            <CardContent>
                <div class="pf-training-responsive-grid">
                <SfGrid DataSource="@Documents" TValue="CrewDocument" AllowPaging="true" AllowSorting="true" CssClass="pf-grid--compact pf-courses-grid">
                    <GridPageSettings PageSize="10" />
                    <GridColumns>
                        <GridColumn Field="@nameof(CrewDocument.DocumentType)" HeaderText="Type" Width="170" />
                        <GridColumn Field="@nameof(CrewDocument.Title)" HeaderText="Title" Width="220" />
                        <GridColumn Field="@nameof(CrewDocument.DocumentNumber)" HeaderText="Number" Width="160" />
                        <GridColumn Field="@nameof(CrewDocument.IssuingAuthority)" HeaderText="Authority" Width="180" />
                        <GridColumn HeaderText="Issued" Width="130"><Template>@FormatDate((context as CrewDocument)?.IssuedDate)</Template></GridColumn>
                        <GridColumn HeaderText="Expiry" Width="130"><Template>@FormatDate((context as CrewDocument)?.ExpiryDate)</Template></GridColumn>
                        <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center">
                            <Template>
                                @{ var d = context as CrewDocument; }
                                @if (d is not null)
                                {
                                    <div class="pf-grid-actions pf-grid-actions--compact">
                                        <span class="pf-icon-action" title="Edit"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-edit" OnClick="@(() => OpenEditDoc(d))" /></span>
                                        <span class="pf-icon-action" title="Delete"><SfButton CssClass="e-flat pf-btn-delete pf-btn-icon pf-btn-square" IconCss="e-icons e-trash" OnClick="@(() => DeleteDocAsync(d.Id))" /></span>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
                </div>
            </CardContent>
        </SfCard>

        <SfCard CssClass="pf-card-shell abmt-panel-3d">
            <CardHeader Title="Assignment History" SubTitle="Sign-on / sign-off records." />
            <CardContent>
                <div class="pf-training-responsive-grid">
                <SfGrid DataSource="@Assignments" TValue="CrewAssignment" AllowPaging="true" AllowSorting="true" CssClass="pf-grid--compact pf-courses-grid">
                    <GridPageSettings PageSize="10" />
                    <GridColumns>
                        <GridColumn HeaderText="Vessel" Width="200"><Template>@((context as CrewAssignment)?.Vessel?.Name)</Template></GridColumn>
                        <GridColumn HeaderText="Rank" Width="180"><Template>@((context as CrewAssignment)?.RankOnAssignment.GetDisplayName())</Template></GridColumn>
                        <GridColumn HeaderText="Sign On" Width="170"><Template>@FormatUtc((context as CrewAssignment)?.SignOnDateUtc)</Template></GridColumn>
                        <GridColumn HeaderText="Sign Off" Width="170"><Template>@FormatUtc((context as CrewAssignment)?.SignOffDateUtc)</Template></GridColumn>
                        <GridColumn Field="@nameof(CrewAssignment.Status)" HeaderText="Status" Width="120" />
                    </GridColumns>
                </SfGrid>
                </div>
            </CardContent>
        </SfCard>
    }
</div>

<SfDialog Width="900px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDocDialogVisible">
    <DialogTemplates>
        <Header>@(DocModel.Id == 0 ? "Add Document" : "Edit Document")</Header>
        <Content>
            <EditForm Model="DocModel" OnValidSubmit="SaveDocAsync" FormName="crewdoc-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="pf-form-grid">
                    <div class="pf-col-6">
                        <label class="pf-field-label">Type</label>
                        <SfDropDownList TValue="CrewDocumentType" TItem="EnumOption<CrewDocumentType>" DataSource="@DocTypes" @bind-Value="DocModel.DocumentType">
                            <DropDownListFieldSettings Value="Value" Text="DisplayName" />
                        </SfDropDownList>
                    </div>
                    <div class="pf-col-6"><label class="pf-field-label">Title</label><SfTextBox @bind-Value="DocModel.Title" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Document Number</label><SfTextBox @bind-Value="DocModel.DocumentNumber" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Issuing Authority</label><SfTextBox @bind-Value="DocModel.IssuingAuthority" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Country</label><SfTextBox @bind-Value="DocModel.IssuingCountry" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Issued Date</label><SfDatePicker TValue="DateTime?" @bind-Value="DocModel.IssuedDate" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Expiry Date</label><SfDatePicker TValue="DateTime?" @bind-Value="DocModel.ExpiryDate" /></div>
                    <div class="pf-col-12"><label class="pf-field-label">Storage URL</label><SfTextBox @bind-Value="DocModel.StorageUrl" /></div>
                    <div class="pf-col-12"><label class="pf-field-label">Notes</label><SfTextBox @bind-Value="DocModel.Notes" Multiline="true" /></div>
                </div>
                <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="@(() => IsDocDialogVisible = false)">Cancel</SfButton>
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save Document</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog Width="520px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsInvoiceDialogVisible">
    <DialogTemplates>
        <Header>Generate Remediation Invoice</Header>
        <Content>
            <div class="pf-form-grid">
                <div class="pf-col-12">
                    <label class="pf-field-label">Unit Price per Course</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="RemediationUnitPrice" Min="0" Format="N2" />
                </div>
            </div>
            <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="@(() => IsInvoiceDialogVisible = false)">Cancel</SfButton>
                <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-bill" IconPosition="IconPosition.Left" OnClick="GenerateRemediationInvoiceAsync">Generate</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog Width="760px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsRegistrationDialogVisible">
    <DialogTemplates>
        <Header>Register For Training</Header>
        <Content>
            @if (WorkflowDashboard is not null)
            {
                <div class="pf-form-grid">
                    <div class="pf-col-12">
                        <div class="pf-status-message">Select one or more mandatory courses that still require registration approval.</div>
                    </div>
                    <div class="pf-col-12">
                        @foreach (var course in WorkflowDashboard.Courses.Where(x => x.CanRegister))
                        {
                            <div style="padding:0.45rem 0;border-bottom:1px solid rgba(15,53,80,0.08);display:flex;align-items:center;gap:0.75rem;">
                                <input type="checkbox"
                                       checked="@SelectedCourseIds.Contains(course.CourseId)"
                                       @onchange="@(args => ToggleSelectedCourse(course.CourseId, args.Value as bool? == true))" />
                                <span>@($"{course.Title} ({course.Code}) - {course.Cost:N2}")</span>
                            </div>
                        }
                    </div>
                    <div class="pf-col-6">
                        <label class="pf-field-label">Due Date</label>
                        <SfDatePicker TValue="DateTime?" @bind-Value="RegistrationDueDate" />
                    </div>
                    <div class="pf-col-12">
                        <label class="pf-field-label">Reason / Notes</label>
                        <SfTextBox @bind-Value="RegistrationReason" Multiline="true" />
                    </div>
                </div>
            }
            <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="@(() => IsRegistrationDialogVisible = false)">Cancel</SfButton>
                <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" OnClick="SubmitTrainingRegistrationAsync">Submit Registration</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public int CrewId { get; set; }

    private CrewMember? Crew;
    private List<CrewDocument> Documents { get; set; } = [];
    private List<CrewAssignment> Assignments { get; set; } = [];
    private ComplianceResult? LastResult;
    private CrewComplianceDashboardModel? WorkflowDashboard;
    private CrewDocument DocModel { get; set; } = new();
    private bool IsDocDialogVisible { get; set; }
    private string? Message;
    private bool IsError;
    private bool IsRegistrationDialogVisible { get; set; }
    private HashSet<Guid> SelectedCourseIds { get; set; } = [];
    private DateTime? RegistrationDueDate { get; set; }
    private string? RegistrationReason { get; set; }

    private List<EnumOption<CrewDocumentType>> DocTypes { get; } =
        Enum.GetValues<CrewDocumentType>().Select(t => new EnumOption<CrewDocumentType> { Value = t, DisplayName = t.ToString() }).ToList();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Crew = await CrewService.GetByIdAsync(CrewId);
        if (Crew is null) return;
        Documents = await CrewService.GetDocumentsAsync(CrewId);
        Assignments = await AssignmentService.GetByCrewMemberAsync(CrewId);
        WorkflowDashboard = await CrewComplianceWorkflowService.GetCrewDashboardAsync(CrewId);
        SelectedCourseIds.Clear();
    }

    private async Task<string?> CurrentUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void OpenCreateDoc()
    {
        DocModel = new CrewDocument { CrewMemberId = CrewId };
        IsDocDialogVisible = true;
    }

    private void OpenEditDoc(CrewDocument d)
    {
        DocModel = new CrewDocument
        {
            Id = d.Id,
            CrewMemberId = d.CrewMemberId,
            DocumentType = d.DocumentType,
            Title = d.Title,
            IssuingAuthority = d.IssuingAuthority,
            IssuingCountry = d.IssuingCountry,
            DocumentNumber = d.DocumentNumber,
            IssuedDate = d.IssuedDate,
            ExpiryDate = d.ExpiryDate,
            StorageUrl = d.StorageUrl,
            ContentType = d.ContentType,
            Notes = d.Notes
        };
        IsDocDialogVisible = true;
    }

    private async Task SaveDocAsync()
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            DocModel.CrewMemberId = CrewId;
            if (DocModel.Id == 0) await CrewService.AddDocumentAsync(DocModel, userId);
            else await CrewService.UpdateDocumentAsync(DocModel, userId);
            Message = "Document saved.";
            IsError = false;
            IsDocDialogVisible = false;
            await LoadAsync();
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private async Task DeleteDocAsync(int id)
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            await CrewService.SoftDeleteDocumentAsync(id, userId);
            await LoadAsync();
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private async Task EvaluateAsync()
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            LastResult = await ComplianceService.EvaluateCrewMemberAsync(CrewId, null, Crew?.Rank, userId);
            WorkflowDashboard = await CrewComplianceWorkflowService.GetCrewDashboardAsync(CrewId);
            Message = $"Compliance evaluated: {LastResult.State}.";
            IsError = LastResult.State != ComplianceState.Valid;
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private static string FormatDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy") : "—";
    private static string FormatUtc(DateTime? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy - HH:mm") : "—";

    private bool IsInvoiceDialogVisible { get; set; }
    private decimal RemediationUnitPrice { get; set; } = 1500m;

    private bool CanSubmitTrainingRegistration => WorkflowDashboard?.Courses.Any(x => x.CanRegister) == true;

    private void OpenInvoiceDialog() => IsInvoiceDialogVisible = true;

    private void OpenRegistrationDialog()
    {
        SelectedCourseIds = WorkflowDashboard?.Courses.Where(x => x.CanRegister).Select(x => x.CourseId).ToHashSet() ?? [];
        RegistrationDueDate = DateTime.UtcNow.Date.AddDays(30);
        RegistrationReason = $"Mandatory DFFE training registration for {Crew?.FirstName} {Crew?.LastName}".Trim();
        IsRegistrationDialogVisible = true;
    }

    private void ToggleSelectedCourse(Guid courseId, bool isChecked)
    {
        if (isChecked)
        {
            SelectedCourseIds.Add(courseId);
        }
        else
        {
            SelectedCourseIds.Remove(courseId);
        }
    }

    private async Task SubmitTrainingRegistrationAsync()
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            var result = await CrewComplianceWorkflowService.SubmitTrainingRegistrationAsync(
                new TrainingRegistrationSelectionModel
                {
                    CrewMemberId = CrewId,
                    CourseIds = SelectedCourseIds.ToList(),
                    DueDateUtc = RegistrationDueDate,
                    Reason = RegistrationReason
                },
                userId);

            if (!result.Succeeded)
            {
                Message = result.Message ?? string.Join(", ", result.Errors);
                IsError = true;
                return;
            }

            Message = result.Message ?? "Training registration submitted for approval.";
            IsError = false;
            IsRegistrationDialogVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
            IsError = true;
        }
    }

    private async Task GenerateRemediationInvoiceAsync()
    {
        try
        {
            if (Crew?.EmployerOperatorId is null || LastResult is null || string.IsNullOrWhiteSpace(LastResult.AssignedCourseIds))
            {
                Message = "No employer or assigned courses available for remediation invoicing.";
                IsError = true;
                return;
            }
            var courseIds = LastResult.AssignedCourseIds
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty)
                .Where(g => g != Guid.Empty)
                .Distinct()
                .ToList();
            if (courseIds.Count == 0) { Message = "No valid course IDs on the compliance result."; IsError = true; return; }

            var userId = await CurrentUserIdAsync();
            var inv = await BillingService.GenerateRemediationInvoiceAsync(
                Crew.EmployerOperatorId.Value, Crew.Id, null, courseIds, RemediationUnitPrice, userId);
            Message = $"Draft invoice #{inv.Id} created.";
            IsError = false;
            IsInvoiceDialogVisible = false;
            NavigationManager.NavigateTo($"/billing/invoices/{inv.Id}");
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private static string OverallStatusBadge(CrewComplianceOverallStatus status) => status switch
    {
        CrewComplianceOverallStatus.FullyCompliant => "ab-badge-active",
        CrewComplianceOverallStatus.PendingTraining => "ab-badge-warning",
        CrewComplianceOverallStatus.PendingApproval => "ab-badge-warning",
        CrewComplianceOverallStatus.PendingPayment => "ab-badge-warning",
        CrewComplianceOverallStatus.Expired => "ab-badge-inactive",
        _ => "ab-badge-inactive"
    };

    private static string CourseStatusBadge(CrewComplianceCourseItemModel? item)
    {
        if (item is null)
        {
            return "ab-badge-inactive";
        }

        if (item.IsExpired)
        {
            return "ab-badge-inactive";
        }

        return item.AssignmentStatus switch
        {
            AssignmentStatus.Completed => "ab-badge-active",
            AssignmentStatus.CompletedPendingPayment => "ab-badge-warning",
            AssignmentStatus.PendingApproval => "ab-badge-warning",
            AssignmentStatus.Started => "ab-badge-active",
            AssignmentStatus.Assigned => "ab-badge-warning",
            _ => "ab-badge-inactive"
        };
    }

    public class EnumOption<T> { public T Value { get; set; } = default!; public string DisplayName { get; set; } = ""; }
}
