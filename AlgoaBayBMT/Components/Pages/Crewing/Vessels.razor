@page "/crewing/vessels"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOrCompanyManager)]

@inject IVesselService VesselService
@inject IOperatorService OperatorService
@inject IUserManagementService UserMgmtService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager NavigationManager
@using AlgoaBayBMT.Shared.Security

<PageTitle>Vessels</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Vessels</h1>
            <div class="page-subtitle">Manage the fleet master register used by crewing and compliance.</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <SfButton CssClass="pf-training-page-action-btn pf-training-create-course-btn" IconCss="e-icons e-add" IconPosition="IconPosition.Left" OnClick="OpenCreateDialog">Create Vessel</SfButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Vessel Register" SubTitle="Active vessels and their owning operators." />
        <CardContent>
            <div class="pf-training-responsive-grid">
            <SfGrid DataSource="@Items" TValue="Vessel" AllowPaging="true" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact pf-courses-grid">
                <GridPageSettings PageSize="12" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn Field="@nameof(Vessel.Name)" HeaderText="Name" Width="200" />
                    <GridColumn Field="@nameof(Vessel.IMO)" HeaderText="IMO" Width="110" />
                    <GridColumn Field="@nameof(Vessel.MMSI)" HeaderText="MMSI" Width="110" />
                    <GridColumn Field="@nameof(Vessel.Flag)" HeaderText="Flag" Width="100" />
                    <GridColumn Field="@nameof(Vessel.VesselType)" HeaderText="Type" Width="140" />
                    <GridColumn HeaderText="Operator" Width="200"><Template>@((context as Vessel)?.OwningOperator?.Name)</Template></GridColumn>
                    <GridColumn HeaderText="Active" Width="100" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var v = context as Vessel; }
                            <span class="ab-badge @(v?.IsActive == true ? "ab-badge-active" : "ab-badge-inactive")">@(v?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="160" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var v = context as Vessel; }
                            @if (v is not null)
                            {
                                <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                    <span class="pf-icon-action" title="Edit Vessel"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-edit" OnClick="@(() => OpenEditDialog(v))" /></span>
                                    <span class="pf-icon-action" title="Sign-On / Crew"><SfButton CssClass="e-flat pf-btn-details pf-btn-icon pf-btn-square abmt-grid-action-builder" IconCss="e-icons e-people" OnClick="@(() => NavigationManager.NavigateTo($"/crewing/sign-on?vesselId={v.Id}"))" /></span>
                                    <span class="pf-icon-action" title="Soft Delete"><SfButton CssClass="e-flat pf-btn-delete pf-btn-icon pf-btn-square" IconCss="e-icons e-trash" OnClick="@(() => DeleteAsync(v.Id))" /></span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            </div>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="980px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDialogVisible">
    <DialogTemplates>
        <Header>@(EditModel.Id == 0 ? "Create Vessel" : "Edit Vessel")</Header>
        <Content>
            <EditForm Model="EditModel" OnValidSubmit="SaveAsync" FormName="vessel-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="pf-form-grid">
                    <div class="pf-col-6"><label class="pf-field-label">Name</label><SfTextBox @bind-Value="EditModel.Name" /></div>
                    <div class="pf-col-6">
                        <label class="pf-field-label">Owning Operator</label>
                        <SfDropDownList TValue="int?" TItem="BunkerOperator" DataSource="@Operators" @bind-Value="EditModel.OwningOperatorId" Placeholder="Select operator">
                            <DropDownListFieldSettings Value="Id" Text="Name" />
                        </SfDropDownList>
                    </div>
                    <div class="pf-col-4"><label class="pf-field-label">IMO</label><SfTextBox @bind-Value="EditModel.IMO" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">MMSI</label><SfTextBox @bind-Value="EditModel.MMSI" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Call Sign</label><SfTextBox @bind-Value="EditModel.CallSign" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Flag</label><SfTextBox @bind-Value="EditModel.Flag" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Vessel Type</label><SfTextBox @bind-Value="EditModel.VesselType" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Gross Tonnage</label><SfNumericTextBox TValue="double?" @bind-Value="EditModel.GrossTonnage" /></div>
                    <div class="pf-col-4"><label class="pf-field-label">Length Overall (m)</label><SfNumericTextBox TValue="double?" @bind-Value="EditModel.LengthOverall" /></div>
                    <div class="pf-col-6"><SfCheckBox @bind-Checked="EditModel.IsActive" Label="Active" /></div>
                </div>
                <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="CloseDialog">Cancel</SfButton>
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save Vessel</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private List<Vessel> Items { get; set; } = [];
    private List<BunkerOperator> Operators { get; set; } = [];
    private Vessel EditModel { get; set; } = new();
    private bool IsDialogVisible { get; set; }
    private string? Message { get; set; }
    private bool IsError { get; set; }

    private int? _scopedCompanyId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole(RoleNames.Admin);
        if (!_isAdmin)
        {
            var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
            {
                var userModel = await UserMgmtService.GetUserEditorAsync(userId);
                _scopedCompanyId = userModel?.CompanyId;
            }
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Operators = (await OperatorService.GetAllAsync()).Where(x => x.IsActive).ToList();
        if (_isAdmin)
            Items = await VesselService.GetAllAsync();
        else if (_scopedCompanyId.HasValue)
            Items = await VesselService.GetByCompanyAsync(_scopedCompanyId.Value);
        else
            Items = [];
    }

    private async Task<string?> CurrentUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private void OpenCreateDialog()
    {
        Message = null;
        EditModel = new Vessel { IsActive = true, OwningOperatorId = _scopedCompanyId };
        IsDialogVisible = true;
    }

    private void OpenEditDialog(Vessel v)
    {
        Message = null;
        EditModel = new Vessel
        {
            Id = v.Id,
            Name = v.Name,
            IMO = v.IMO,
            MMSI = v.MMSI,
            CallSign = v.CallSign,
            Flag = v.Flag,
            VesselType = v.VesselType,
            GrossTonnage = v.GrossTonnage,
            LengthOverall = v.LengthOverall,
            OwningOperatorId = v.OwningOperatorId,
            IsActive = v.IsActive
        };
        IsDialogVisible = true;
    }

    private void CloseDialog() => IsDialogVisible = false;

    private async Task SaveAsync()
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            if (EditModel.Id == 0)
                await VesselService.CreateAsync(EditModel, userId);
            else
                await VesselService.UpdateAsync(EditModel, userId);

            Message = "Vessel saved successfully.";
            IsError = false;
            IsDialogVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
            IsError = true;
        }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            await VesselService.SoftDeleteAsync(id, userId);
            Message = "Vessel removed.";
            IsError = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
            IsError = true;
        }
    }
}
