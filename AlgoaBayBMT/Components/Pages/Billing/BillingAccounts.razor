@page "/billing/accounts"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IOperatorService OperatorService
@inject IBillingService BillingService
@inject AuthenticationStateProvider AuthState

<PageTitle>Billing Accounts</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Billing Accounts</h1>
            <div class="page-subtitle">Maintain operator billing profiles used for invoicing.</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Operators" SubTitle="Click edit to maintain the operator's billing account." />
        <CardContent>
            <div class="pf-training-responsive-grid">
            <SfGrid DataSource="@Operators" TValue="BunkerOperator" AllowPaging="true" AllowSorting="true" AllowFiltering="true" CssClass="pf-grid--compact pf-courses-grid">
                <GridPageSettings PageSize="15" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn Field="@nameof(BunkerOperator.Name)" HeaderText="Operator" Width="240" />
                    <GridColumn Field="@nameof(BunkerOperator.ContactPerson)" HeaderText="Contact" Width="180" />
                    <GridColumn Field="@nameof(BunkerOperator.Email)" HeaderText="Email" Width="220" />
                    <GridColumn Field="@nameof(BunkerOperator.Phone)" HeaderText="Phone" Width="160" />
                    <GridColumn HeaderText="Active" Width="100" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var op = context as BunkerOperator; }
                            <span class="ab-badge @(op?.IsActive == true ? "ab-badge-active" : "ab-badge-inactive")">@(op?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="140" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var op = context as BunkerOperator; }
                            @if (op is not null)
                            {
                                <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                    <span class="pf-icon-action" title="Edit Billing Account"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-edit" OnClick="@(() => OpenDialogAsync(op))" /></span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            </div>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="820px" CssClass="abmt-dialog pf-course-create-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDialogVisible">
    <DialogTemplates>
        <Header>Billing Account – @SelectedOperator?.Name</Header>
        <Content>
            <EditForm Model="EditModel" OnValidSubmit="SaveAsync" FormName="billing-account-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="pf-form-grid">
                    <div class="pf-col-6"><label class="pf-field-label">Account Number</label><SfTextBox @bind-Value="EditModel.AccountNumber" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Currency</label><SfTextBox @bind-Value="EditModel.Currency" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Billing Contact</label><SfTextBox @bind-Value="EditModel.BillingContactName" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Payment Terms (days)</label><SfNumericTextBox TValue="int" @bind-Value="EditModel.PaymentTermsDays" Min="0" Max="180" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Billing Email</label><SfTextBox @bind-Value="EditModel.BillingEmail" /></div>
                    <div class="pf-col-6"><label class="pf-field-label">Billing Phone</label><SfTextBox @bind-Value="EditModel.BillingPhone" /></div>
                    <div class="pf-col-12"><label class="pf-field-label">Billing Address</label><SfTextBox Multiline="true" @bind-Value="EditModel.BillingAddress" /></div>
                    <div class="pf-col-6"><SfCheckBox @bind-Checked="EditModel.IsActive" Label="Active" /></div>
                </div>
                <div class="pf-dialog-actions pf-training-dialog-actions pf-course-create-dialog-actions">
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--cancel" IconCss="e-icons e-close" IconPosition="IconPosition.Left" type="button" OnClick="CloseDialog">Cancel</SfButton>
                    <SfButton CssClass="pf-course-create-dialog-btn pf-course-create-dialog-btn--save" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private List<BunkerOperator> Operators { get; set; } = [];
    private BunkerOperator? SelectedOperator { get; set; }
    private OperatorBillingAccount EditModel { get; set; } = new();
    private bool IsDialogVisible { get; set; }
    private string? Message;
    private bool IsError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Operators = await OperatorService.GetAllAsync();
    }

    private async Task<string?> CurrentUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private async Task OpenDialogAsync(BunkerOperator op)
    {
        SelectedOperator = op;
        var existing = await BillingService.GetAccountAsync(op.Id);
        EditModel = existing ?? new OperatorBillingAccount { BunkerOperatorId = op.Id };
        IsDialogVisible = true;
    }

    private void CloseDialog() => IsDialogVisible = false;

    private async Task SaveAsync()
    {
        try
        {
            var userId = await CurrentUserIdAsync();
            EditModel.BunkerOperatorId = SelectedOperator?.Id ?? EditModel.BunkerOperatorId;
            await BillingService.UpsertAccountAsync(EditModel, userId);
            Message = "Billing account saved.";
            IsError = false;
            IsDialogVisible = false;
        }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }
}
