@page "/billing/invoices"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IOperatorService OperatorService
@inject IBillingService BillingService
@inject NavigationManager NavigationManager

<PageTitle>Invoices</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Invoices</h1>
            <div class="page-subtitle">Operator invoices generated by compliance remediation and manual entry.</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Filter" />
        <CardContent>
            <div class="pf-form-grid">
                <div class="pf-col-6">
                    <label class="pf-field-label">Operator</label>
                    <SfDropDownList TValue="int?" TItem="BunkerOperator" DataSource="@Operators" @bind-Value="SelectedOperatorId" Placeholder="Select operator">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                        <DropDownListEvents TValue="int?" TItem="BunkerOperator" ValueChange="@(async _ => await LoadInvoicesAsync())" />
                    </SfDropDownList>
                </div>
            </div>
        </CardContent>
    </SfCard>

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Invoices" />
        <CardContent>
            <div class="pf-training-responsive-grid">
            <SfGrid DataSource="@InvoiceItems" TValue="Invoice" AllowPaging="true" AllowSorting="true" AllowFiltering="true" CssClass="pf-grid--compact pf-courses-grid">
                <GridPageSettings PageSize="15" />
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                <GridColumns>
                    <GridColumn Field="@nameof(Invoice.InvoiceNumber)" HeaderText="Number" Width="160" />
                    <GridColumn HeaderText="Date" Width="140"><Template>@FormatUtc((context as Invoice)?.InvoiceDateUtc)</Template></GridColumn>
                    <GridColumn HeaderText="Due" Width="140"><Template>@FormatUtc((context as Invoice)?.DueDateUtc)</Template></GridColumn>
                    <GridColumn Field="@nameof(Invoice.Currency)" HeaderText="Ccy" Width="80" />
                    <GridColumn HeaderText="Total" Width="120" TextAlign="TextAlign.Right"><Template>@(((context as Invoice)?.TotalAmount ?? 0m).ToString("N2"))</Template></GridColumn>
                    <GridColumn HeaderText="Status" Width="120">
                        <Template>
                            @{ var inv = context as Invoice; }
                            <span class="ab-badge @StatusBadge(inv?.Status)">@inv?.Status</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="220" TextAlign="TextAlign.Center">
                        <Template>
                            @{ var inv = context as Invoice; }
                            @if (inv is not null)
                            {
                                <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                    <span class="pf-icon-action" title="View"><SfButton CssClass="e-flat pf-btn-details pf-btn-icon pf-btn-square abmt-grid-action-builder" IconCss="e-icons e-eye" OnClick="@(() => NavigationManager.NavigateTo($"/billing/invoices/{inv.Id}"))" /></span>
                                    @if (inv.Status == InvoiceStatus.Draft)
                                    {
                                        <span class="pf-icon-action" title="Issue"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square" IconCss="e-icons e-send-2" OnClick="@(() => IssueAsync(inv.Id))" /></span>
                                    }
                                    @if (inv.Status == InvoiceStatus.Issued || inv.Status == InvoiceStatus.Overdue)
                                    {
                                        <span class="pf-icon-action" title="Mark Paid"><SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" IconCss="e-icons e-check" OnClick="@(() => MarkPaidAsync(inv.Id))" /></span>
                                    }
                                    @if (inv.Status != InvoiceStatus.Cancelled && inv.Status != InvoiceStatus.Paid)
                                    {
                                        <span class="pf-icon-action" title="Cancel"><SfButton CssClass="e-flat pf-btn-delete pf-btn-icon pf-btn-square" IconCss="e-icons e-close" OnClick="@(() => CancelAsync(inv.Id))" /></span>
                                    }
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            </div>
        </CardContent>
    </SfCard>
</div>

@code {
    private List<BunkerOperator> Operators { get; set; } = [];
    private List<Invoice> InvoiceItems { get; set; } = [];
    private int? SelectedOperatorId { get; set; }
    private string? Message;
    private bool IsError;

    protected override async Task OnInitializedAsync()
    {
        Operators = (await OperatorService.GetAllAsync()).Where(x => x.IsActive).ToList();
        SelectedOperatorId = Operators.FirstOrDefault()?.Id;
        await LoadInvoicesAsync();
    }

    private async Task LoadInvoicesAsync()
    {
        if (SelectedOperatorId is null) { InvoiceItems = []; return; }
        InvoiceItems = await BillingService.GetInvoicesForOperatorAsync(SelectedOperatorId.Value);
    }

    private async Task IssueAsync(int id)
    {
        try { await BillingService.IssueAsync(id, null); Message = "Invoice issued."; IsError = false; await LoadInvoicesAsync(); }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private async Task MarkPaidAsync(int id)
    {
        try { await BillingService.MarkPaidAsync(id, null); Message = "Invoice marked paid."; IsError = false; await LoadInvoicesAsync(); }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private async Task CancelAsync(int id)
    {
        try { await BillingService.CancelAsync(id, null); Message = "Invoice cancelled."; IsError = false; await LoadInvoicesAsync(); }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private static string FormatUtc(DateTime? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy") : "—";

    private static string StatusBadge(InvoiceStatus? s) => s switch
    {
        InvoiceStatus.Draft => "ab-badge-warning",
        InvoiceStatus.Issued => "ab-badge-active",
        InvoiceStatus.Paid => "ab-badge-active",
        InvoiceStatus.Overdue => "ab-badge-inactive",
        InvoiceStatus.Cancelled => "ab-badge-inactive",
        _ => ""
    };
}
