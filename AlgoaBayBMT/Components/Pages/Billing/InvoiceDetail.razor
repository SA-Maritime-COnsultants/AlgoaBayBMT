@page "/billing/invoices/{InvoiceId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IBillingService BillingService
@inject NavigationManager NavigationManager

<PageTitle>Invoice</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Invoice @Invoice?.InvoiceNumber</h1>
            <div class="page-subtitle">@Invoice?.BunkerOperator?.Name</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <SfButton CssClass="pf-training-page-action-btn" IconCss="e-icons e-arrow-left" OnClick="@(() => NavigationManager.NavigateTo("/billing/invoices"))">Back</SfButton>
            @if (Invoice?.Status == InvoiceStatus.Draft)
            {
                <SfButton CssClass="pf-training-page-action-btn pf-training-create-course-btn" IconCss="e-icons e-send-2" OnClick="IssueAsync">Issue</SfButton>
            }
            @if (Invoice?.Status == InvoiceStatus.Issued || Invoice?.Status == InvoiceStatus.Overdue)
            {
                <SfButton CssClass="pf-training-page-action-btn pf-training-create-course-btn" IconCss="e-icons e-check" OnClick="MarkPaidAsync">Mark Paid</SfButton>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="pf-alert @(IsError ? "pf-alert--warning-strong" : "pf-status-message")" role="alert">@Message</div>
    }

    @if (Invoice is not null)
    {
        <SfCard CssClass="pf-card-shell abmt-panel-3d">
            <CardHeader Title="Summary" />
            <CardContent>
                <div class="pf-form-grid">
                    <div class="pf-col-3"><label class="pf-field-label">Status</label><div><span class="ab-badge @StatusBadge(Invoice.Status)">@Invoice.Status</span></div></div>
                    <div class="pf-col-3"><label class="pf-field-label">Date</label><div>@Invoice.InvoiceDateUtc.ToString("dd MMM yyyy")</div></div>
                    <div class="pf-col-3"><label class="pf-field-label">Due</label><div>@(Invoice.DueDateUtc?.ToString("dd MMM yyyy") ?? "—")</div></div>
                    <div class="pf-col-3"><label class="pf-field-label">Currency</label><div>@Invoice.Currency</div></div>
                    @if (Invoice.CrewMember is not null)
                    {
                        <div class="pf-col-3"><label class="pf-field-label">Student</label><div>@($"{Invoice.CrewMember.FirstName} {Invoice.CrewMember.LastName}".Trim())</div></div>
                        @if (!string.IsNullOrWhiteSpace(Invoice.CrewMember.SidNumber))
                        {
                            <div class="pf-col-3"><label class="pf-field-label">Student No.</label><div>@Invoice.CrewMember.SidNumber</div></div>
                        }
                    }
                    <div class="pf-col-3"><label class="pf-field-label">Sub Total</label><div>@Invoice.SubTotal.ToString("N2")</div></div>
                    <div class="pf-col-3"><label class="pf-field-label">Tax</label><div>@Invoice.TaxAmount.ToString("N2")</div></div>
                    <div class="pf-col-3"><label class="pf-field-label">Total</label><div><strong>@Invoice.TotalAmount.ToString("N2")</strong></div></div>
                </div>
            </CardContent>
        </SfCard>

        <SfCard CssClass="pf-card-shell abmt-panel-3d">
            <CardHeader Title="Line Items" />
            <CardContent>
                <div class="pf-training-responsive-grid">
                <SfGrid DataSource="@Invoice.LineItems" TValue="InvoiceLineItem" AllowSorting="true" CssClass="pf-grid--compact pf-courses-grid">
                    <GridColumns>
                        <GridColumn Field="@nameof(InvoiceLineItem.Description)" HeaderText="Description" Width="320" />
                        <GridColumn Field="@nameof(InvoiceLineItem.Quantity)" HeaderText="Qty" Width="80" TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="@nameof(InvoiceLineItem.UnitPrice)" HeaderText="Unit" Width="120" TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="@nameof(InvoiceLineItem.LineTotal)" HeaderText="Total" Width="140" TextAlign="TextAlign.Right" Format="N2" />
                    </GridColumns>
                </SfGrid>
                </div>
            </CardContent>
        </SfCard>

        @if (!string.IsNullOrWhiteSpace(Invoice.Notes))
        {
            <SfCard CssClass="pf-card-shell abmt-panel-3d">
                <CardHeader Title="Notes" />
                <CardContent><pre class="pf-pre">@Invoice.Notes</pre></CardContent>
            </SfCard>
        }
    }
</div>

@code {
    [Parameter] public int InvoiceId { get; set; }

    private Invoice? Invoice;
    private string? Message;
    private bool IsError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Invoice = await BillingService.GetInvoiceAsync(InvoiceId);
    }

    private async Task IssueAsync()
    {
        try { await BillingService.IssueAsync(InvoiceId, null); Message = "Invoice issued."; IsError = false; await LoadAsync(); }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private async Task MarkPaidAsync()
    {
        try { await BillingService.MarkPaidAsync(InvoiceId, null); Message = "Invoice marked paid."; IsError = false; await LoadAsync(); }
        catch (Exception ex) { Message = ex.Message; IsError = true; }
    }

    private static string StatusBadge(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "ab-badge-warning",
        InvoiceStatus.Issued => "ab-badge-active",
        InvoiceStatus.Paid => "ab-badge-active",
        InvoiceStatus.Overdue => "ab-badge-inactive",
        InvoiceStatus.Cancelled => "ab-badge-inactive",
        _ => ""
    };
}
