@page "/crew/vessel-users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CrewListAccess)]

@using Syncfusion.Blazor.Notifications
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Security
@using System.Security.Claims

@inject ICrewAssignmentService CrewAssignmentService
@inject IVesselService VesselService
@inject IUserManagementService UserManagementService
@inject IApplicationEmailService EmailService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Vessel Users</PageTitle>

<SfToast @ref="SuccessToast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Vessel Users</h1>
            <div class="page-subtitle">View and manage user accounts for the active vessel.</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <SfCard CssClass="pf-status-message"><CardContent>@ErrorMessage</CardContent></SfCard>
    }

    <SfCard CssClass="pf-card-shell">
        <CardHeader Title="Vessel Selection" />
        <CardContent>
            @if (IsAdminOrManager)
            {
                <div class="pf-form-grid">
                    <div class="pf-col-4">
                        <label class="pf-field-label">Select Vessel</label>
                        <SfDropDownList TValue="int?" TItem="Vessel" DataSource="@VesselItems"
                                        @bind-Value="SelectedVesselId"
                                        Placeholder="Select a vessel"
                                        AllowFiltering="true">
                            <DropDownListFieldSettings Text="Name" Value="Id" />
                            <DropDownListEvents TValue="int?" TItem="Vessel" ValueChange="OnVesselChangedAsync" />
                        </SfDropDownList>
                    </div>
                </div>
            }

            @if (CurrentVessel is not null)
            {
                <dl class="pf-vessel-details">
                    <div class="pf-vessel-detail-row">
                        <dt class="pf-vessel-label">Assigned Vessel</dt>
                        <dd class="pf-vessel-value">@CurrentVessel.Name</dd>
                    </div>
                    <div class="pf-vessel-detail-row">
                        <dt class="pf-vessel-label">IMO</dt>
                        <dd class="pf-vessel-value">@CurrentVessel.ImoNumber</dd>
                    </div>
                    <div class="pf-vessel-detail-row">
                        <dt class="pf-vessel-label">Call Sign</dt>
                        <dd class="pf-vessel-value">@(CurrentVessel.CallSign ?? "-")</dd>
                    </div>
                    <div class="pf-vessel-detail-row">
                        <dt class="pf-vessel-label">Flag State</dt>
                        <dd class="pf-vessel-value">@(CurrentVessel.FlagState ?? "-")</dd>
                    </div>
                </dl>
            }
            else if (!IsAdminOrManager)
            {
                <div class="pf-empty-state">You do not have an active vessel assignment. Contact your administrator.</div>
            }
        </CardContent>
    </SfCard>

    @if (SelectedVesselId.HasValue && CrewUserList.Count > 0)
    {
        <SfCard CssClass="pf-card-shell">
            <CardHeader Title="Crew Accounts" SubTitle="@($"{CrewUserList.Count} active crew member(s) on this vessel")" />
            <CardContent>
                <SfGrid DataSource="@CrewUserList" TValue="ApplicationUser" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact" RowHeight="36">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                    <GridColumns>
                        <GridColumn HeaderText="Name" Width="200">
                            <Template>
                                @{ var u = context as ApplicationUser; }
                                <span>@(u?.FullName ?? u?.Email)</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ApplicationUser.Email)" HeaderText="Email" Width="220" />
                        <GridColumn HeaderText="Role" Width="160">
                            <Template>
                                @{ var u = context as ApplicationUser; }
                                @if (u is not null && UserRoles.TryGetValue(u.Id, out var roles))
                                {
                                    <div class="pf-role-badge-list">
                                        @foreach (var role in roles)
                                        {
                                            <span class="e-badge pf-role-badge">@role.Replace("_", " ")</span>
                                        }
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="Cell" Width="150">
                            <Template>
                                @{ var u = context as ApplicationUser; }
                                <span>@(u?.CellNo ?? "-")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="Approved" Width="110" TextAlign="TextAlign.Center">
                            <Template>
                                @{ var u = context as ApplicationUser; }
                                <span class="badge @(u?.IsAccountApproved == true ? "bg-success" : "bg-warning text-dark")">
                                    @(u?.IsAccountApproved == true ? "Yes" : "No")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="Actions" Width="110" TextAlign="TextAlign.Center">
                            <Template>
                                @{ var u = context as ApplicationUser; }
                                @if (u is not null)
                                {
                                    <div class="pf-grid-actions pf-grid-actions--compact pf-grid-actions--no-gap">
                                        <span class="pf-icon-action" title="Edit User">
                                            <SfButton CssClass="e-flat e-primary pf-btn-edit pf-btn-icon pf-btn-square"
                                                      OnClick="@(_ => OpenEditDialog(u))">
                                                <span class="e-icons e-edit" aria-hidden="true"></span>
                                                <span class="visually-hidden">Edit User</span>
                                            </SfButton>
                                        </span>
                                        <span class="pf-icon-action" title="Re-send Welcome Email">
                                            <SfButton CssClass="e-flat pf-btn-email pf-btn-icon pf-btn-square"
                                                      OnClick="@(_ => ResendWelcomeEmailAsync(u))">
                                                <span class="e-icons e-email" aria-hidden="true"></span>
                                                <span class="visually-hidden">Re-send Welcome Email</span>
                                            </SfButton>
                                        </span>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </CardContent>
        </SfCard>
    }
    else if (SelectedVesselId.HasValue)
    {
        <SfCard CssClass="pf-card-shell">
            <CardContent>
                <div class="pf-empty-state">No active crew members found for this vessel.</div>
            </CardContent>
        </SfCard>
    }
</div>

<!-- Edit User Dialog -->
<SfDialog Width="980px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsEditVisible">
    <DialogTemplates>
        <Header>Edit User</Header>
        <Content>
            @if (EditModel is not null)
            {
                <EditForm EditContext="@EditContext" FormName="vessel-user-edit-form">
                    <DataAnnotationsValidator />
                    <SfCard CssClass="pf-card-shell">
                        <CardContent>
                            <div class="pf-form-grid">
                                <div class="pf-col-4">
                                    <label class="pf-field-label">Full Name</label>
                                    <SfTextBox @bind-Value="EditModel.FullName" Placeholder="Full name" />
                                </div>
                                <div class="pf-col-4">
                                    <label class="pf-field-label">Email</label>
                                    <SfTextBox @bind-Value="EditModel.Email" Placeholder="Email" />
                                </div>
                                <div class="pf-col-4">
                                    <label class="pf-field-label">Cell No</label>
                                    <SfTextBox @bind-Value="EditModel.CellNo" Placeholder="Cell number" />
                                </div>
                                <div class="pf-col-6">
                                    <label class="pf-field-label">Address</label>
                                    <SfTextBox @bind-Value="EditModel.Address" Placeholder="Address" />
                                </div>
                                <div class="pf-col-6">
                                    <label class="pf-field-label">Country</label>
                                    <SfTextBox @bind-Value="EditModel.Country" Placeholder="Country" />
                                </div>
                            </div>
                        </CardContent>
                    </SfCard>
                </EditForm>
            }
            <div class="pf-dialog-actions">
                <SfButton OnClick="@(_ => IsEditVisible = false)">Cancel</SfButton>
                <SfButton CssClass="e-primary" OnClick="@(_ => SaveEditAsync())">Save</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private SfToast SuccessToast = default!;
    private List<Vessel> VesselItems = new();
    private List<ApplicationUser> CrewUserList = new();
    private Dictionary<string, IReadOnlyList<string>> UserRoles = new();
    private Vessel? CurrentVessel;
    private int? SelectedVesselId;
    private string? ErrorMessage;
    private string CurrentUserId = string.Empty;
    private bool IsAdminOrManager;
    private bool IsEditVisible;
    private UserAdministrationModel? EditModel;
    private EditContext EditContext = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        IsAdminOrManager = authState.User.IsInRole(RoleNames.Admin) || authState.User.IsInRole(RoleNames.CompanyManager);

        if (IsAdminOrManager)
        {
            VesselItems = await VesselService.GetVesselsAsync();
        }
        else
        {
            var vesselId = await CrewAssignmentService.GetCurrentVesselIdAsync(CurrentUserId);
            if (vesselId.HasValue)
            {
                SelectedVesselId = vesselId;
                CurrentVessel = await VesselService.GetVesselAsync(vesselId.Value);
                await LoadVesselUsersAsync();
            }
        }
    }

    private async Task OnVesselChangedAsync(Syncfusion.Blazor.DropDowns.ChangeEventArgs<int?, Vessel> args)
    {
        SelectedVesselId = args.Value;
        if (SelectedVesselId.HasValue)
        {
            CurrentVessel = await VesselService.GetVesselAsync(SelectedVesselId.Value);
            await LoadVesselUsersAsync();
        }
        else
        {
            CrewUserList.Clear();
            UserRoles.Clear();
            CurrentVessel = null;
        }
    }

    private async Task LoadVesselUsersAsync()
    {
        if (!SelectedVesselId.HasValue) return;

        var activeDeps = await CrewAssignmentService.GetActiveCrewAsync(SelectedVesselId.Value);
        var userIds = activeDeps.Select(x => x.UserId).Distinct().ToList();

        var allUsers = await UserManagementService.GetUsersAsync(null);
        CrewUserList = allUsers.Where(u => userIds.Contains(u.Id)).ToList();
        UserRoles = await UserManagementService.GetUserRolesBulkAsync(userIds);
    }

    private async Task OpenEditDialog(ApplicationUser user)
    {
        var model = await UserManagementService.GetUserEditorAsync(user.Id);
        if (model is null)
        {
            ErrorMessage = "User not found.";
            return;
        }
        EditModel = model;
        EditContext = new EditContext(EditModel);
        IsEditVisible = true;
    }

    private async Task SaveEditAsync()
    {
        if (EditModel is null) return;

        var result = await UserManagementService.UpdateUserAsync(EditModel);
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        ErrorMessage = null;
        IsEditVisible = false;
        await ShowSuccessToastAsync(result.Message ?? "User updated.");
        await LoadVesselUsersAsync();
    }

    private async Task ResendWelcomeEmailAsync(ApplicationUser user)
    {
        var result = await EmailService.SendWelcomeEmailWithResultAsync(user, NavigationManager.BaseUri);
        if (result.Succeeded)
        {
            await ShowSuccessToastAsync(result.Message ?? "Welcome email resent.");
            ErrorMessage = null;
        }
        else
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
        }
    }

    private async Task ShowSuccessToastAsync(string message) =>
        await SuccessToast.ShowAsync(new ToastModel
        {
            Title = "Success",
            Content = message,
            CssClass = "e-toast-success",
            ShowCloseButton = true,
            Timeout = 4000
        });
}
