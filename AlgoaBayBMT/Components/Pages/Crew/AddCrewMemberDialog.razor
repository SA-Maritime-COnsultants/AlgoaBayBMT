@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Models

@inject IUserManagementService UserManagementService

<SfDialog Width="960px" IsModal="true" ShowCloseIcon="true" @bind-Visible="Visible">
    <DialogTemplates>
        <Header>Add New Crew Member</Header>
        <Content>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="pf-alert pf-alert--warning-strong mb-3">@ErrorMessage</div>
            }

            <EditForm EditContext="@EditContext" FormName="add-crew-member-form">
                <DataAnnotationsValidator />

                <SfCard CssClass="pf-card-shell">
                    <CardContent>
                        <div class="pf-dialog-section-title">Account / Identity Details</div>
                        <div class="pf-form-grid">
                            <div class="pf-col-4">
                                <label class="pf-field-label">Email</label>
                                <SfTextBox @bind-Value="Model.Email" Placeholder="crewmember@example.com" />
                                <ValidationMessage For="() => Model.Email" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Full Name</label>
                                <SfTextBox @bind-Value="Model.FullName" Placeholder="Crew member full name" />
                                <ValidationMessage For="() => Model.FullName" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Qualification</label>
                                <SfDropDownList TValue="SeagoingCommercialQualification?" TItem="SeagoingCommercialQualificationOption" DataSource="@QualificationOptions" @bind-Value="Model.Qualification" Placeholder="Select qualification">
                                    <DropDownListFieldSettings Text="Text" Value="Value" />
                                </SfDropDownList>
                                <ValidationMessage For="() => Model.Qualification" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Cell Number</label>
                                <SfTextBox @bind-Value="Model.CellNo" Placeholder="+27821234567" />
                                <ValidationMessage For="() => Model.CellNo" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Nationality</label>
                                <SfTextBox @bind-Value="Model.Nationality" Placeholder="Nationality" />
                                <ValidationMessage For="() => Model.Nationality" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Gender</label>
                                <SfDropDownList TValue="string" TItem="string" DataSource="@GenderOptions" @bind-Value="Model.Gender" Placeholder="Select gender" />
                                <ValidationMessage For="() => Model.Gender" class="text-danger" />
                            </div>
                        </div>

                        <div class="pf-dialog-section-title mt-4">Seafarer / SID Details</div>
                        <div class="pf-form-grid">
                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Number</label>
                                <SfTextBox @bind-Value="Model.SidNumber" Placeholder="SID number" />
                                <ValidationMessage For="() => Model.SidNumber" class="text-danger" />
                            </div>
                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Issue Date</label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Model.SidIssueDate" Format="yyyy-MM-dd" />
                                <ValidationMessage For="() => Model.SidIssueDate" class="text-danger" />
                            </div>
                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Expiry Date</label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Model.SidExpiryDate" Format="yyyy-MM-dd" />
                                <ValidationMessage For="() => Model.SidExpiryDate" class="text-danger" />
                            </div>
                            <div class="pf-col-3">
                                <label class="pf-field-label">SID Issuing Authority</label>
                                <SfTextBox @bind-Value="Model.SidIssuingAuthority" Placeholder="Authority" />
                                <ValidationMessage For="() => Model.SidIssuingAuthority" class="text-danger" />
                            </div>
                        </div>

                        <div class="pf-dialog-section-title mt-4">Personal & Passport Details</div>
                        <div class="pf-form-grid">
                            <div class="pf-col-4">
                                <label class="pf-field-label">Date of Birth</label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Model.DateOfBirth" Format="yyyy-MM-dd" />
                                <ValidationMessage For="() => Model.DateOfBirth" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Passport Number</label>
                                <SfTextBox @bind-Value="Model.PassportNumber" Placeholder="Passport number" />
                                <ValidationMessage For="() => Model.PassportNumber" class="text-danger" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Passport Expiry</label>
                                <SfDatePicker TValue="DateTime?" @bind-Value="Model.PassportExpiry" Format="yyyy-MM-dd" />
                                <ValidationMessage For="() => Model.PassportExpiry" class="text-danger" />
                            </div>
                        </div>
                    </CardContent>
                </SfCard>
            </EditForm>

            <div class="pf-dialog-actions">
                <SfButton Disabled="@IsSaving" OnClick="@(_ => CloseAsync())">Cancel</SfButton>
                <SfButton CssClass="e-primary" IsPrimary="true" Disabled="@IsSaving" OnClick="@(_ => SaveAsync())">Save Crew Member</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private static readonly IReadOnlyList<string> GenderOptions = ["Male", "Female", "Other"];

    private AddCrewMemberViewModel Model = new();
    private EditContext EditContext = default!;
    private string? ErrorMessage;
    private bool IsSaving;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public int? CompanyId { get; set; }
    [Parameter] public int? VesselId { get; set; }
    [Parameter] public string ApprovedByUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback<ApplicationUser> CrewMemberCreated { get; set; }

    private IReadOnlyList<SeagoingCommercialQualificationOption> QualificationOptions => SeagoingCommercialQualificationExtensions.All;

    protected override void OnInitialized()
    {
        EditContext = new EditContext(Model);
    }

    private async Task SaveAsync()
    {
        if (!EditContext.Validate())
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;

        var result = await UserManagementService.CreateCrewMemberAsync(Model, CompanyId, VesselId, ApprovedByUserId);
        IsSaving = false;

        if (!result.Succeeded || result.Data is null)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        await CrewMemberCreated.InvokeAsync(result.Data);
        await ResetAndCloseAsync();
    }

    private Task CloseAsync() => ResetAndCloseAsync();

    private async Task ResetAndCloseAsync()
    {
        Model = new AddCrewMemberViewModel();
        EditContext = new EditContext(Model);
        ErrorMessage = null;
        await VisibleChanged.InvokeAsync(false);
    }
}
