@page "/training-management/courses"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Admin)]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Security
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups

@inject ITrainingManagementService TrainingManagementService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Training Courses</PageTitle>

<SfToast @ref="SuccessToast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Training Courses</h1>
            <div class="page-subtitle">Manage online training courses, configure pass marks and validity, and launch the live course builder preview workspace.</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <button class="btn btn-bmt btn-pastel-red" @onclick="PromptResetTrainingData">
                <i class="bi bi-arrow-counterclockwise me-2"></i>Reset Training Data
            </button>
            <button class="btn btn-bmt btn-pastel-green" @onclick="OpenCreateDialogAsync">
                <i class="bi bi-plus-circle-fill me-2"></i>Create Course
            </button>
        </div>
    </div>

    <SfDialog Width="720px" CssClass="abmt-dialog pf-training-reset-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="ShowResetConfirmation">
        <DialogTemplates>
            <Header>Training Reset</Header>
            <Content>
                <div class="pf-training-reset-dialog-content">
                    <p class="pf-training-reset-dialog-subtitle">Delete only training-related records so the training platform can be rebuilt cleanly.</p>
                    <div class="pf-alert pf-alert--warning-strong" role="alert">
                        This action removes training courses, modules, lessons, lesson blocks, assessments, question bank items, training progress, attempts, completions, certificates, training audit entries, and training-only uploaded media. Users, roles, vessels, crew assignments, and unrelated operational data remain unchanged.
                    </div>
                    <div class="pf-dialog-actions pf-dialog-actions--split pf-training-dialog-actions">
                        <button class="btn btn-bmt btn-pastel-gray" @onclick="CancelResetPrompt">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button class="btn btn-bmt btn-pastel-red" @onclick="ResetTrainingDataAsync">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Reset
                        </button>
                    </div>
                </div>
            </Content>
        </DialogTemplates>
    </SfDialog>

    <SfDialog Width="560px" CssClass="abmt-dialog pf-training-reset-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="ShowDeleteConfirmation">
        <DialogTemplates>
            <Header>Delete Course</Header>
            <Content>
                <div class="pf-training-reset-dialog-content">
                    <p class="pf-training-reset-dialog-subtitle">
                        Remove <strong>@(CourseToDelete?.Title)</strong> from the course list. The course and its history are retained in the database and can be restored later, but it will no longer appear here for editing.
                    </p>
                    <div class="pf-dialog-actions pf-dialog-actions--split pf-training-dialog-actions">
                        <button class="btn btn-bmt btn-pastel-gray" @onclick="CancelDeletePrompt">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button class="btn btn-bmt btn-pastel-red" @onclick="DeleteCourseAsync">
                            <i class="bi bi-trash-fill me-2"></i>Delete Course
                        </button>
                    </div>
                </div>
            </Content>
        </DialogTemplates>
    </SfDialog>

    <div class="pf-training-dashboard-grid pf-training-dashboard-grid--compact">
        <SfCard CssClass="pf-card-shell pf-training-metric-card">
            <CardContent>
                <div class="pf-training-metric-label">Active Courses</div>
                <div class="pf-training-metric-value">@CoursesData.Count(x => x.IsActive)</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="pf-card-shell pf-training-metric-card">
            <CardContent>
                <div class="pf-training-metric-label">Mandatory Courses</div>
                <div class="pf-training-metric-value">@CoursesData.Count(x => x.IsMandatory)</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="pf-card-shell pf-training-metric-card">
            <CardContent>
                <div class="pf-training-metric-label">Average Pass Mark</div>
                <div class="pf-training-metric-value">@(CoursesData.Count == 0 ? "0%" : $"{CoursesData.Average(x => x.PassMarkPercent):0.#}%")</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="pf-card-shell pf-training-metric-card">
            <CardContent>
                <div class="pf-training-metric-label">Question Pool Ready</div>
                <div class="pf-training-metric-value">@CoursesData.Count(x => x.LessonCount > 0)</div>
            </CardContent>
        </SfCard>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="pf-alert pf-alert--warning-strong" role="alert">@ErrorMessage</div>
    }

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardHeader Title="Courses" SubTitle="Authoring entry point for training management content." />
        <CardContent>
            @if (CoursesData.Count == 0)
            {
                <div class="pf-empty-state">No training courses have been created yet.</div>
            }
            else
            {
                <div class="pf-training-responsive-grid">
                    <SfGrid DataSource="@CoursesData" TValue="TrainingCourseListItemModel" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact pf-courses-grid">
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                        <GridColumns>
                            <GridColumn Field="@nameof(TrainingCourseListItemModel.Code)" HeaderText="Code" Width="130" />
                            <GridColumn HeaderText="Title" Width="260">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    @if (course is not null)
                                    {
                                        <a class="pf-training-panel-link" href="@($"/training-management/courses/{course.CourseId}/students")">@course.Title</a>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Current Version" Width="150">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@GetVersionText(course)</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Cost" Width="110" TextAlign="TextAlign.Right">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@((course?.Cost ?? 0).ToString("N2"))</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Pass Mark" Width="120" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@(course?.PassMarkPercent ?? 0)%</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Duration" Width="120" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@((course?.DurationMinutes ?? 0) == 0 ? "—" : $"{course?.DurationMinutes} min")</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(TrainingCourseListItemModel.TargetAudienceSummary)" HeaderText="Audience" Width="220" />
                            <GridColumn HeaderText="Validity" Width="110">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@(course?.ValidityMonths ?? 0) months</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Status" Width="110" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span class="ab-badge @(course?.IsActive == true ? "ab-badge-active" : "ab-badge-inactive")">@(course?.IsActive == true ? "Active" : "Inactive")</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Actions" Width="210" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    @if (course is not null)
                                    {
                                        <div class="pf-grid-actions pf-grid-actions--compact pf-courses-grid-actions">
                                            <span class="pf-icon-action" title="Edit Course">
                                                <SfButton CssClass="e-flat pf-btn-edit pf-btn-icon pf-btn-square abmt-grid-action-edit" OnClick="@(() => OpenEditDialogAsync(course.CourseId))" aria-label="Edit Course">
                                                    <span class="e-icons e-edit" aria-hidden="true"></span>
                                                </SfButton>
                                            </span>
                                            <span class="pf-icon-action" title="Open Builder">
                                                <a class="e-btn e-flat pf-btn-details pf-btn-icon pf-btn-square abmt-grid-action-builder" href="@($"/training-management/course-builder/{course.CourseId}")" aria-label="Open Course Builder">
                                                    <span class="e-icons e-folder-open" aria-hidden="true"></span>
                                                </a>
                                            </span>
                                            <span class="pf-icon-action" title="Question Bank">
                                                <a class="e-btn e-flat pf-btn-email pf-btn-icon pf-btn-square abmt-grid-action-question-bank" href="@($"/training-management/question-bank/{course.CourseId}")" aria-label="Open Question Bank">
                                                    <span class="e-icons e-list-unordered" aria-hidden="true"></span>
                                                </a>
                                            </span>
                                            <span class="pf-icon-action" title="Create Next Version">
                                                <SfButton CssClass="e-flat pf-btn-email pf-btn-icon pf-btn-square abmt-grid-action-version" OnClick="@(() => CreateNextVersionAsync(course.CourseId))" aria-label="Create Next Version">
                                                    <span class="e-icons e-copy" aria-hidden="true"></span>
                                                </SfButton>
                                            </span>
                                            <span class="pf-icon-action" title="Toggle Active">
                                                <SfButton CssClass="e-flat pf-btn-deactivate pf-btn-icon pf-btn-square abmt-grid-action-toggle" OnClick="@(() => ToggleActiveAsync(course))" aria-label="Toggle Active">
                                                    <span class="e-icons e-check" aria-hidden="true"></span>
                                                </SfButton>
                                            </span>
                                            <span class="pf-icon-action" title="Delete Course">
                                                <SfButton CssClass="e-flat e-danger pf-btn-icon pf-btn-square abmt-grid-action-delete" OnClick="@(() => PromptDeleteCourse(course))" aria-label="Delete Course">
                                                    <span class="e-icons e-trash" aria-hidden="true"></span>
                                                </SfButton>
                                            </span>
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="pf-card-shell abmt-panel-3d pf-training-courses-panel--participation">
        <CardHeader Title="Course Participation" SubTitle="Select a course name to review learner progress, completions, results, and certificate availability." />
        <CardContent>
            @if (CoursesData.Count == 0)
            {
                <div class="pf-empty-state">Course participation reporting will appear after courses have been created.</div>
            }
            else
            {
                <div class="pf-training-responsive-grid">
                    <SfGrid DataSource="@CoursesData" TValue="TrainingCourseListItemModel" AllowSorting="true" EnableHover="true" CssClass="pf-grid--compact">
                        <GridColumns>
                            <GridColumn Field="@nameof(TrainingCourseListItemModel.Code)" HeaderText="Code" Width="120" />
                            <GridColumn HeaderText="Course" Width="260">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    @if (course is not null)
                                    {
                                        <a class="pf-training-panel-link" href="@($"/training-management/courses/{course.CourseId}/students")">@course.Title</a>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Enrolled" Width="110" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@(course?.EnrolledLearnerCount ?? 0)</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Started" Width="110" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@(course?.StartedLearnerCount ?? 0)</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Completed" Width="120" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@(course?.CompletedLearnerCount ?? 0)</span>
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            }
        </CardContent>
    </SfCard>
</div>

@if (EditModel is not null)
{
    <CourseEditDialog @bind-Visible="IsDialogVisible" Model="EditModel" CurrentUserId="CurrentUserId" SaveRequested="SaveCourseAsync" />
}

@code {
    private SfToast SuccessToast = default!;
    private List<TrainingCourseListItemModel> CoursesData = new();
    private TrainingCourseEditModel? EditModel;
    private bool IsDialogVisible;
    private bool ShowResetConfirmation;
    private bool ShowDeleteConfirmation;
    private TrainingCourseListItemModel? CourseToDelete;
    private string? ErrorMessage;
    private string? CurrentUserId;

    protected override async Task OnInitializedAsync()
    {
        CurrentUserId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        CoursesData = await TrainingManagementService.GetCoursesAsync();
        ErrorMessage = null;
    }

    private Task OpenCreateDialogAsync()
    {
        EditModel = new TrainingCourseEditModel();
        IsDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task OpenEditDialogAsync(Guid courseId)
    {
        EditModel = await TrainingManagementService.GetCourseAsync(courseId);
        if (EditModel is null)
        {
            ErrorMessage = "Course could not be loaded.";
            return;
        }

        IsDialogVisible = true;
    }

    private async Task SaveCourseAsync(TrainingCourseEditModel model)
    {
        var result = await TrainingManagementService.SaveCourseAsync(model, CurrentUserId);
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        IsDialogVisible = false;
        await LoadCoursesAsync();
        await ShowSuccessToastAsync(result.Message ?? "Course saved.");
    }

    private async Task ToggleActiveAsync(TrainingCourseListItemModel course)
    {
        var result = await TrainingManagementService.ToggleCourseActiveAsync(course.CourseId, !course.IsActive, CurrentUserId);
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        await LoadCoursesAsync();
        await ShowSuccessToastAsync(result.Message ?? "Course updated.");
    }

    private async Task CreateNextVersionAsync(Guid courseId)
    {
        var result = await TrainingManagementService.CreateNextCourseVersionAsync(courseId, CurrentUserId);
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        await LoadCoursesAsync();
        await ShowSuccessToastAsync(result.Message ?? "Course version created.");
    }

    private void PromptDeleteCourse(TrainingCourseListItemModel course)
    {
        CourseToDelete = course;
        ShowDeleteConfirmation = true;
        ErrorMessage = null;
    }

    private void CancelDeletePrompt()
    {
        ShowDeleteConfirmation = false;
        CourseToDelete = null;
    }

    private async Task DeleteCourseAsync()
    {
        if (CourseToDelete is null)
        {
            ShowDeleteConfirmation = false;
            return;
        }

        var result = await TrainingManagementService.SoftDeleteCourseAsync(CourseToDelete.CourseId, CurrentUserId);
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        ShowDeleteConfirmation = false;
        CourseToDelete = null;
        await LoadCoursesAsync();
        await ShowSuccessToastAsync(result.Message ?? "Course removed.");
    }

    private void PromptResetTrainingData()
    {
        ShowResetConfirmation = true;
        ErrorMessage = null;
    }

    private void CancelResetPrompt() => ShowResetConfirmation = false;

    private async Task ResetTrainingDataAsync()
    {
        var result = await TrainingManagementService.ResetTrainingDataAsync(CurrentUserId);
        if (!result.Succeeded)
        {
            ErrorMessage = result.Message ?? string.Join(", ", result.Errors);
            return;
        }

        ShowResetConfirmation = false;
        EditModel = null;
        IsDialogVisible = false;
        await LoadCoursesAsync();
        await ShowSuccessToastAsync(result.Message ?? "Training data reset completed.");
    }

    private async Task ShowSuccessToastAsync(string message)
    {
        ErrorMessage = null;
        await SuccessToast.ShowAsync(new ToastModel
        {
            Title = "Success",
            Content = message,
            CssClass = "e-toast-success",
            ShowCloseButton = true,
            Timeout = 3500
        });
    }

    private static string GetVersionText(TrainingCourseListItemModel? course)
    {
        if (course?.CurrentVersionNumber is null)
        {
            return "No version";
        }

        var label = string.IsNullOrWhiteSpace(course.CurrentVersionLabel)
            ? $"v{course.CurrentVersionNumber}"
            : course.CurrentVersionLabel;

        return $"{label} · {course.CurrentVersionStatus}";
    }

}
