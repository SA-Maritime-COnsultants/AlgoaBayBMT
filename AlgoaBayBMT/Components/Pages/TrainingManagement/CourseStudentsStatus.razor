@page "/training-management/courses/{CourseId:guid}/students"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Admin)]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Security
@using Syncfusion.Blazor.Grids

@inject ITrainingManagementService TrainingManagementService

<PageTitle>Course Student Status</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Course Student Status</h1>
            <div class="page-subtitle">Review learner participation, completion status, results, and certificate availability for the selected course.</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <a class="e-btn" href="/training-management/courses">Back to Courses</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="pf-alert pf-alert--warning-strong" role="alert">@ErrorMessage</div>
    }

    @if (CourseStatusPage is null)
    {
        <SfCard CssClass="pf-card-shell">
            <CardContent>
                <div class="pf-empty-state">Loading course learner status...</div>
            </CardContent>
        </SfCard>
    }
    else
    {
        <SfCard CssClass="pf-card-shell">
            <CardHeader Title="Course Details" SubTitle="Selected course overview for learner completion reporting." />
            <CardContent>
                <div class="pf-manage-overview pf-training-learner-summary">
                    <div class="pf-manage-overview-copy">
                        <h2 class="pf-manage-overview-title">@CourseStatusPage.CourseTitle</h2>
                        <div class="page-subtitle">@CourseStatusPage.Summary</div>
                        <div class="pf-role-badge-list">
                            <span class="e-badge pf-role-badge">@CourseStatusPage.CourseCode</span>
                            <span class="e-badge pf-role-badge">Pass mark @CourseStatusPage.PassMarkPercent:0.##%</span>
                            <span class="e-badge pf-role-badge">Validity @CourseStatusPage.ValidityMonths month(s)</span>
                        </div>
                    </div>
                </div>
            </CardContent>
        </SfCard>

        <div class="pf-training-dashboard-grid pf-training-dashboard-grid--compact">
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Enrolled</div>
                    <div class="pf-training-metric-value">@CourseStatusPage.EnrolledLearnerCount</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Started</div>
                    <div class="pf-training-metric-value">@CourseStatusPage.StartedLearnerCount</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Completed</div>
                    <div class="pf-training-metric-value">@CourseStatusPage.CompletedLearnerCount</div>
                </CardContent>
            </SfCard>
        </div>

        <SfCard CssClass="pf-card-shell">
            <CardHeader Title="Learner Status" SubTitle="Associated learners and their current status for this course." />
            <CardContent>
                @if (CourseStatusPage.Students.Count == 0)
                {
                    <div class="pf-empty-state">No learners are currently associated with this course.</div>
                }
                else
                {
                    <div class="pf-training-responsive-grid">
                        <SfGrid DataSource="@CourseStatusPage.Students" TValue="TrainingCourseStudentStatusModel" AllowSorting="true" AllowFiltering="true" EnableHover="true" CssClass="pf-grid--compact">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                            <GridColumns>
                                <GridColumn Field="@nameof(TrainingCourseStudentStatusModel.StudentName)" HeaderText="Student Name" Width="220" />
                                <GridColumn HeaderText="Email / Username" Width="240">
                                    <Template>
                                        @{ var student = context as TrainingCourseStudentStatusModel; }
                                        <span>@GetIdentityText(student)</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Training Status" Width="130" TextAlign="TextAlign.Center">
                                    <Template>
                                        @{ var student = context as TrainingCourseStudentStatusModel; }
                                        <span class="e-badge @GetStatusBadge(student?.Status ?? TrainingCourseStudentStatus.NotStarted)">@GetStatusText(student?.Status ?? TrainingCourseStudentStatus.NotStarted)</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Started Date" Width="140">
                                    <Template>
                                        @{ var student = context as TrainingCourseStudentStatusModel; }
                                        <span>@FormatDate(student?.StartedOnUtc)</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Completed Date" Width="140">
                                    <Template>
                                        @{ var student = context as TrainingCourseStudentStatusModel; }
                                        <span>@FormatDate(student?.CompletedOnUtc)</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Result / Score" Width="150">
                                    <Template>
                                        @{ var student = context as TrainingCourseStudentStatusModel; }
                                        <span>@GetResultText(student)</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Certificate" Width="220">
                                    <Template>
                                        @{ var student = context as TrainingCourseStudentStatusModel; }
                                        @if (!string.IsNullOrWhiteSpace(student?.CertificateViewUrl))
                                        {
                                            <div class="pf-grid-actions pf-grid-actions--compact">
                                                <a class="e-btn" href="@student.CertificateViewUrl">View</a>
                                                <a class="e-btn e-primary" href="@student.CertificateDownloadUrl" target="_blank" rel="noreferrer">Download</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                }
            </CardContent>
        </SfCard>
    }
</div>

@code {
    [Parameter]
    public Guid CourseId { get; set; }

    private TrainingCourseStudentStatusPageModel? CourseStatusPage;
    private string? ErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        CourseStatusPage = await TrainingManagementService.GetCourseStudentStatusPageAsync(CourseId);
        ErrorMessage = CourseStatusPage is null ? "The selected course could not be loaded." : null;
    }

    private static string GetIdentityText(TrainingCourseStudentStatusModel? student)
    {
        if (!string.IsNullOrWhiteSpace(student?.Email) && !string.IsNullOrWhiteSpace(student?.UserName))
        {
            return $"{student.Email} / {student.UserName}";
        }

        return student?.Email ?? student?.UserName ?? "—";
    }

    private static string GetStatusText(TrainingCourseStudentStatus status) => status switch
    {
        TrainingCourseStudentStatus.Completed => "Completed",
        TrainingCourseStudentStatus.Expired => "Expired",
        TrainingCourseStudentStatus.Failed => "Failed",
        TrainingCourseStudentStatus.InProgress => "In Progress",
        _ => "Not Started"
    };

    private static string GetStatusBadge(TrainingCourseStudentStatus status) => status switch
    {
        TrainingCourseStudentStatus.Completed => "e-badge-success",
        TrainingCourseStudentStatus.Expired => "e-badge-warning",
        TrainingCourseStudentStatus.Failed => "e-badge-danger",
        TrainingCourseStudentStatus.InProgress => "e-badge-info",
        _ => "e-badge-primary"
    };

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("dd MMM yyyy") : "—";

    private static string GetResultText(TrainingCourseStudentStatusModel? student)
        => student?.ResultPercent is decimal result ? $"{result:0.##}%" : "—";
}
