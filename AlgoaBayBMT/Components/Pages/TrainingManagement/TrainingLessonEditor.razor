@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs

<SfCard CssClass="pf-card-shell pf-training-editor-card">
    <CardHeader Title="Lesson Editor" SubTitle="Manage lesson details, completion rules, and content sequencing." />
    <CardContent>
        <EditForm Model="Model" OnValidSubmit="HandleSaveAsync" FormName="@GetFormName()">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-message" />

            <div class="pf-form-grid">
                <div class="pf-col-12">
                    <label class="pf-field-label">Title</label>
                    <SfTextBox @bind-Value="Model.Title" Placeholder="Lesson title" FloatLabelType="FloatLabelType.Never" />
                </div>
                <div class="pf-col-4">
                    <label class="pf-field-label">Estimated Minutes</label>
                    <InputNumber @bind-Value="Model.EstimatedMinutes" class="form-control" />
                </div>
                <div class="pf-col-4">
                    <label class="pf-field-label">Lesson Type</label>
                    <SfDropDownList TValue="LessonType" TItem="LessonTypeOption" DataSource="@LessonTypeOptions" @bind-Value="Model.LessonType" Placeholder="Select lesson type">
                        <DropDownListFieldSettings Text="Text" Value="Value" />
                    </SfDropDownList>
                </div>
                <div class="pf-col-4">
                    <label class="pf-field-label">Completion Rule</label>
                    <SfDropDownList TValue="LessonCompletionRule" TItem="LessonCompletionRuleOption" DataSource="@CompletionRuleOptions" @bind-Value="Model.CompletionRule" Placeholder="Select completion rule">
                        <DropDownListFieldSettings Text="Text" Value="Value" />
                    </SfDropDownList>
                </div>
                <div class="pf-col-12">
                    <label class="pf-field-label">Summary</label>
                    <InputTextArea @bind-Value="Model.Summary" class="form-control pf-textarea" />
                </div>
                <div class="pf-col-4">
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="Model.IsRequired" />
                        <span>Required lesson</span>
                    </label>
                </div>
                <div class="pf-col-4">
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="Model.IsPreview" />
                        <span>Preview lesson</span>
                    </label>
                </div>
                <div class="pf-col-4">
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="Model.IsActive" />
                        <span>Lesson active</span>
                    </label>
                </div>
            </div>

            <div class="pf-dialog-actions pf-dialog-actions--split">
                <div class="pf-grid-actions pf-grid-actions--compact">
                    <SfButton type="button" OnClick="MoveUpAsync">Move Up</SfButton>
                    <SfButton type="button" OnClick="MoveDownAsync">Move Down</SfButton>
                    @if (Model.LessonId.HasValue)
                    {
                        <SfButton type="button" CssClass="e-danger" OnClick="DeleteAsync">Delete</SfButton>
                    }
                </div>
                <div class="pf-grid-actions pf-grid-actions--compact">
                    @if (Model.LessonId.HasValue)
                    {
                        <SfButton type="button" CssClass="e-primary" OnClick="CreateBlockAsync">New Content Block</SfButton>
                    }
                    <SfButton CssClass="e-primary" IsPrimary="true" type="submit">Save Lesson</SfButton>
                </div>
            </div>
        </EditForm>
    </CardContent>
</SfCard>

@code {
    private IReadOnlyList<LessonTypeOption> LessonTypeOptions =>
    [
        new(LessonType.ContentOnly, "Content Only"),
        new(LessonType.AssessmentOnly, "Assessment Only"),
        new(LessonType.Mixed, "Mixed")
    ];

    private IReadOnlyList<LessonCompletionRuleOption> CompletionRuleOptions =>
    [
        new(LessonCompletionRule.ManualButton, "Manual Button"),
        new(LessonCompletionRule.VideoEnded, "Video Ended"),
        new(LessonCompletionRule.ScrollToBottom, "Scroll To Bottom"),
        new(LessonCompletionRule.AssessmentPassed, "Assessment Passed")
    ];

    [Parameter, EditorRequired]
    public TrainingLessonEditModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<TrainingLessonEditModel> SaveRequested { get; set; }

    [Parameter]
    public EventCallback DeleteRequested { get; set; }

    [Parameter]
    public EventCallback<int> MoveRequested { get; set; }

    [Parameter]
    public EventCallback CreateBlockRequested { get; set; }

    private string GetFormName() => Model.LessonId.HasValue
        ? $"training-lesson-{Model.LessonId.Value:N}"
        : $"training-lesson-new-{System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(Model)}";

    private async Task HandleSaveAsync() => await SaveRequested.InvokeAsync(Model);
    private async Task DeleteAsync() => await DeleteRequested.InvokeAsync();
    private async Task MoveUpAsync() => await MoveRequested.InvokeAsync(-1);
    private async Task MoveDownAsync() => await MoveRequested.InvokeAsync(1);
    private async Task CreateBlockAsync() => await CreateBlockRequested.InvokeAsync();

    private sealed record LessonTypeOption(LessonType Value, string Text);
    private sealed record LessonCompletionRuleOption(LessonCompletionRule Value, string Text);
}
