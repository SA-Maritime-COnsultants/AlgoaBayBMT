@using AlgoaBayBMT.Services.Models
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs

<div class="cb-module-editor-shell">
    <div class="cb-module-editor-body">
        <EditForm Model="Model" OnValidSubmit="HandleSaveAsync" FormName="@GetFormName()">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-message" />

            <!-- Title row: wide title + est. minutes -->
            <div class="cb-module-editor-title-row">
                <div class="cb-module-editor-title-field">
                    <label class="pf-field-label">Lesson Title</label>
                    <SfTextBox @bind-Value="Model.Title" Placeholder="Enter lesson title" FloatLabelType="FloatLabelType.Never" CssClass="cb-title-input" />
                </div>
                <div class="cb-module-editor-minutes-field">
                    <label class="pf-field-label">Est. Minutes</label>
                    <InputNumber @bind-Value="Model.EstimatedMinutes" class="form-control" placeholder="e.g. 15" />
                </div>
                <div class="cb-module-editor-active-field">
                    <label class="pf-field-label">&nbsp;</label>
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="Model.IsActive" />
                        <span>Active</span>
                    </label>
                </div>
            </div>

            <div class="cb-module-editor-row">
                <label class="pf-field-label">Summary</label>
                <InputTextArea @bind-Value="Model.Summary" class="form-control pf-textarea" rows="2" placeholder="Optional lesson summary shown to learners" />
            </div>

            <div class="cb-module-editor-row">
                <label class="pf-inline-check">
                    <InputCheckbox @bind-Value="Model.IsPreview" />
                    <span>Preview lesson (visible before enrolment)</span>
                </label>
            </div>

            <div class="pf-dialog-actions pf-dialog-actions--split" style="margin-top:16px;">
                <div class="pf-grid-actions pf-grid-actions--compact">
                    <SfButton type="button" OnClick="MoveUpAsync">&#8593; Up</SfButton>
                    <SfButton type="button" OnClick="MoveDownAsync">&#8595; Down</SfButton>
                    @if (Model.LessonId.HasValue)
                    {
                        <SfButton type="button" CssClass="e-danger" OnClick="DeleteAsync">Delete</SfButton>
                    }
                </div>
                <SfButton CssClass="e-primary" IsPrimary="true" type="submit">Save Lesson</SfButton>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TrainingLessonEditModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<TrainingLessonEditModel> SaveRequested { get; set; }

    [Parameter]
    public EventCallback DeleteRequested { get; set; }

    [Parameter]
    public EventCallback<int> MoveRequested { get; set; }

    [Parameter]
    public EventCallback CreateBlockRequested { get; set; }

    private string GetFormName() => Model.LessonId.HasValue
        ? $"training-lesson-{Model.LessonId.Value:N}"
        : $"training-lesson-new-{System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(Model)}";

    private async Task HandleSaveAsync() => await SaveRequested.InvokeAsync(Model);
    private async Task DeleteAsync() => await DeleteRequested.InvokeAsync();
    private async Task MoveUpAsync() => await MoveRequested.InvokeAsync(-1);
    private async Task MoveDownAsync() => await MoveRequested.InvokeAsync(1);
}
