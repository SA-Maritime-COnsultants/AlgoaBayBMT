@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs

<SfCard CssClass="pf-card-shell pf-training-block-card">
    <CardContent>
        <EditForm Model="Model" OnValidSubmit="HandleSaveAsync">
            <DataAnnotationsValidator />
            <div class="pf-form-grid">
                <div class="pf-col-4">
                    <label class="pf-field-label">Content Type</label>
                    <SfDropDownList TValue="LessonBlockType" TItem="LessonBlockTypeOption" DataSource="@BlockTypeOptions" @bind-Value="Model.BlockType" Placeholder="Select content type">
                        <DropDownListFieldSettings Text="Text" Value="Value" />
                    </SfDropDownList>
                </div>
                <div class="pf-col-8">
                    <label class="pf-field-label">Title</label>
                    <SfTextBox @bind-Value="Model.Title" Placeholder="Block title" FloatLabelType="FloatLabelType.Never" />
                </div>

                @if (Model.BlockType == LessonBlockType.Markdown || Model.BlockType == LessonBlockType.Callout)
                {
                    <div class="pf-col-12">
                        <label class="pf-field-label">Markdown Body</label>
                        <InputTextArea @bind-Value="Model.MarkdownBody" class="form-control pf-textarea pf-textarea--large" />
                    </div>
                }

                @if (Model.BlockType == LessonBlockType.VideoUrl || Model.BlockType == LessonBlockType.Embed)
                {
                    <div class="pf-col-12">
                        <label class="pf-field-label">External URL</label>
                        <SfTextBox @bind-Value="Model.ExternalUrl" Placeholder="https://..." FloatLabelType="FloatLabelType.Never" />
                    </div>
                }

                @if (Model.BlockType == LessonBlockType.UploadedVideo || Model.BlockType == LessonBlockType.PdfDocument || Model.BlockType == LessonBlockType.Download || Model.BlockType == LessonBlockType.Image || Model.BlockType == LessonBlockType.SlideDeck)
                {
                    <div class="pf-col-8">
                        <label class="pf-field-label">File URL / Relative Path</label>
                        <SfTextBox @bind-Value="Model.FileUrl" Placeholder="/uploads/training/..." FloatLabelType="FloatLabelType.Never" />
                    </div>
                    <div class="pf-col-4">
                        <label class="pf-field-label">Mime Type</label>
                        <SfTextBox @bind-Value="Model.MimeType" Placeholder="application/pdf" FloatLabelType="FloatLabelType.Never" />
                    </div>
                }

                @if (Model.BlockType == LessonBlockType.VideoUrl || Model.BlockType == LessonBlockType.UploadedVideo)
                {
                    <div class="pf-col-4">
                        <label class="pf-field-label">Duration Seconds</label>
                        <InputNumber @bind-Value="Model.DurationSeconds" class="form-control" />
                    </div>
                }

                <div class="pf-col-12">
                    <label class="pf-field-label">Metadata JSON</label>
                    <InputTextArea @bind-Value="Model.MetadataJson" class="form-control pf-textarea" />
                </div>
                <div class="pf-col-12">
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="Model.IsRequired" />
                        <span>Required content block</span>
                    </label>
                </div>
            </div>

            <div class="pf-dialog-actions pf-dialog-actions--split">
                <div class="pf-grid-actions pf-grid-actions--compact">
                    <SfButton OnClick="MoveUpAsync">Move Up</SfButton>
                    <SfButton OnClick="MoveDownAsync">Move Down</SfButton>
                    @if (Model.LessonBlockId.HasValue)
                    {
                        <SfButton CssClass="e-danger" OnClick="DeleteAsync">Delete</SfButton>
                    }
                </div>
                <SfButton CssClass="e-primary" IsPrimary="true" type="submit">Save Block</SfButton>
            </div>
        </EditForm>
    </CardContent>
</SfCard>

@code {
    private IReadOnlyList<LessonBlockTypeOption> BlockTypeOptions =>
    [
        new(LessonBlockType.Markdown, "Markdown"),
        new(LessonBlockType.VideoUrl, "Video URL"),
        new(LessonBlockType.UploadedVideo, "Uploaded Video"),
        new(LessonBlockType.PdfDocument, "PDF Document"),
        new(LessonBlockType.SlideDeck, "Slide Deck"),
        new(LessonBlockType.Image, "Image"),
        new(LessonBlockType.Download, "Download / Attachment"),
        new(LessonBlockType.Embed, "Embed"),
        new(LessonBlockType.Callout, "Callout")
    ];

    [Parameter, EditorRequired]
    public TrainingLessonBlockEditModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<TrainingLessonBlockEditModel> SaveRequested { get; set; }

    [Parameter]
    public EventCallback DeleteRequested { get; set; }

    [Parameter]
    public EventCallback<int> MoveRequested { get; set; }

    private async Task HandleSaveAsync() => await SaveRequested.InvokeAsync(Model);
    private async Task DeleteAsync() => await DeleteRequested.InvokeAsync();
    private async Task MoveUpAsync() => await MoveRequested.InvokeAsync(-1);
    private async Task MoveDownAsync() => await MoveRequested.InvokeAsync(1);

    private sealed record LessonBlockTypeOption(LessonBlockType Value, string Text);
}
