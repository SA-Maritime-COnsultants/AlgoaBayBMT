@page "/training-management"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Admin)]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Security
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Notifications

@inject ITrainingManagementService TrainingManagementService

<PageTitle>Training Management</PageTitle>

<SfToast @ref="SuccessToast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Training Management</h1>
            <div class="page-subtitle">Author, publish, and govern compliance training content for crews and operational users.</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <a class="e-btn e-primary" href="/training-management/courses">Manage Courses</a>
        </div>
    </div>

    @if (Dashboard is null)
    {
        <SfCard CssClass="pf-card-shell">
            <CardContent>
                <div class="pf-empty-state">Loading training management dashboard...</div>
            </CardContent>
        </SfCard>
    }
    else
    {
        <div class="pf-training-dashboard-grid">
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Total Courses</div>
                    <div class="pf-training-metric-value">@Dashboard.TotalCourses</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Published Versions</div>
                    <div class="pf-training-metric-value">@Dashboard.PublishedCourses</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Draft Versions</div>
                    <div class="pf-training-metric-value">@Dashboard.DraftCourses</div>
                </CardContent>
            </SfCard>
            <SfCard CssClass="pf-card-shell pf-training-metric-card">
                <CardContent>
                    <div class="pf-training-metric-label">Modules / Lessons</div>
                    <div class="pf-training-metric-value">@Dashboard.TotalModules / @Dashboard.TotalLessons</div>
                </CardContent>
            </SfCard>
        </div>

        <SfCard CssClass="pf-card-shell">
            <CardHeader Title="Training Participation" SubTitle="Admin summary of learners assigned to training, active participants, and completed training records." />
            <CardContent>
                <div class="pf-training-dashboard-grid pf-training-dashboard-grid--compact">
                    <SfCard CssClass="pf-card-shell pf-training-metric-card">
                        <CardContent>
                            <div class="pf-training-metric-label">Students Enrolled</div>
                            <div class="pf-training-metric-value">@Dashboard.EnrolledLearners</div>
                        </CardContent>
                    </SfCard>
                    <SfCard CssClass="pf-card-shell pf-training-metric-card">
                        <CardContent>
                            <div class="pf-training-metric-label">Started Training</div>
                            <div class="pf-training-metric-value">@Dashboard.StartedLearners</div>
                        </CardContent>
                    </SfCard>
                    <SfCard CssClass="pf-card-shell pf-training-metric-card">
                        <CardContent>
                            <div class="pf-training-metric-label">Completed Training</div>
                            <div class="pf-training-metric-value">@Dashboard.CompletedLearners</div>
                        </CardContent>
                    </SfCard>
                </div>
            </CardContent>
        </SfCard>

        <SfCard CssClass="pf-card-shell">
            <CardHeader Title="Recent Courses" SubTitle="Quick access to the latest training definitions and active authoring targets." />
            <CardContent>
                <div class="pf-training-responsive-grid">
                    <SfGrid DataSource="@Dashboard.RecentCourses" TValue="TrainingCourseListItemModel" AllowSorting="true" EnableHover="true" CssClass="pf-grid--compact">
                        <GridColumns>
                            <GridColumn Field="@nameof(TrainingCourseListItemModel.Code)" HeaderText="Code" Width="130" />
                            <GridColumn HeaderText="Title" Width="220">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    @if (course is not null)
                                    {
                                        <a class="pf-training-panel-link" href="@($"/training-management/courses/{course.CourseId}/students")">@course.Title</a>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Version" Width="120">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    <span>@GetVersionText(course)</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(TrainingCourseListItemModel.TargetAudienceSummary)" HeaderText="Audience" Width="220" />
                            <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center">
                                <Template>
                                    @{ var course = context as TrainingCourseListItemModel; }
                                    @if (course is not null)
                                    {
                                        <div class="pf-grid-actions pf-grid-actions--compact">
                                            <a class="e-btn e-flat pf-btn-edit pf-btn-icon pf-btn-square" href="@($"/training-management/course-builder/{course.CourseId}")" title="Open Course Builder" aria-label="Open Course Builder">
                                                <span class="e-icons e-edit" aria-hidden="true"></span>
                                            </a>
                                        </div>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </CardContent>
        </SfCard>
    }
</div>

@code {
    private SfToast SuccessToast = default!;
    private TrainingDashboardModel? Dashboard;

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await TrainingManagementService.GetDashboardAsync();
    }

    private static string GetVersionText(TrainingCourseListItemModel? course)
    {
        if (course?.CurrentVersionNumber is null)
        {
            return "No version";
        }

        return string.IsNullOrWhiteSpace(course.CurrentVersionLabel)
            ? $"v{course.CurrentVersionNumber}"
            : $"{course.CurrentVersionLabel} ({course.CurrentVersionStatus})";
    }
}
