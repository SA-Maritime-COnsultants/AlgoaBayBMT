    {
        if (_isDisposed || SelectedModule?.ModuleId is not Guid moduleId) return;
        var result = await TrainingManagementService.DeleteModuleAsync(moduleId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        _selectedModuleId = null; _selectedLessonId = null;
        await LoadBuilderAsync();
        await ShowSuccessToastAsync(result.Message ?? "Module deleted.");
