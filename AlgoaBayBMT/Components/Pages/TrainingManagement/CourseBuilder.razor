    private static string GetBlockDisplayName(LessonBlockType t) => t switch
    {
        LessonBlockType.TextNarrative => "Text / Narrative", LessonBlockType.Video => "Video",
        LessonBlockType.Card => "Card", LessonBlockType.Flashcard => "Flash Cards",
        LessonBlockType.Quiz => "Quiz", LessonBlockType.Assessment => "Assessment",
        LessonBlockType.Download => "Download", _ => t.ToString()
    };

    private static string GetBlockTypeClass(LessonBlockType t) => t switch
    {
        LessonBlockType.Video => "video", LessonBlockType.Card => "card",
        LessonBlockType.Flashcard => "flashcard", LessonBlockType.Quiz => "quiz",
        LessonBlockType.Assessment => "assessment", LessonBlockType.Download => "download",
        _ => "text"
    };

    private static MarkupString RenderHtml(string? html) =>
        new(string.IsNullOrWhiteSpace(html) ? string.Empty : html);

    private async Task ShowSuccessToastAsync(string message)
    {
        if (_isDisposed) return;
        ErrorMessage = null;
        await SuccessToast.ShowAsync(new ToastModel
        {
            Title = "Success", Content = message,
            CssClass = "e-toast-success", ShowCloseButton = true, Timeout = 3500
        });
    }

