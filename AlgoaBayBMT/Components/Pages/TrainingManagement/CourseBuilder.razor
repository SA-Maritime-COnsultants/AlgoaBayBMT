    }

    private async Task SaveLessonBlockAsync(TrainingLessonBlockEditModel model)
    {
        if (_isDisposed) return;
        var result = await TrainingManagementService.SaveLessonBlockAsync(model, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        _selectedBlockId = result.Data?.LessonBlockId ?? model.LessonBlockId;
        await LoadBuilderAsync(focusLessonId: model.LessonId);
        await ShowSuccessToastAsync(result.Message ?? "Block saved.");
    }

    private async Task DeleteLessonBlockAsync(TrainingLessonBlockEditModel block)
    {
        if (_isDisposed) return;
        if (block.LessonBlockId is not Guid blockId) { SelectedLesson?.Blocks.Remove(block); _selectedBlockId = null; return; }
        var result = await TrainingManagementService.DeleteLessonBlockAsync(blockId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        if (_selectedBlockId == blockId) _selectedBlockId = null;
        await LoadBuilderAsync(focusLessonId: block.LessonId);
        await ShowSuccessToastAsync(result.Message ?? "Block deleted.");
    }

    private async Task MoveLessonBlockAsync(TrainingLessonBlockEditModel block, int direction)
    {
        if (_isDisposed || block.LessonBlockId is not Guid blockId) return;
        var result = await TrainingManagementService.MoveLessonBlockAsync(blockId, direction, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        _selectedBlockId = blockId;
        await LoadBuilderAsync(focusLessonId: block.LessonId);
        await ShowSuccessToastAsync(result.Message ?? "Block order updated.");
    }

    private Task SelectBlockAsync(TrainingLessonBlockEditModel block)
    {
        var lesson = SelectedLesson;
        if (lesson is null)
        {
            return Task.CompletedTask;
        }

        foreach (var candidate in lesson.Blocks)
        {
            candidate.IsExpanded = false;
        }

        block.IsExpanded = true;
        _selectedBlockId = block.LessonBlockId;
        return Task.CompletedTask;
    }

    private bool IsBlockSelected(TrainingLessonBlockEditModel block)
        => block.LessonBlockId.HasValue
            ? _selectedBlockId == block.LessonBlockId
            : block.IsExpanded;

    private string GetEditorContextKey()
        => IsLessonContext
            ? $"lesson-{_selectedLessonId?.ToString() ?? "new"}"
            : IsModuleContext
                ? $"module-{_selectedModuleId?.ToString() ?? "new"}"
                : "none";

    private string GetPreviewContextKey()
        => $"preview-{_selectedLessonId?.ToString() ?? "none"}";

    private void ApplySelectedBlockState()
    {
        var lesson = SelectedLesson;
        if (lesson is null)
        {
            return;
        }

        foreach (var block in lesson.Blocks)
        {
            block.UiKey = block.UiKey == Guid.Empty ? Guid.NewGuid() : block.UiKey;
            block.IsExpanded = block.LessonBlockId.HasValue && _selectedBlockId == block.LessonBlockId;
        }
    }

    private TrainingModuleEditModel? GetSelectedLessonModule()
        => _selectedLessonId.HasValue
            ? Builder?.Modules.FirstOrDefault(m => m.Lessons.Any(l => l.LessonId == _selectedLessonId))
            : SelectedModule;

