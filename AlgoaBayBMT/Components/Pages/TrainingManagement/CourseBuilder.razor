    private async Task DeleteLessonAsync()
    {
        if (_isDisposed) return;
        if (_newLesson is not null) { _newLesson = null; return; }
        if (SelectedLesson?.LessonId is not Guid lessonId) { _selectedLessonId = null; return; }
        var result = await TrainingManagementService.DeleteLessonAsync(lessonId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        _selectedLessonId = null;
        await LoadBuilderAsync(focusModuleId: _selectedModuleId);
        await ShowSuccessToastAsync(result.Message ?? "Lesson deleted.");
    }

    private async Task MoveLessonAsync(int direction)
    {
        if (_isDisposed || SelectedLesson?.LessonId is not Guid lessonId) return;
        var result = await TrainingManagementService.MoveLessonAsync(lessonId, direction, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await LoadBuilderAsync(focusLessonId: lessonId);
