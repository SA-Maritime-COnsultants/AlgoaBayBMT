@page "/training-management/course-builder/{CourseId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Admin)]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using AlgoaBayBMT.Shared.Models
@using AlgoaBayBMT.Shared.Security
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Popups

@implements IDisposable

@inject ITrainingManagementService TrainingManagementService
@inject IModuleLibraryService ModuleLibraryService
@inject ICourseCompositionService CourseCompositionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Course Builder</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/courseBuilder.css" />
</HeadContent>

<SfToast @ref="SuccessToast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="page-shell pf-training-admin-shell cb-builder-breadcrumb-shell">
    <SfBreadcrumb CssClass="cb-builder-breadcrumb">
        <BreadcrumbItems>
            <BreadcrumbItem Text="Training Management" Url="/training-management" />
            <BreadcrumbItem Text="Courses" Url="/training-management/courses" />
            <BreadcrumbItem Text="Course Builder" Url="@($"/training-management/course-builder/{CourseId}")" />
            @if (!string.IsNullOrWhiteSpace(CourseModel?.Title))
            {
                <BreadcrumbItem Text="@CourseModel.Title" />
            }
        </BreadcrumbItems>
    </SfBreadcrumb>
</div>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Course Builder</h1>
            <div class="page-subtitle">Create and manage courses by adding modules for specific rank profiles.</div>
        </div>
        <div class="pf-grid-actions pf-grid-actions--compact">
            <a class="e-btn pf-training-page-action-btn cb-btn-back-courses" href="/training-management/courses">
                <span class="e-btn-icon e-icons e-arrow-left e-icon-left"></span>Back to Courses
            </a>
            <SfButton CssClass="pf-training-page-action-btn cb-btn-save-course" IconCss="e-icons e-save" IconPosition="IconPosition.Left" OnClick="SaveCourseSetupAsync">Save Course</SfButton>
            @if (Composition is { IsEditable: false })
            {
                <SfButton CssClass="pf-training-page-action-btn cb-btn-create-version" IconCss="e-icons e-copy" IconPosition="IconPosition.Left" OnClick="CreateNewVersionAsync">Create Next Version</SfButton>
            }
            else
            {
                <SfButton CssClass="pf-training-page-action-btn cb-btn-publish-version" IconCss="e-icons e-upload" IconPosition="IconPosition.Left" OnClick="() => GoToStep(3)">Publish Course</SfButton>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="pf-alert pf-alert--warning-strong" role="alert">@ErrorMessage</div>
    }

    @if (CourseModel is null || Composition is null)
    {
        <div class="cb-loading-state">Loading course builder...</div>
    }
    else
    {
        <div class="pf-header-container">
            <div class="pf-header-row-primary">
                <h1>@CourseModel.Title</h1>
            </div>
            <div class="pf-header-row-secondary">
                <span class="e-badge pf-role-badge cb-summary-badge">@Composition.Code</span>
                <span class="e-badge pf-role-badge cb-summary-badge cb-summary-badge--status">@Composition.Status</span>
                <span class="e-badge pf-role-badge cb-summary-badge">v@(Composition.VersionNumber)</span>
                <span class="e-badge pf-role-badge cb-summary-badge">@Composition.Modules.Count module(s)</span>
                <span class="e-badge pf-role-badge cb-summary-badge">@Composition.RankProfiles.Count(x => x.IsSelected) rank level(s)</span>
                @if (!Composition.IsEditable)
                {
                    <span class="e-badge pf-role-badge cb-summary-badge cb-summary-badge--locked">Published — read only. Create a new version to edit.</span>
                }
            </div>
        </div>

        <div class="cb-step-strip">
            @for (var i = 0; i < StepTitles.Length; i++)
            {
                var stepIndex = i;
                <button type="button" class="cb-step-pill @(ActiveStep == stepIndex ? "is-active" : string.Empty) @(stepIndex < ActiveStep ? "is-done" : string.Empty)"
                        @onclick="() => GoToStep(stepIndex)">
                    <span class="cb-step-number">@(stepIndex + 1)</span>
                    <span class="cb-step-title">@StepTitles[stepIndex]</span>
                </button>
            }
        </div>

        <div class="cb-step-body">
            @switch (ActiveStep)
            {
                case 0:
                    @RenderCourseSetupStep()
                    break;
                case 1:
                    @RenderAddModulesStep()
                    break;
                case 2:
                    @RenderRankConfigurationStep()
                    break;
                default:
                    @RenderReviewPublishStep()
                    break;
            }
        </div>
    }
</div>

<SfDialog Width="720px" CssClass="abmt-dialog cb-rank-matrix-dialog" IsModal="true" ShowCloseIcon="true" @bind-Visible="ShowRankMatrixDialog">
    <DialogTemplates>
        <Header>Configure Modules per Rank</Header>
        <Content>
            @if (Composition is not null)
            {
                <div class="cb-rank-matrix">
                    <table class="cb-rank-matrix-table">
                        <thead>
                            <tr>
                                <th>Module</th>
                                @foreach (var rank in Composition.RankProfiles.Where(x => x.IsSelected).OrderBy(x => x.OrderIndex))
                                {
                                    <th>@rank.Name</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var module in Composition.Modules.OrderBy(x => x.OrderIndex))
                            {
                                <tr>
                                    <td class="cb-rank-matrix-module-cell">@module.OrderIndex. @module.Title</td>
                                    @foreach (var rank in Composition.RankProfiles.Where(x => x.IsSelected).OrderBy(x => x.OrderIndex))
                                    {
                                        var isIncluded = rank.ModuleInclusion.GetValueOrDefault(module.CourseModuleId, true);
                                        <td class="cb-rank-matrix-cell">
                                            <SfCheckBox TChecked="bool" Checked="isIncluded"
                                                        CheckedChanged="@(checkedValue => SetRankModuleInclusionAsync(rank, module, checkedValue))"
                                                        Disabled="Composition is { IsEditable: false }" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid CourseId { get; set; }

    private static readonly string[] StepTitles = ["Course Setup", "Add Modules", "Rank Configuration", "Review & Publish"];

    private bool _isDisposed;
    private SfToast SuccessToast = default!;
    private string? ErrorMessage;
    private string? CurrentUserId;
    private int ActiveStep;

    private TrainingCourseEditModel? CourseModel;
    private CourseCompositionModel? Composition;
    private List<ModuleLibraryItemModel> LibraryResults = [];
    private List<string> Categories = [];
    private string? LibrarySearch;
    private string? LibraryCategory;
    private PublishValidationResultModel? Validation;
    private List<ResolvedTrainingSequenceModel> RankSequences = [];
    private bool ShowRankMatrixDialog;

    protected override async Task OnInitializedAsync()
    {
        CurrentUserId = (await AuthenticationStateProvider.GetAuthenticationStateAsync())
            .User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        if (_isDisposed) return;
        CourseModel = await TrainingManagementService.GetCourseAsync(CourseId);
        Composition = await CourseCompositionService.GetCompositionAsync(CourseId);
        Categories = await ModuleLibraryService.GetCategoriesAsync();
        if (_isDisposed) return;

        if (CourseModel is null || Composition is null)
        {
            ErrorMessage = "The selected course could not be loaded.";
            return;
        }
        ErrorMessage = null;
        await SearchLibraryAsync();
    }

    private async Task GoToStep(int step)
    {
        ActiveStep = Math.Clamp(step, 0, StepTitles.Length - 1);
        if (ActiveStep == 3)
        {
            await RefreshValidationAsync();
        }
    }

    // ── Step 1: Course Setup ────────────────────────────────────────────────
    private RenderFragment RenderCourseSetupStep() => @<div class="cb-card-shell">
        <EditForm Model="CourseModel" OnValidSubmit="SaveCourseSetupAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-message" />
            <div class="pf-form-grid">
                <div class="pf-col-6">
                    <label class="pf-field-label">Course Title</label>
                    <SfTextBox @bind-Value="CourseModel!.Title" Placeholder="Course title" />
                </div>
                <div class="pf-col-3">
                    <label class="pf-field-label">Course Code</label>
                    <SfTextBox @bind-Value="CourseModel!.Code" Placeholder="e.g. WLF-100" />
                </div>
                <div class="pf-col-3">
                    <label class="pf-field-label">&nbsp;</label>
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="CourseModel!.IsActive" />
                        <span>Course Active</span>
                    </label>
                </div>
                <div class="pf-col-12">
                    <label class="pf-field-label">Description</label>
                    <SfTextBox @bind-Value="CourseModel!.Description" Multiline="true" CssClass="cb-description-textbox" />
                </div>
                <div class="pf-col-4">
                    <label class="pf-field-label">Pass Mark %</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="CourseModel!.PassMarkPercent" Min="1" Max="100" />
                </div>
                <div class="pf-col-4">
                    <label class="pf-field-label">Validity (Months)</label>
                    <SfNumericTextBox TValue="int" @bind-Value="CourseModel!.ValidityMonths" Min="1" Max="120" />
                </div>
                <div class="pf-col-4">
                    <label class="pf-field-label">&nbsp;</label>
                    <label class="pf-inline-check">
                        <InputCheckbox @bind-Value="CourseModel!.IsMandatory" />
                        <span>Mandatory Course</span>
                    </label>
                </div>
            </div>
            <div class="pf-dialog-actions">
                <SfButton IsPrimary="true" CssClass="pf-training-page-action-btn" IconCss="e-icons e-save" IconPosition="IconPosition.Left" type="submit">Save &amp; Continue</SfButton>
            </div>
        </EditForm>
    </div>;

    private async Task SaveCourseSetupAsync()
    {
        if (_isDisposed || CourseModel is null) return;
        var result = await TrainingManagementService.SaveCourseAsync(CourseModel, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        CourseModel = result.Data;
        await ShowSuccessToastAsync(result.Message ?? "Course saved.");
    }

    // ── Step 2: Add Modules ──────────────────────────────────────────────────
    private RenderFragment RenderAddModulesStep() => @<div class="cb-add-modules-layout">
        <section class="training-panel cb-module-library-panel">
            <div class="training-panel-header cb-dashboard-header-content">
                <span>Module Library</span>
                <a class="e-btn e-small pf-training-page-action-btn" href="/training-management/module-library" target="_blank">Manage Library</a>
            </div>
            <div class="training-panel-body">
                <div class="cb-library-filters">
                    <SfTextBox @bind-Value="LibrarySearch" @bind-Value:after="SearchLibraryAsync" Placeholder="Search modules..." />
                    <SfDropDownList TValue="string" TItem="string" DataSource="@Categories" @bind-Value="LibraryCategory"
                                    Placeholder="All Categories" ShowClearButton="true" ValueChange="@(async () => await SearchLibraryAsync())" />
                </div>
                @if (LibraryResults.Count == 0)
                {
                    <div class="pf-empty-state">No modules found. Create one in the Module Library.</div>
                }
                else
                {
                    <div class="cb-library-list">
                        @foreach (var module in LibraryResults)
                        {
                            var alreadyAdded = Composition!.Modules.Any(x => x.ModuleId == module.ModuleId);
                            <div class="cb-library-card" @key="module.ModuleId">
                                <div class="cb-library-card-main">
                                    <div class="cb-library-card-title">@module.Code — @module.Title</div>
                                    <div class="cb-library-card-meta">
                                        @(module.Category ?? "Uncategorised") · v@(module.VersionNumber) @module.Status
                                        · @module.LessonCount lesson(s)
                                        @if (module.UsageCourseCount > 0)
                                        {
                                            <span class="e-badge pf-role-badge cb-usage-badge">used in @module.UsageCourseCount course(s)</span>
                                        }
                                    </div>
                                </div>
                                <SfButton CssClass="pf-training-page-action-btn" Disabled="@(alreadyAdded || module.CurrentVersionId is null || !Composition!.IsEditable)"
                                          OnClick="() => AddModuleAsync(module)">
                                    @(alreadyAdded ? "Added" : "Add")
                                </SfButton>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="training-panel cb-course-modules-panel">
            <div class="training-panel-header cb-dashboard-header-content">
                <span>Course Modules</span>
                <span class="e-badge pf-role-badge">Total Modules: @Composition!.Modules.Count</span>
            </div>
            <div class="training-panel-body">
                @if (Composition.Modules.Count == 0)
                {
                    <div class="pf-empty-state">Drag modules here to build your course sequence.</div>
                }
                else
                {
                    <div class="cb-course-module-list">
                        @foreach (var module in Composition.Modules.OrderBy(x => x.OrderIndex))
                        {
                            <div class="cb-course-module-row" @key="module.CourseModuleId">
                                <span class="cb-course-module-order">@module.OrderIndex</span>
                                <div class="cb-course-module-main">
                                    <div class="cb-course-module-title">@module.Title</div>
                                    <div class="cb-course-module-meta">@(module.Category ?? "Uncategorised") · @(module.EstimatedMinutes ?? 0) min · v@(module.VersionNumber)</div>
                                </div>
                                <div class="cb-course-module-actions">
                                    <SfButton CssClass="e-small" IconCss="e-icons e-chevron-up" Disabled="!Composition.IsEditable" OnClick="() => MoveModuleAsync(module, -1)" />
                                    <SfButton CssClass="e-small" IconCss="e-icons e-chevron-down" Disabled="!Composition.IsEditable" OnClick="() => MoveModuleAsync(module, 1)" />
                                    <a class="e-btn e-small" href="@($"/training-management/module-builder/{module.ModuleId}")" target="_blank" title="Edit module">
                                        <span class="e-icons e-edit"></span>
                                    </a>
                                    <SfButton CssClass="e-small pf-training-page-action-btn cb-btn-delete" IconCss="e-icons e-trash" Disabled="!Composition.IsEditable" OnClick="() => RemoveModuleAsync(module)" />
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="pf-alert cb-tip-alert">Tip: Create modules once and reuse them across multiple courses and rank profiles to avoid duplication and maintain consistency.</div>
            </div>
        </section>
    </div>;

    private async Task SearchLibraryAsync()
    {
        if (_isDisposed) return;
        LibraryResults = await ModuleLibraryService.SearchModulesAsync(LibrarySearch, LibraryCategory);
    }

    private async Task AddModuleAsync(ModuleLibraryItemModel module)
    {
        if (_isDisposed || Composition is null || module.CurrentVersionId is not Guid versionId) return;
        var result = await CourseCompositionService.AddModuleToCourseAsync(Composition.CourseVersionId, versionId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await ReloadCompositionAsync();
        await ShowSuccessToastAsync(result.Message ?? "Module added.");
    }

    private async Task RemoveModuleAsync(CourseModuleItemModel module)
    {
        if (_isDisposed) return;
        var result = await CourseCompositionService.RemoveModuleFromCourseAsync(module.CourseModuleId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await ReloadCompositionAsync();
        await ShowSuccessToastAsync(result.Message ?? "Module removed.");
    }

    private async Task MoveModuleAsync(CourseModuleItemModel module, int direction)
    {
        if (_isDisposed || Composition is null) return;
        var ordered = Composition.Modules.OrderBy(x => x.OrderIndex).Select(x => x.CourseModuleId).ToList();
        var index = ordered.IndexOf(module.CourseModuleId);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= ordered.Count) return;

        (ordered[index], ordered[targetIndex]) = (ordered[targetIndex], ordered[index]);
        var result = await CourseCompositionService.ReorderCourseModulesAsync(Composition.CourseVersionId, ordered, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await ReloadCompositionAsync();
    }

    // ── Step 3: Rank Configuration ───────────────────────────────────────────
    private RenderFragment RenderRankConfigurationStep() => @<div class="cb-card-shell">
        <div class="training-panel-header cb-dashboard-header-content">
            <span>Rank Configuration</span>
        </div>
        <div class="cb-rank-config-list">
            @foreach (var rank in Composition!.RankProfiles.OrderBy(x => x.OrderIndex))
            {
                <div class="cb-rank-config-row" @key="rank.RankProfileId">
                    <label class="pf-inline-check cb-rank-config-checkbox">
                        <SfCheckBox TChecked="bool" Checked="rank.IsSelected"
                                    CheckedChanged="@(checkedValue => ToggleRankProfileAsync(rank, checkedValue))"
                                    Disabled="!Composition.IsEditable" />
                        <span>@rank.Name</span>
                    </label>
                    <span class="cb-rank-config-meta">@(rank.IsSelected ? $"{rank.IncludedModuleCount} modules included" : "Not offered on this course")</span>
                </div>
            }
        </div>
        <div class="pf-dialog-actions">
            <SfButton CssClass="pf-training-page-action-btn" Disabled="!Composition!.RankProfiles.Any(x => x.IsSelected)" OnClick="() => ShowRankMatrixDialog = true">Configure Modules per Rank</SfButton>
        </div>
    </div>;

    private async Task ToggleRankProfileAsync(CourseRankProfileItemModel rank, bool isSelected)
    {
        if (_isDisposed || Composition is null) return;
        var selectedIds = Composition.RankProfiles.Where(x => x.IsSelected).Select(x => x.RankProfileId).ToHashSet();
        if (isSelected) selectedIds.Add(rank.RankProfileId); else selectedIds.Remove(rank.RankProfileId);

        var result = await CourseCompositionService.SetCourseRankProfilesAsync(Composition.CourseVersionId, selectedIds.ToList(), CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await ReloadCompositionAsync();
    }

    private async Task SetRankModuleInclusionAsync(CourseRankProfileItemModel rank, CourseModuleItemModel module, bool isIncluded)
    {
        if (_isDisposed || rank.CourseRankProfileId is not Guid courseRankProfileId) return;
        var result = await CourseCompositionService.SetRankModuleInclusionAsync(courseRankProfileId, module.CourseModuleId, isIncluded, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await ReloadCompositionAsync();
    }

    // ── Step 4: Review & Publish ────────────────────────────────────────────
    private RenderFragment RenderReviewPublishStep() => @<div class="cb-card-shell">
        <div class="training-panel-header cb-dashboard-header-content">
            <span>Review &amp; Publish</span>
            <SfButton @key="@($"publish-{Validation?.CanPublish}-{Composition!.IsEditable}")"
                      CssClass="pf-training-page-action-btn cb-btn-publish-version" IsPrimary="true" IconCss="e-icons e-upload" IconPosition="IconPosition.Left"
                      Disabled="@(Validation is { CanPublish: false } || !Composition!.IsEditable)"
                      OnClick="PublishAsync">Publish Course</SfButton>
        </div>

        @if (Validation is not null && Validation.Issues.Count > 0)
        {
            <div class="cb-validation-list">
                @foreach (var issue in Validation.Issues)
                {
                    <div class="pf-alert @(issue.Severity == PublishValidationSeverity.Error ? "pf-alert--warning-strong" : "pf-alert--warning")">
                        <strong>@issue.Step:</strong> @issue.Message
                    </div>
                }
            </div>
        }

        @if (RankSequences.Count == 0)
        {
            <div class="pf-empty-state">Select at least one rank level to preview training sequences.</div>
        }
        else
        {
            @foreach (var sequence in RankSequences)
            {
                <div class="cb-review-rank-block" @key="sequence.RankProfileId">
                    <div class="cb-review-rank-header">
                        <span class="cb-review-rank-name">@sequence.RankProfileName</span>
                        <span class="e-badge pf-role-badge">@sequence.Modules.Count module(s)</span>
                        <span class="e-badge pf-role-badge">@sequence.TotalDurationMinutes min total</span>
                    </div>
                    <ol class="cb-review-module-sequence">
                        @foreach (var module in sequence.Modules.OrderBy(x => x.OrderIndex))
                        {
                            <li>@module.Title <span class="cb-review-version-ref">(@module.VersionReference)</span> — @(module.EstimatedMinutes ?? 0) min</li>
                        }
                    </ol>
                </div>
            }
        }
    </div>;

    private async Task ReloadCompositionAsync()
    {
        if (_isDisposed) return;
        Composition = await CourseCompositionService.GetCompositionAsync(CourseId);
        await SearchLibraryAsync();
        await RefreshValidationAsync();
    }

    private async Task RefreshValidationAsync()
    {
        if (_isDisposed || Composition is null) return;
        Validation = await CourseCompositionService.ValidateForPublishAsync(Composition.CourseVersionId);
        RankSequences = await CourseCompositionService.GetRankSequencesAsync(Composition.CourseVersionId);
    }

    private async Task CreateNewVersionAsync()
    {
        if (_isDisposed) return;
        var result = await TrainingManagementService.CreateNextCourseVersionAsync(CourseId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await LoadAllAsync();
        await ShowSuccessToastAsync(result.Message ?? "New course version created.");
    }

    private async Task PublishAsync()
    {
        if (_isDisposed || Composition is null) return;
        var result = await CourseCompositionService.PublishAsync(CourseId, Composition.CourseVersionId, CurrentUserId);
        if (_isDisposed) return;
        if (!result.Succeeded) { ErrorMessage = result.Message ?? string.Join(", ", result.Errors); return; }
        await LoadAllAsync();
        await ShowSuccessToastAsync(result.Message ?? "Course published.");
    }

    private async Task ShowSuccessToastAsync(string message)
    {
        if (_isDisposed) return;
        ErrorMessage = null;
        await SuccessToast.ShowAsync(new ToastModel
        {
            Title = "Success", Content = message,
            CssClass = "e-toast-success", ShowCloseButton = true, Timeout = 3500
        });
    }

    public void Dispose() => _isDisposed = true;
}
