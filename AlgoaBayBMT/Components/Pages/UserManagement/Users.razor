        public string Text { get; set; } = string.Empty;
    }

    private sealed class CrewRankOption
    {
        public CrewRank? Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private sealed class CountryOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }
