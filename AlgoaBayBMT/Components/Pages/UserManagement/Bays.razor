@page "/user-management/bays"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IAreaService AreaService

<PageTitle>Manage Bays</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Bays</h1>
            <div class="page-subtitle">Manage bay records and their linked area and port references.</div>
        </div>
        <SfButton CssClass="e-primary" IconCss="e-icons e-add" OnClick="@(_ => OpenAddDialog())">Add Bay</SfButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <SfCard CssClass="pf-status-message"><CardContent>@StatusMessage</CardContent></SfCard>
    }

    <SfCard CssClass="pf-card-shell">
        <CardHeader Title="Bay List" SubTitle="View and manage bay records" />
        <CardContent>
            <SfGrid DataSource="@BayItems" TValue="Bay" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true" EnableHover="true">
                <GridPageSettings PageSize="12"></GridPageSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(Bay.Id)" HeaderText="ID" Width="90" TextAlign="TextAlign.Center" />
                    <GridColumn Field="@nameof(Bay.Name)" HeaderText="Bay" Width="180" />
                    <GridColumn Field="@nameof(Bay.Code)" HeaderText="Code" Width="120" />
                    <GridColumn HeaderText="Area" Width="190">
                        <Template>
                            @{
                                var bay = context as Bay;
                            }
                            <span>@(bay?.OperationalArea?.Name ?? "Unassigned")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Port" Width="190">
                        <Template>
                            @{
                                var bay = context as Bay;
                            }
                            <span>@(bay?.Port?.Name ?? "Unassigned")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Status" Width="120" TextAlign="TextAlign.Center">
                        <Template>
                            @{
                                var bay = context as Bay;
                            }
                            <span class="badge @(bay?.IsActive == true ? "bg-success" : "bg-secondary")">@(bay?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="220" TextAlign="TextAlign.Center">
                        <Template>
                            @{
                                var bay = context as Bay;
                            }
                            <div class="pf-grid-actions">
                                <SfButton CssClass="e-flat" IconCss="e-icons e-edit" OnClick="@(_ => OpenEditDialog(bay))">Edit</SfButton>
                                <SfButton CssClass="e-flat e-danger" IconCss="e-icons e-delete" OnClick="@(_ => ConfirmDelete(bay))">Delete</SfButton>
                            </div>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="760px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsEditDialogVisible">
    <DialogTemplates>
        <Header>@(IsEditMode ? "Edit Bay" : "Add Bay")</Header>
        <Content>
            <EditForm EditContext="@DialogEditContext" FormName="bay-dialog-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <SfCard CssClass="pf-card-shell">
                    <CardContent>
                        <div class="pf-form-grid">
                            <div class="pf-col-4">
                                <label class="pf-field-label">Bay Name</label>
                                <SfTextBox Placeholder="Enter bay name" @bind-Value="EditModel.Name" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Code</label>
                                <SfTextBox Placeholder="Enter code" @bind-Value="EditModel.Code" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Area</label>
                                <SfDropDownList TValue="int" TItem="OperationalArea" DataSource="@AreaItems" @bind-Value="EditModel.OperationalAreaId" Placeholder="Select area">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </div>
                            <div class="pf-col-6">
                                <label class="pf-field-label">Port</label>
                                <SfDropDownList TValue="int?" TItem="Port" DataSource="@PortItems" @bind-Value="EditModel.PortId" Placeholder="Select port">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </div>
                            <div class="pf-col-12">
                                <SfCheckBox Label="Active bay" @bind-Checked="EditModel.IsActive" />
                            </div>
                        </div>
                    </CardContent>
                </SfCard>
            </EditForm>
            <div class="pf-dialog-actions">
                <SfButton OnClick="@(_ => CloseEditDialog())">Cancel</SfButton>
                <SfButton CssClass="e-primary" OnClick="@(_ => SaveAsync())">Save</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog Width="420px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDeleteDialogVisible">
    <DialogTemplates>
        <Header>Confirm Delete</Header>
        <Content>Are you sure you want to delete bay <strong>@DeleteDisplayName</strong>?</Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancel" OnClick="@(_ => IsDeleteDialogVisible = false)" />
        <DialogButton Content="Delete" IsPrimary="true" OnClick="@(_ => DeleteConfirmedAsync())" />
    </DialogButtons>
</SfDialog>

@code {
    private List<OperationalArea> AreaItems = new();
    private List<Port> PortItems = new();
    private List<Bay> BayItems = new();
    private Bay EditModel = new();
    private EditContext DialogEditContext = default!;
    private string? StatusMessage;
    private string? DeleteDisplayName;
    private int? DeleteId;
    private bool IsEditDialogVisible;
    private bool IsDeleteDialogVisible;
    private bool IsEditMode;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageDataAsync();
        ResetDialogModel();
    }

    private async Task LoadPageDataAsync()
    {
        AreaItems = await AreaService.GetAreasAsync();
        PortItems = await AreaService.GetPortsAsync();
        BayItems = await AreaService.GetBaysAsync();
    }

    private void OpenAddDialog()
    {
        IsEditMode = false;
        EditModel = new Bay { IsActive = true, OperationalAreaId = AreaItems.FirstOrDefault()?.Id ?? 0 };
        DialogEditContext = new EditContext(EditModel);
        IsEditDialogVisible = true;
    }

    private void OpenEditDialog(Bay? bay)
    {
        if (bay is null)
        {
            return;
        }

        IsEditMode = true;
        EditModel = new Bay
        {
            Id = bay.Id,
            Name = bay.Name,
            Code = bay.Code,
            OperationalAreaId = bay.OperationalAreaId,
            PortId = bay.PortId,
            IsActive = bay.IsActive
        };
        DialogEditContext = new EditContext(EditModel);
        IsEditDialogVisible = true;
    }

    private void CloseEditDialog()
    {
        IsEditDialogVisible = false;
        ResetDialogModel();
    }

    private async Task SaveAsync()
    {
        if (!DialogEditContext.Validate())
        {
            return;
        }

        var result = IsEditMode
            ? await AreaService.UpdateBayAsync(EditModel)
            : await AreaService.CreateBayAsync(EditModel);

        StatusMessage = result.Message ?? string.Join(", ", result.Errors);
        if (!result.Succeeded)
        {
            return;
        }

        IsEditDialogVisible = false;
        await LoadPageDataAsync();
        ResetDialogModel();
    }

    private void ConfirmDelete(Bay? bay)
    {
        if (bay is null)
        {
            return;
        }

        DeleteId = bay.Id;
        DeleteDisplayName = bay.Name;
        IsDeleteDialogVisible = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (!DeleteId.HasValue)
        {
            return;
        }

        var result = await AreaService.DeleteBayAsync(DeleteId.Value);
        StatusMessage = result.Message ?? string.Join(", ", result.Errors);
        IsDeleteDialogVisible = false;
        DeleteId = null;
        DeleteDisplayName = null;
        await LoadPageDataAsync();
    }

    private void ResetDialogModel()
    {
        EditModel = new Bay { IsActive = true, OperationalAreaId = AreaItems.FirstOrDefault()?.Id ?? 0 };
        DialogEditContext = new EditContext(EditModel);
    }
}
