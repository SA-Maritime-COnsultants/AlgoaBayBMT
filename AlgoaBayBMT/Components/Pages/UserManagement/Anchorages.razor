@page "/user-management/anchorages"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.AdminOnly)]

@inject IAreaService AreaService

<PageTitle>Manage Anchorages</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Anchorages</h1>
            <div class="page-subtitle">Manage anchorage records and their linked geography references.</div>
        </div>
        <SfButton CssClass="e-primary" IconCss="e-icons e-add" OnClick="@(_ => OpenAddDialog())">Add Anchorage</SfButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <SfCard CssClass="pf-status-message"><CardContent>@StatusMessage</CardContent></SfCard>
    }

    <SfCard CssClass="pf-card-shell">
        <CardHeader Title="Anchorage List" SubTitle="View and manage anchorage records" />
        <CardContent>
            <SfGrid DataSource="@AnchorageItems" TValue="Anchorage" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true" EnableHover="true">
                <GridPageSettings PageSize="12"></GridPageSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(Anchorage.Id)" HeaderText="ID" Width="90" TextAlign="TextAlign.Center" />
                    <GridColumn Field="@nameof(Anchorage.Name)" HeaderText="Anchorage" Width="180" />
                    <GridColumn Field="@nameof(Anchorage.Code)" HeaderText="Code" Width="120" />
                    <GridColumn HeaderText="Area" Width="170">
                        <Template>
                            @{
                                var anchorage = context as Anchorage;
                            }
                            <span>@(anchorage?.OperationalArea?.Name ?? "Unassigned")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Port" Width="170">
                        <Template>
                            @{
                                var anchorage = context as Anchorage;
                            }
                            <span>@(anchorage?.Port?.Name ?? "Unassigned")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Bay" Width="170">
                        <Template>
                            @{
                                var anchorage = context as Anchorage;
                            }
                            <span>@(anchorage?.Bay?.Name ?? "Unassigned")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Status" Width="120" TextAlign="TextAlign.Center">
                        <Template>
                            @{
                                var anchorage = context as Anchorage;
                            }
                            <span class="badge @(anchorage?.IsActive == true ? "bg-success" : "bg-secondary")">@(anchorage?.IsActive == true ? "Active" : "Inactive")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="220" TextAlign="TextAlign.Center">
                        <Template>
                            @{
                                var anchorage = context as Anchorage;
                            }
                            <div class="pf-grid-actions">
                                <SfButton CssClass="e-flat" IconCss="e-icons e-edit" OnClick="@(_ => OpenEditDialog(anchorage))">Edit</SfButton>
                                <SfButton CssClass="e-flat e-danger" IconCss="e-icons e-delete" OnClick="@(_ => ConfirmDelete(anchorage))">Delete</SfButton>
                            </div>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </CardContent>
    </SfCard>
</div>

<SfDialog Width="780px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsEditDialogVisible">
    <DialogTemplates>
        <Header>@(IsEditMode ? "Edit Anchorage" : "Add Anchorage")</Header>
        <Content>
            <EditForm EditContext="@DialogEditContext" FormName="anchorage-dialog-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <SfCard CssClass="pf-card-shell">
                    <CardContent>
                        <div class="pf-form-grid">
                            <div class="pf-col-4">
                                <label class="pf-field-label">Anchorage Name</label>
                                <SfTextBox Placeholder="Enter anchorage name" @bind-Value="EditModel.Name" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Code</label>
                                <SfTextBox Placeholder="Enter code" @bind-Value="EditModel.Code" />
                            </div>
                            <div class="pf-col-4">
                                <label class="pf-field-label">Area</label>
                                <SfDropDownList TValue="int" TItem="OperationalArea" DataSource="@AreaItems" @bind-Value="EditModel.OperationalAreaId" Placeholder="Select area">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </div>
                            <div class="pf-col-6">
                                <label class="pf-field-label">Port</label>
                                <SfDropDownList TValue="int?" TItem="Port" DataSource="@PortItems" @bind-Value="EditModel.PortId" Placeholder="Select port">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </div>
                            <div class="pf-col-6">
                                <label class="pf-field-label">Bay</label>
                                <SfDropDownList TValue="int?" TItem="Bay" DataSource="@BayItems" @bind-Value="EditModel.BayId" Placeholder="Select bay">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </div>
                            <div class="pf-col-12">
                                <SfCheckBox Label="Active anchorage" @bind-Checked="EditModel.IsActive" />
                            </div>
                        </div>
                    </CardContent>
                </SfCard>
            </EditForm>
            <div class="pf-dialog-actions">
                <SfButton OnClick="@(_ => CloseEditDialog())">Cancel</SfButton>
                <SfButton CssClass="e-primary" OnClick="@(_ => SaveAsync())">Save</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog Width="420px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsDeleteDialogVisible">
    <DialogTemplates>
        <Header>Confirm Delete</Header>
        <Content>Are you sure you want to delete anchorage <strong>@DeleteDisplayName</strong>?</Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancel" OnClick="@(_ => IsDeleteDialogVisible = false)" />
        <DialogButton Content="Delete" IsPrimary="true" OnClick="@(_ => DeleteConfirmedAsync())" />
    </DialogButtons>
</SfDialog>

@code {
    private List<OperationalArea> AreaItems = new();
    private List<Port> PortItems = new();
    private List<Bay> BayItems = new();
    private List<Anchorage> AnchorageItems = new();
    private Anchorage EditModel = new();
    private EditContext DialogEditContext = default!;
    private string? StatusMessage;
    private string? DeleteDisplayName;
    private int? DeleteId;
    private bool IsEditDialogVisible;
    private bool IsDeleteDialogVisible;
    private bool IsEditMode;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageDataAsync();
        ResetDialogModel();
    }

    private async Task LoadPageDataAsync()
    {
        AreaItems = await AreaService.GetAreasAsync();
        PortItems = await AreaService.GetPortsAsync();
        BayItems = await AreaService.GetBaysAsync();
        AnchorageItems = await AreaService.GetAnchoragesAsync();
    }

    private void OpenAddDialog()
    {
        IsEditMode = false;
        EditModel = new Anchorage { IsActive = true, OperationalAreaId = AreaItems.FirstOrDefault()?.Id ?? 0 };
        DialogEditContext = new EditContext(EditModel);
        IsEditDialogVisible = true;
    }

    private void OpenEditDialog(Anchorage? anchorage)
    {
        if (anchorage is null)
        {
            return;
        }

        IsEditMode = true;
        EditModel = new Anchorage
        {
            Id = anchorage.Id,
            Name = anchorage.Name,
            Code = anchorage.Code,
            OperationalAreaId = anchorage.OperationalAreaId,
            PortId = anchorage.PortId,
            BayId = anchorage.BayId,
            IsActive = anchorage.IsActive
        };
        DialogEditContext = new EditContext(EditModel);
        IsEditDialogVisible = true;
    }

    private void CloseEditDialog()
    {
        IsEditDialogVisible = false;
        ResetDialogModel();
    }

    private async Task SaveAsync()
    {
        if (!DialogEditContext.Validate())
        {
            return;
        }

        var result = IsEditMode
            ? await AreaService.UpdateAnchorageAsync(EditModel)
            : await AreaService.CreateAnchorageAsync(EditModel);

        StatusMessage = result.Message ?? string.Join(", ", result.Errors);
        if (!result.Succeeded)
        {
            return;
        }

        IsEditDialogVisible = false;
        await LoadPageDataAsync();
        ResetDialogModel();
    }

    private void ConfirmDelete(Anchorage? anchorage)
    {
        if (anchorage is null)
        {
            return;
        }

        DeleteId = anchorage.Id;
        DeleteDisplayName = anchorage.Name;
        IsDeleteDialogVisible = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (!DeleteId.HasValue)
        {
            return;
        }

        var result = await AreaService.DeleteAnchorageAsync(DeleteId.Value);
        StatusMessage = result.Message ?? string.Join(", ", result.Errors);
        IsDeleteDialogVisible = false;
        DeleteId = null;
        DeleteDisplayName = null;
        await LoadPageDataAsync();
    }

    private void ResetDialogModel()
    {
        EditModel = new Anchorage { IsActive = true, OperationalAreaId = AreaItems.FirstOrDefault()?.Id ?? 0 };
        DialogEditContext = new EditContext(EditModel);
    }
}
