@inherits LayoutComponentBase

<PageTitle>Page Not Found</PageTitle>

<div class="page-shell pf-training-admin-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title pf-training-heading">Page Not Found</h1>
            <div class="page-subtitle">The page you are looking for doesn't exist or has been moved.</div>
        </div>
    </div>

    <SfCard CssClass="pf-card-shell abmt-panel-3d">
        <CardContent>
            <p>Check the address, or head back to the operations dashboard.</p>
            <SfButton CssClass="pf-training-page-action-btn crew-action-btn-teal" IconCss="e-icons e-home" IconPosition="IconPosition.Left" OnClick="@(() => Nav.NavigateTo("/"))">Go Home</SfButton>
        </CardContent>
    </SfCard>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
