@page "/my-training"
@rendermode InteractiveServer
@attribute [Authorize]

@using AlgoaBayBMT.Services.Interfaces
@using AlgoaBayBMT.Services.Models
@using Syncfusion.Blazor.Notifications

@inject ILearnerTrainingService LearnerTrainingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Training</PageTitle>

<SfToast @ref="Toast" CssClass="e-toast-success" ShowCloseButton="true">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

<div class="page-shell pf-training-learner-shell">
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="pf-alert pf-alert--warning-strong" role="alert">@ErrorMessage</div>
    }

    @if (Dashboard is null)
    {
        <SfCard CssClass="pf-card-shell pf-training-learner-card">
            <CardContent>
                <div class="pf-empty-state">Loading your compliance training dashboard...</div>
            </CardContent>
        </SfCard>
    }
    else
    {
        <div class="pf-training-dashboard-v2" @key="GetDashboardContentKey()">
            <section class="pf-training-hero">
                <div class="pf-training-hero-copy">
                    <div class="pf-training-eyebrow">Learner dashboard</div>
                    <h1 class="page-title">My Training</h1>
                    <div class="page-subtitle">Track required learning, maintain compliance, and continue the next course from one calm, focused workspace.</div>
                    <div class="pf-training-hero-welcome">Welcome, @Dashboard.LearnerName</div>
                    <div class="pf-role-badge-list pf-training-hero-badges">
                        <span class="e-badge pf-role-badge">@Dashboard.TotalRequiredCourses required</span>
                        <span class="e-badge pf-role-badge">@Dashboard.CompletedCourses completed</span>
                        <span class="e-badge pf-role-badge">@Dashboard.InProgressCourses in progress</span>
                        <span class="e-badge pf-role-badge">@Dashboard.OverdueOrExpiredCourses attention needed</span>
                    </div>
                </div>
                <div class="pf-training-hero-note">
                    <div class="pf-training-hero-note-label">Current status</div>
                    <div class="pf-training-hero-note-text">
                        @(Dashboard.HasFullAccess
                            ? "Full review access is enabled for this account."
                            : "Your dashboard reflects the training required to remain compliant in your current role.")
                    </div>
                </div>
            </section>

            <section class="pf-training-compliance-section">
                <div class="pf-training-compliance-copy">
                    <div class="pf-training-section-kicker">Compliance status</div>
                    <h2 class="pf-training-section-title">@(IsFullyCompliant ? "100% compliant" : "Your compliance progress")</h2>
                    <p class="pf-training-section-description">@GetComplianceSummary()</p>

                    <div class="pf-training-dashboard-grid pf-training-dashboard-grid--compact pf-training-dashboard-grid--soft">
                        <div class="pf-training-metric-card pf-training-metric-card--soft">
                            <div class="pf-training-metric-label">Required Courses</div>
                            <div class="pf-training-metric-value">@Dashboard.TotalRequiredCourses</div>
                        </div>
                        <div class="pf-training-metric-card pf-training-metric-card--soft">
                            <div class="pf-training-metric-label">Completed</div>
                            <div class="pf-training-metric-value">@Dashboard.CompletedCourses</div>
                        </div>
                        <div class="pf-training-metric-card pf-training-metric-card--soft">
                            <div class="pf-training-metric-label">In Progress</div>
                            <div class="pf-training-metric-value">@Dashboard.InProgressCourses</div>
                        </div>
                        <div class="pf-training-metric-card pf-training-metric-card--soft">
                            <div class="pf-training-metric-label">Needs Attention</div>
                            <div class="pf-training-metric-value">@Dashboard.OverdueOrExpiredCourses</div>
                        </div>
                    </div>
                </div>

                <div class="pf-training-compliance-visual @(IsFullyCompliant ? "is-compliant" : string.Empty)">
                    @if (IsFullyCompliant)
                    {
                        <div class="pf-training-compliant-stamp">
                            <div class="pf-training-compliant-stamp-ring">
                                <span>Compliant</span>
                            </div>
                            <div class="pf-training-compliant-caption">All mandatory training is currently complete.</div>
                        </div>
                    }
                    else
                    {
                        <div class="pf-training-compliance-ring" style="@GetComplianceRingStyle()">
                            <div class="pf-training-compliance-ring-inner">
                                <span class="pf-training-compliance-value">@FormatPercent(Dashboard.CompliancePercent)%</span>
                                <span class="pf-training-compliance-label">Complete</span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="pf-training-dashboard-section">
                <div class="pf-training-dashboard-section-header">
                    <div>
                        <div class="pf-training-section-kicker">Required learning</div>
                        <h2 class="pf-training-section-title">Your Required Courses</h2>
                        <p class="pf-training-section-description">Launch new courses, continue training in progress, and review due dates at a glance.</p>
                    </div>
                    <div class="pf-training-section-count">@Dashboard.RequiredCourses.Count course(s)</div>
                </div>

                @if (Dashboard.RequiredCourses.Count == 0)
                {
                    <div class="pf-empty-state">No required training is currently assigned to this account.</div>
                }
                else
                {
                    <div class="pf-training-course-grid-v2">
                        @foreach (var course in Dashboard.RequiredCourses)
                        {
                            <article class="pf-training-course-card-v2">
                                <div class="pf-training-course-card-media">
                                    @if (!string.IsNullOrWhiteSpace(course.ThumbnailUrl))
                                    {
                                        <img src="@course.ThumbnailUrl" alt="@course.Title" class="pf-training-course-card-image" />
                                    }
                                    else
                                    {
                                        <div class="pf-training-course-card-placeholder">@GetCourseInitials(course)</div>
                                    }
                                </div>

                                <div class="pf-training-course-card-body">
                                    <div class="pf-training-course-card-topline">
                                        <span class="pf-training-course-code">@course.Code</span>
                                        <span class="e-badge @GetStatusBadge(course.Status)">@GetStatusText(course.Status)</span>
                                    </div>

                                    <h3 class="pf-training-course-title">@course.Title</h3>
                                    <p class="pf-training-course-summary">@(string.IsNullOrWhiteSpace(course.Summary) ? "No course summary is currently available." : course.Summary)</p>

                                    <div class="pf-training-course-meta">
                                        <span>@(course.DurationMinutes is > 0 ? $"{course.DurationMinutes} min" : "Self-paced")</span>
                                        <span>Pass mark @FormatPercent(course.PassMarkPercent)%</span>
                                        <span>@GetDueText(course)</span>
                                    </div>

                                    <div class="pf-training-course-progress-block">
                                        <div class="pf-training-course-progress-head">
                                            <span>Progress</span>
                                            <span>@FormatPercent(course.ProgressPercent)%</span>
                                        </div>
                                        <div class="pf-training-linear-progress pf-training-linear-progress--course" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@course.ProgressPercent">
                                            <div class="pf-training-linear-progress-fill" style="width:@($"{course.ProgressPercent:0.##}%")"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="pf-training-course-card-actions">
                                    <a class="e-btn e-primary" href="@($"/my-training/course/{course.CourseId}")">@course.ActionText</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            @if (Dashboard.HasFullAccess)
            {
                <section class="pf-training-dashboard-section">
                    <div class="pf-training-dashboard-section-header">
                        <div>
                            <div class="pf-training-section-kicker">Additional access</div>
                            <h2 class="pf-training-section-title">Available Review Courses</h2>
                            <p class="pf-training-section-description">Authority and review users can open active courses for audit review, testing, and content validation.</p>
                        </div>
                        <div class="pf-training-section-count">@Dashboard.AdditionalCourses.Count course(s)</div>
                    </div>

                    @if (Dashboard.AdditionalCourses.Count == 0)
                    {
                        <div class="pf-empty-state">All active courses are already listed in the required dashboard view.</div>
                    }
                    else
                    {
                        <div class="pf-training-course-grid-v2 pf-training-course-grid-v2--compact">
                            @foreach (var course in Dashboard.AdditionalCourses)
                            {
                                <article class="pf-training-course-card-v2 pf-training-course-card-v2--compact">
                                    <div class="pf-training-course-card-topline">
                                        <span class="pf-training-course-code">@course.Code</span>
                                        <span class="e-badge @GetStatusBadge(course.Status)">@GetStatusText(course.Status)</span>
                                    </div>
                                    <h3 class="pf-training-course-title">@course.Title</h3>
                                    <p class="pf-training-course-summary">@(string.IsNullOrWhiteSpace(course.Summary) ? "No course summary is currently available." : course.Summary)</p>
                                    @if (!string.IsNullOrWhiteSpace(course.AudienceSummary))
                                    {
                                        <div class="pf-training-course-meta">
                                            <span>@course.AudienceSummary</span>
                                        </div>
                                    }
                                    <div class="pf-training-course-card-actions">
                                        <a class="e-btn e-primary" href="@($"/my-training/course/{course.CourseId}")">Open Course</a>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }

            <section class="pf-training-dashboard-section">
                <div class="pf-training-dashboard-section-header">
                    <div>
                        <div class="pf-training-section-kicker">Completed learning</div>
                        <h2 class="pf-training-section-title">Certificates & Results</h2>
                        <p class="pf-training-section-description">Review completed courses, check outcomes, and open or download the generated certificate for each completed course.</p>
                    </div>
                    <div class="pf-training-section-count">@Dashboard.Certificates.Count certificate(s)</div>
                </div>

                @if (Dashboard.Certificates.Count == 0)
                {
                    <div class="pf-empty-state">Completed courses and certificates will appear here after successful course completion.</div>
                }
                else
                {
                    <div class="pf-training-certificate-grid">
                        @foreach (var certificate in Dashboard.Certificates)
                        {
                            <article class="pf-training-certificate-card">
                                <div class="pf-training-course-card-topline">
                                    <span class="pf-training-course-code">@certificate.CourseCode</span>
                                    <span class="e-badge @GetCompletionStatusBadge(certificate.CompletionStatus)">@GetCompletionStatusText(certificate.CompletionStatus)</span>
                                </div>
                                <h3 class="pf-training-course-title">@certificate.CourseTitle</h3>
                                <div class="pf-training-certificate-meta">
                                    <div><span>Completed</span><strong>@certificate.CompletedOnUtc.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                                    <div><span>Expires</span><strong>@certificate.ExpiresOnUtc.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                                    <div><span>Result</span><strong>@GetResultText(certificate)</strong></div>
                                    <div><span>Certificate No.</span><strong>@certificate.CertificateNumber</strong></div>
                                </div>
                                <div class="pf-training-course-card-actions">
                                    <a class="e-btn" href="@certificate.ViewUrl">View Certificate</a>
                                    <a class="e-btn e-primary" href="@certificate.DownloadUrl" target="_blank" rel="noreferrer">Download Certificate</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private SfToast Toast = default!;
    private MyTrainingDashboardModel? Dashboard;
    private string? CurrentUserId;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        CurrentUserId = (await AuthenticationStateProvider.GetAuthenticationStateAsync())
            .User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(CurrentUserId))
        {
            ErrorMessage = "A signed-in user profile is required to view training.";
            return;
        }

        Dashboard = await LearnerTrainingService.GetDashboardAsync(CurrentUserId);
    }

    private static string GetStatusText(TrainingAccessStatus status) => status switch
    {
        TrainingAccessStatus.Compliant => "Compliant",
        TrainingAccessStatus.InProgress => "In Progress",
        TrainingAccessStatus.Expired => "Expired",
        TrainingAccessStatus.Overdue => "Overdue",
        _ => "Not Started"
    };

    private static string GetStatusBadge(TrainingAccessStatus status) => status switch
    {
        TrainingAccessStatus.Compliant => "e-badge-success",
        TrainingAccessStatus.InProgress => "e-badge-info",
        TrainingAccessStatus.Expired => "e-badge-danger",
        TrainingAccessStatus.Overdue => "e-badge-warning",
        _ => "e-badge-primary"
    };

    private static string GetDueText(MyTrainingCourseListItemModel? item)
    {
        if (item?.ExpiryDateUtc is DateTime expiry)
        {
            return $"Expires {expiry.ToLocalTime():dd MMM yyyy}";
        }

        if (item?.DueDateUtc is DateTime due)
        {
            return $"Due {due.ToLocalTime():dd MMM yyyy}";
        }

        return "—";
    }

    private static string GetResultText(MyTrainingCertificateListItemModel? item)
    {
        if (item?.FinalScorePercent is decimal score && item.PassMarkPercent is decimal passMark)
        {
            return $"{score:0.##}% (Pass mark {passMark:0.##}%)";
        }

        if (item?.FinalScorePercent is decimal finalScore)
        {
            return $"{finalScore:0.##}%";
        }

        if (item?.PassMarkPercent is decimal requiredPassMark)
        {
            return $"Pass mark {requiredPassMark:0.##}%";
        }

        return "Completed";
    }

    private static string GetCompletionStatusText(string? status)
        => string.IsNullOrWhiteSpace(status) ? "Completed" : status;

    private static string GetCompletionStatusBadge(string? status)
        => string.Equals(status, "Expired", StringComparison.OrdinalIgnoreCase)
            ? "e-badge-warning"
            : "e-badge-success";

    private bool IsFullyCompliant => Dashboard?.CompliancePercent >= 100m;

    private string GetComplianceSummary()
    {
        if (Dashboard is null)
        {
            return string.Empty;
        }

        if (IsFullyCompliant)
        {
            return "All required training is complete and your operational compliance status is fully up to date.";
        }

        return Dashboard.OverdueOrExpiredCourses > 0
            ? "Complete outstanding training to restore full compliance and reduce overdue or expired course risk."
            : "Continue your required training to maintain full compliance in your current role.";
    }

    private string GetComplianceRingStyle()
    {
        var percent = Math.Max(0m, Math.Min(100m, Dashboard?.CompliancePercent ?? 0m));
        return $"background: conic-gradient(rgba(47, 124, 137, 0.95) 0deg {percent * 3.6m:0.##}deg, rgba(217, 228, 232, 0.9) {percent * 3.6m:0.##}deg 360deg);";
    }

    private static string FormatPercent(decimal value) => value.ToString("0.#");

    private static string GetCourseInitials(MyTrainingCourseListItemModel course)
    {
        var source = string.IsNullOrWhiteSpace(course.Code) ? course.Title : course.Code;
        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "TR";
        }

        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private string GetDashboardContentKey()
        => Dashboard is null
            ? "my-training-empty"
            : $"my-training-{CurrentUserId}-{Dashboard.RequiredCourses.Count}-{Dashboard.AdditionalCourses.Count}-{Dashboard.Certificates.Count}";
}
