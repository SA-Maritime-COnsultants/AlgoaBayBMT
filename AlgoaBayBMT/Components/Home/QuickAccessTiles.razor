@using AlgoaBayBMT.Models

<section class="quick-access-section" role="region" aria-label="Quick access operations">
    <h2 class="section-heading">Operations Quick Access</h2>
    <div class="quick-access-grid">
        @foreach (var tile in Tiles)
        {
            <a href="@tile.Url" class="tile-link" aria-label="@tile.Title — @tile.Description">
                <div class="e-card tile-card status-@tile.Status">
                    <div class="e-card-content">
                        <div class="tile-icon" aria-hidden="true">@((MarkupString)tile.IconSvg)</div>
                        <h3 class="tile-title">@tile.Title</h3>
                        <p class="tile-desc">@tile.Description</p>
                        @if (tile.Status == "critical")
                        {
                            <span class="e-badge tile-alert-badge">ACTIVE</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
</section>

