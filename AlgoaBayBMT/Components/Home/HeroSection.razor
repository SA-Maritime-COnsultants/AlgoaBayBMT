@using Syncfusion.Blazor.Buttons

<section class="hero-section" role="region" aria-label="Site overview and primary actions">
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-content">
        <h1 class="hero-title">Algoa Bay Bunkering Management &amp; Training</h1>
        <p class="hero-subtitle">Safe, compliant and environmentally responsible bunkering operations</p>
        <div class="hero-actions" role="group" aria-label="Primary actions">
            <SfButton CssClass="action-btn action-btn--primary" IsPrimary="true">Start Training</SfButton>
            <SfButton CssClass="action-btn action-btn--success">View Bunkering Procedures</SfButton>
            <SfButton CssClass="action-btn action-btn--warning">Report Wildlife Incident</SfButton>
        </div>
    </div>
</section>
