@using Syncfusion.Blazor.Navigations

<footer class="compliance-section" role="contentinfo" aria-label="Compliance and regulatory information">
    <h2 class="section-heading">Compliance &amp; Regulatory</h2>
    <SfAccordion CssClass="compliance-accordion">
        <AccordionItems>
            <AccordionItem Header="LOSCP Alignment" Expanded="true">
                <ContentTemplate>
                    <div class="compliance-content">
                        <p>
                            All bunkering operations within Algoa Bay are conducted in strict alignment with the
                            <strong>Local Oil Spill Contingency Plan (LOSCP)</strong> as required by SAMSA regulations.
                        </p>
                        <ul class="compliance-list">
                            <li>Tier 1 response equipment maintained at all active berths</li>
                            <li>Spill response drills conducted quarterly</li>
                            <li>24/7 spill notification chain verified monthly</li>
                        </ul>
                        <p class="compliance-ref">Reference: LOSCP Rev. 4.2 — Last updated March 2025</p>
                    </div>
                </ContentTemplate>
            </AccordionItem>
            <AccordionItem Header="Port Authority References">
                <ContentTemplate>
                    <div class="compliance-content">
                        <p>
                            Operations are governed by the <strong>Transnet National Ports Authority (TNPA)</strong>
                            directives for the Port of Ngqura and Algoa Bay anchorage areas.
                        </p>
                        <ul class="compliance-list">
                            <li>Port Rules — Government Gazette No. 47823</li>
                            <li>TNPA Bunkering Guidelines — Version 3.1</li>
                            <li>SAMSA Marine Notice No. 28 of 2024</li>
                            <li>IMO MARPOL Annex I, Regulation 18 compliance</li>
                        </ul>
                    </div>
                </ContentTemplate>
            </AccordionItem>
            <AccordionItem Header="Environmental Commitments">
                <ContentTemplate>
                    <div class="compliance-content">
                        <p>
                            Algoa Bay is a designated <strong>Important Bird and Biodiversity Area (IBA)</strong> and
                            hosts the largest African Penguin breeding colony. All operations implement enhanced
                            environmental safeguards.
                        </p>
                        <ul class="compliance-list">
                            <li>Environmental Management Programme (EMP) — Approved 2024</li>
                            <li>Marine wildlife exclusion zones enforced during nesting season</li>
                            <li>Continuous water quality monitoring at all discharge points</li>
                            <li>Noise and light impact mitigation protocols active</li>
                        </ul>
                    </div>
                </ContentTemplate>
            </AccordionItem>
            <AccordionItem Header="Document Access">
                <ContentTemplate>
                    <div class="compliance-content">
                        <p>
                            Controlled documents are available to authorised personnel through the document management system.
                        </p>
                        <ul class="compliance-list">
                            <li>LOSCP — Rev. 4.2 (March 2025)</li>
                            <li>EMP — Rev. 2.0 (January 2024)</li>
                            <li>Emergency Response Plan — Rev. 3.1 (June 2024)</li>
                            <li>Training Manual — Rev. 5.0 (December 2024)</li>
                            <li>Wildlife Monitoring Protocol — Rev. 1.3 (September 2024)</li>
                        </ul>
                        <p class="compliance-ref">
                            All documents version-controlled. Contact the Compliance Officer for access requests.
                        </p>
                    </div>
                </ContentTemplate>
            </AccordionItem>
        </AccordionItems>
    </SfAccordion>
</footer>
